@{
    ViewData["Title"] = "Error";
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="glass-card p-5 text-center">
            <i class="bi bi-exclamation-octagon display-3 text-warning"></i>
            <h1 class="mt-3">Something went wrong</h1>
            <p class="text-white-50">Please try again or contact the administrator.</p>
            <a class="btn btn-warning" asp-controller="Home" asp-action="Index">Back to home</a>
        </div>
    </div>
</div>
