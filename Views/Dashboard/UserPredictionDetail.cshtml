@model FootballPredictionGame.ViewModels.UserPredictionHistoryViewModel
@using FootballPredictionGame.Models

@{
    ViewData["Title"] = "User Prediction Detail";

    string ImageUrl(string? path, string fallback)
    {
        return string.IsNullOrWhiteSpace(path)
            ? Url.Content(fallback)
            : Url.Content("~/" + path.TrimStart('/', '~'));
    }

    string StatusClass(MatchStatus status)
    {
        return status == MatchStatus.Live ? "status-live blink-live" : "status-finished";
    }

    string PointBadgeClass(int point)
    {
        return point == 0
            ? "text-bg-secondary"
            : point == 3
                ? "text-bg-primary"
                : "text-bg-warning";
    }
}

<style>
    .user-history-page {
        overflow: hidden;
    }

    .user-history-topbar {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 12px;
    }

    .user-history-action-buttons {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .user-history-back-btn {
        border-radius: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

    .user-history-download-btn {
        border-radius: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

    .user-history-search-toolbar {
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        gap: 8px;
        width: 100%;
    }

    .user-history-search-box {
        position: relative;
        flex: 1 1 auto;
        min-width: 0;
    }

        .user-history-search-box span {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            z-index: 2;
        }

        .user-history-search-box .form-control {
            padding-left: 38px;
            min-height: 42px;
            border-radius: 12px;
            width: 100%;
        }

    .user-history-clear-btn {
        flex: 0 0 auto;
        width: auto !important;
        border: 1px solid #fecaca;
        color: #dc2626;
        background: #ffffff;
        font-weight: 700;
        white-space: nowrap;
        min-height: 42px;
        border-radius: 12px;
        padding-left: 14px;
        padding-right: 14px;
    }

        .user-history-clear-btn:hover,
        .user-history-clear-btn:focus {
            color: #ffffff;
            background: #dc2626;
            border-color: #dc2626;
        }

    .user-history-table-wrap {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    @@media (max-width: 767.98px) {
        .user-history-page {
            padding: 14px !important;
            border-radius: 16px;
        }

        .user-history-topbar {
            align-items: stretch;
        }

            .user-history-topbar > div {
                width: 100%;
            }

        .user-history-action-buttons {
            display: grid !important;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            width: 100%;
        }

            .user-history-action-buttons .btn {
                width: 100%;
                min-height: 40px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 5px;
            }

        .user-history-search-toolbar {
            display: flex !important;
            flex-direction: row !important;
            align-items: center !important;
            gap: 6px !important;
            width: 100%;
        }

        .user-history-search-box {
            flex: 1 1 auto;
            min-width: 0;
        }

            .user-history-search-box span {
                left: 10px;
            }

            .user-history-search-box .form-control {
                min-height: 40px;
                font-size: .86rem;
                padding-left: 34px;
            }

        .user-history-clear-btn {
            flex: 0 0 auto;
            width: auto !important;
            min-width: 74px;
            min-height: 40px;
            padding-left: 9px;
            padding-right: 9px;
            font-size: .8rem;
        }
    }
</style>

<div class="dashboard-card user-history-page p-3 p-md-4 mb-4">

    <div class="user-history-topbar mb-4">
        <div>
            <h2 class="h4 fw-bold mb-1">
                <i class="bi bi-person-lines-fill text-primary"></i>
                User Prediction Detail
            </h2>

            <div class="text-muted small">
                Showing only Live and Finished fixtures. Upcoming match predictions are hidden.
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 user-history-action-buttons">

            <a asp-action="DownloadUserPredictionDetailExcel"
               asp-route-userId="@Model.UserId"
               class="btn btn-success btn-sm user-history-download-btn">
                <i class="bi bi-file-earmark-excel"></i>
                Download Excel
            </a>

            <button type="button"
                    class="btn btn-outline-primary btn-sm user-history-back-btn"
                    onclick="window.history.back();">
                <i class="bi bi-arrow-left"></i>
                Back
            </button>

        </div>
    </div>

    <div class="user-history-profile-card mb-4">

        <img src="@ImageUrl(Model.PhotoPath, "~/img/default-avatar.svg")"
             class="user-history-photo"
             alt="@Model.FullName" />

        <div class="user-history-info">
            <h3>@Model.FullName</h3>

            <div class="text-muted small">
                @if (!string.IsNullOrWhiteSpace(Model.Designation))
                {
                    <span>@Model.Designation</span>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Department))
                {
                    <span> • @Model.Department</span>
                }
            </div>

            <div class="user-history-meta mt-2">
                <span>
                    Rank:
                    <strong>@Model.RankText</strong>
                </span>

                <span>
                    Total Score:
                    <strong>@Model.TotalScore</strong>
                </span>

                <span>
                    Exact:
                    <strong>@Model.ExactPredictionCount</strong>
                </span>
            </div>
        </div>

    </div>

    <div class="user-history-search-toolbar mb-3">

        <div class="user-history-search-box">
            <span>
                <i class="bi bi-search"></i>
            </span>

            <input type="search"
                   id="userHistorySearch"
                   class="form-control"
                   placeholder="Search" />
        </div>

        <button type="button"
                class="btn user-history-clear-btn"
                id="userHistoryClearSearch">
            <i class="bi bi-x-circle"></i>
            Clear
        </button>

    </div>

    <div class="user-history-table-wrap">
        <table class="table table-clean table-hover align-middle mb-0 user-history-table">
            <thead>
                <tr>
                    <th>
                        <button type="button"
                                id="userHistoryDateSortBtn"
                                class="user-history-sort-btn"
                                data-sort-direction="desc">
                            Date & Time
                            <i id="userHistoryDateSortIcon" class="bi bi-arrow-down-short"></i>
                        </button>
                    </th>

                    <th>Match</th>
                    <th>Status</th>
                    <th>Prediction</th>
                    <th>Actual</th>

                    <th>
                        <button type="button"
                                id="userHistoryPointSortBtn"
                                class="user-history-sort-btn"
                                data-sort-direction="desc">
                            Point
                            <i id="userHistoryPointSortIcon" class="bi bi-arrow-down-short"></i>
                        </button>
                    </th>
                </tr>
            </thead>

            <tbody id="userHistoryTableBody">
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            No live or finished fixture found.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model.Items)
                    {
                        var actualText = item.TeamOneActualGoal.HasValue && item.TeamTwoActualGoal.HasValue
                        ? $"{item.TeamOneActualGoal} - {item.TeamTwoActualGoal}"
                        : "Pending";

                        var predictionText = item.HasPrediction
                        ? $"{item.TeamOnePredictedGoal} - {item.TeamTwoPredictedGoal}"
                        : "Not Participated";

                        var pointValue = item.HasPrediction ? item.EarnedPoint : -1;

                        var searchableText =
                        $"{item.TeamOneName} {item.TeamTwoName} {item.StageName} {item.Status} {predictionText} {actualText} {pointValue} {item.MatchDateTime:dd MMM yyyy hh:mm tt}"
                        .ToLowerInvariant();

                        <tr class="user-history-row"
                            data-search="@searchableText"
                            data-match-time="@item.MatchDateTime.ToString("yyyy-MM-ddTHH:mm:ss")"
                            data-point="@pointValue">

                            <td>
                                <div class="fw-semibold">
                                    @item.MatchDateTime.ToString("dd MMM yyyy")
                                </div>

                                <div class="small text-muted">
                                    @item.MatchDateTime.ToString("hh:mm tt")
                                </div>
                            </td>

                            <td>
                                <div class="user-history-match-cell">

                                    <div class="user-history-team-inline">
                                        <img src="@ImageUrl(item.TeamOneFlagPath, "~/img/default-flag.svg")"
                                             alt="@item.TeamOneName" />

                                        <strong>@item.TeamOneName</strong>
                                    </div>

                                    <span class="user-history-vs-inline">vs</span>

                                    <div class="user-history-team-inline">
                                        <img src="@ImageUrl(item.TeamTwoFlagPath, "~/img/default-flag.svg")"
                                             alt="@item.TeamTwoName" />

                                        <strong>@item.TeamTwoName</strong>
                                    </div>

                                    <span class="user-history-stage-small">
                                        @item.StageName
                                    </span>

                                </div>
                            </td>

                            <td>
                                <span class="fixture-status @StatusClass(item.Status)">
                                    @item.Status
                                </span>
                            </td>

                            <td>
                                @if (item.HasPrediction)
                                {
                                    <span class="prediction-text-success">
                                        @predictionText
                                    </span>
                                }
                                else
                                {
                                    <span class="prediction-text-muted">
                                        Not Participated
                                    </span>
                                }
                            </td>

                            <td>
                                @if (actualText == "Pending")
                                {
                                    <span class="text-muted">Pending</span>
                                }
                                else
                                {
                                    <strong>@actualText</strong>
                                }
                            </td>

                            <td>
                                @if (item.HasPrediction)
                                {
                                    <span class="badge @PointBadgeClass(item.EarnedPoint)">
                                        @item.EarnedPoint
                                    </span>
                                }
                                else
                                {
                                    <span class="badge text-bg-light text-muted">
                                        -
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div id="userHistoryNoResult" class="empty-state mt-3 d-none">
        No fixture matched your search.
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            bindUserHistorySearch();
            bindUserHistoryDateSort();
            bindUserHistoryPointSort();
        });

        function bindUserHistorySearch() {
            const searchInput = document.getElementById("userHistorySearch");
            const clearButton = document.getElementById("userHistoryClearSearch");

            if (searchInput) {
                searchInput.addEventListener("input", function () {
                    applyUserHistorySearch();
                });
            }

            if (clearButton) {
                clearButton.addEventListener("click", function () {
                    if (searchInput) {
                        searchInput.value = "";
                        searchInput.focus();
                    }

                    applyUserHistorySearch();
                });
            }
        }

        function bindUserHistoryDateSort() {
            const sortButton = document.getElementById("userHistoryDateSortBtn");

            if (!sortButton) {
                return;
            }

            sortButton.addEventListener("click", function () {
                const currentDirection = sortButton.getAttribute("data-sort-direction") || "desc";
                const nextDirection = currentDirection === "desc" ? "asc" : "desc";

                sortButton.setAttribute("data-sort-direction", nextDirection);

                const icon = document.getElementById("userHistoryDateSortIcon");

                if (icon) {
                    icon.className = nextDirection === "asc"
                        ? "bi bi-arrow-up-short"
                        : "bi bi-arrow-down-short";
                }

                sortUserHistoryRows("date", nextDirection);
                applyUserHistorySearch();
            });
        }

        function bindUserHistoryPointSort() {
            const sortButton = document.getElementById("userHistoryPointSortBtn");

            if (!sortButton) {
                return;
            }

            sortButton.addEventListener("click", function () {
                const currentDirection = sortButton.getAttribute("data-sort-direction") || "desc";
                const nextDirection = currentDirection === "desc" ? "asc" : "desc";

                sortButton.setAttribute("data-sort-direction", nextDirection);

                const icon = document.getElementById("userHistoryPointSortIcon");

                if (icon) {
                    icon.className = nextDirection === "asc"
                        ? "bi bi-arrow-up-short"
                        : "bi bi-arrow-down-short";
                }

                sortUserHistoryRows("point", nextDirection);
                applyUserHistorySearch();
            });
        }

        function sortUserHistoryRows(sortBy, direction) {
            const tbody = document.getElementById("userHistoryTableBody");

            if (!tbody) {
                return;
            }

            const rows = Array.from(tbody.querySelectorAll(".user-history-row"));

            rows.sort(function (a, b) {
                let aValue = 0;
                let bValue = 0;

                if (sortBy === "date") {
                    aValue = new Date(a.getAttribute("data-match-time")).getTime();
                    bValue = new Date(b.getAttribute("data-match-time")).getTime();
                }

                if (sortBy === "point") {
                    aValue = parseInt(a.getAttribute("data-point") || "-1");
                    bValue = parseInt(b.getAttribute("data-point") || "-1");
                }

                if (direction === "asc") {
                    return aValue - bValue;
                }

                return bValue - aValue;
            });

            rows.forEach(function (row) {
                tbody.appendChild(row);
            });
        }

        function applyUserHistorySearch() {
            const searchInput = document.getElementById("userHistorySearch");
            const noResult = document.getElementById("userHistoryNoResult");

            const searchText = searchInput
                ? searchInput.value.trim().toLowerCase()
                : "";

            let visibleCount = 0;

            document.querySelectorAll(".user-history-row").forEach(function (row) {
                const searchable = row.getAttribute("data-search") || "";
                const shouldShow = searchText === "" || searchable.includes(searchText);

                if (shouldShow) {
                    row.classList.remove("d-none");
                    visibleCount++;
                } else {
                    row.classList.add("d-none");
                }
            });

            if (noResult) {
                if (visibleCount === 0 && document.querySelectorAll(".user-history-row").length > 0) {
                    noResult.classList.remove("d-none");
                } else {
                    noResult.classList.add("d-none");
                }
            }
        }
    </script>
}