@model DashboardViewModel
@using FootballPredictionGame.Models
@using FootballPredictionGame.Helpers
@using System.Text.Json

@{
    ViewData["Title"] = "Prediction & Score";

    var segmentLabels = JsonSerializer.Serialize(Model.SegmentPoints.Select(x => x.SegmentName));
    var segmentPoints = JsonSerializer.Serialize(Model.SegmentPoints.Select(x => x.Points));

    var avatarPath = string.IsNullOrWhiteSpace(Model.ProfilePhotoPath)
        ? Url.Content("~/img/default-avatar.svg")
        : Url.Content("~/" + Model.ProfilePhotoPath.TrimStart('/', '~'));

    var totalFixtureCount = Model.PredictionFixtures?.Count ?? 0;

    var totalPredictionCount = Model.PredictionFixtures?
        .Count(f => Model.UserPredictionLookup != null && Model.UserPredictionLookup.ContainsKey(f.Id)) ?? 0;

    var notPredictCount = Model.PredictionFixtures?
        .Count(f =>
            f.Status == MatchStatus.Upcoming &&
            !f.IsProcessed &&
            DateTime.Now < f.MatchDateTime &&
            (Model.UserPredictionLookup == null || !Model.UserPredictionLookup.ContainsKey(f.Id))) ?? 0;

    var notParticipateCount = Model.PredictionFixtures?
        .Count(f =>
            (f.Status == MatchStatus.Live ||
             f.Status == MatchStatus.Finished ||
             DateTime.Now >= f.MatchDateTime) &&
            (Model.UserPredictionLookup == null || !Model.UserPredictionLookup.ContainsKey(f.Id))) ?? 0;

    var upcomingCount = Model.PredictionFixtures?.Count(f => f.Status == MatchStatus.Upcoming) ?? 0;
    var liveCount = Model.PredictionFixtures?.Count(f => f.Status == MatchStatus.Live) ?? 0;
    var upcomingLiveCount = upcomingCount + liveCount;
    var finishedCount = Model.PredictionFixtures?.Count(f => f.Status == MatchStatus.Finished) ?? 0;
}

@functions {
    private string ToImageUrl(IUrlHelper url, string? path, string fallback)
    {
        var finalPath = string.IsNullOrWhiteSpace(path) ? fallback : path;
        return url.Content("~/" + finalPath.TrimStart('/', '~'));
    }

    private string StatusClass(MatchStatus status)
    {
        return status == MatchStatus.Live ? "status-live blink-live" :
               status == MatchStatus.Finished ? "status-finished" :
               "status-upcoming";
    }

    private string ParticipationText(bool hasPrediction, bool canPredict)
    {
        if (hasPrediction)
        {
            return "predicted";
        }

        if (canPredict)
        {
            return "notpredict";
        }

        return "notparticipate";
    }

    private string PointBadgeClass(int point)
    {
        return point == 0 ? "text-bg-secondary" :
               point == 3 ? "text-bg-primary" :
               "text-bg-warning";
    }
}

<style>
    .prediction-score-header {
        display: grid !important;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: start !important;
        column-gap: 10px;
        row-gap: 4px;
        width: 100%;
    }

    .prediction-score-title-block {
        min-width: 0;
    }

        .prediction-score-title-block h2 {
            margin: 0 0 4px 0;
            line-height: 1.2;
        }

        .prediction-score-title-block .text-muted {
            line-height: 1.35;
        }

    .prediction-score-back-btn {
        grid-column: 2;
        grid-row: 1;
        align-self: start;
        justify-self: end;
        border-radius: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

    .prediction-score-toolbar {
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        gap: 8px;
        width: 100%;
    }

    .prediction-score-search-box {
        position: relative;
        flex: 1 1 auto;
        min-width: 0;
    }

        .prediction-score-search-box .prediction-score-search-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            z-index: 2;
        }

        .prediction-score-search-box .form-control {
            padding-left: 38px;
            padding-right: 42px;
            min-height: 42px;
            border-radius: 12px;
            width: 100%;
        }

    .prediction-score-search-clear-inside {
        position: absolute;
        right: 9px;
        top: 50%;
        transform: translateY(-50%);
        width: 26px;
        height: 26px;
        border: 0;
        border-radius: 50%;
        background: #ffffff;
        color: #dc2626;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        z-index: 3;
        padding: 0;
        font-size: .9rem;
        line-height: 1;
    }

        .prediction-score-search-clear-inside:hover,
        .prediction-score-search-clear-inside:focus {
            background: #fee2e2;
            color: #b91c1c;
        }

    .prediction-score-search-no-native-clear::-webkit-search-decoration,
    .prediction-score-search-no-native-clear::-webkit-search-cancel-button,
    .prediction-score-search-no-native-clear::-webkit-search-results-button,
    .prediction-score-search-no-native-clear::-webkit-search-results-decoration {
        display: none;
        -webkit-appearance: none;
    }

    .prediction-score-search-no-native-clear {
        appearance: none;
        -webkit-appearance: none;
    }

    .prediction-score-scroll-top-btn {
        position: fixed;
        right: 18px;
        bottom: 22px;
        width: 42px;
        height: 42px;
        border-radius: 50%;
        border: 1px solid #bfdbfe;
        background: #0d6efd;
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        z-index: 5000;
        box-shadow: 0 10px 24px rgba(13, 110, 253, .28);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateY(10px);
        transition: transform .2s ease, opacity .2s ease, visibility .2s ease, background .2s ease;
    }

        .prediction-score-scroll-top-btn:hover,
        .prediction-score-scroll-top-btn:focus {
            background: #0b5ed7;
            color: #ffffff;
        }

        .prediction-score-scroll-top-btn.show {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
            transform: translateY(0);
        }

            .prediction-score-scroll-top-btn.show:hover,
            .prediction-score-scroll-top-btn.show:focus {
                transform: translateY(-2px);
            }

        .prediction-score-scroll-top-btn i {
            font-size: 1.15rem;
            line-height: 1;
        }

    @@media (max-width: 767.98px) {
        .prediction-score-page-card {
            padding: 14px !important;
            border-radius: 16px;
        }

        .prediction-score-header {
            grid-template-columns: minmax(0, 1fr) auto;
            align-items: start !important;
            column-gap: 8px;
            row-gap: 4px;
            margin-bottom: 14px !important;
        }

        .prediction-score-title-block h2 {
            font-size: 1.14rem;
            line-height: 1.2;
            margin-bottom: 0;
        }

        .prediction-score-title-block .text-muted {
            display: none !important;
        }

        .prediction-score-back-btn {
            min-height: 34px;
            padding: 6px 10px;
            font-size: .76rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
        }

        .prediction-score-toolbar {
            display: flex !important;
            flex-direction: row !important;
            align-items: center !important;
            gap: 6px !important;
            width: 100%;
        }

        .prediction-score-search-box {
            flex: 1 1 auto;
            min-width: 0;
        }

            .prediction-score-search-box .prediction-score-search-icon {
                left: 10px;
            }

            .prediction-score-search-box .form-control {
                min-height: 40px;
                font-size: .86rem;
                padding-left: 34px;
                padding-right: 38px;
            }

        .prediction-score-search-clear-inside {
            right: 7px;
            width: 24px;
            height: 24px;
            font-size: .82rem;
        }

        .prediction-score-scroll-top-btn {
            right: 14px;
            bottom: 16px;
            width: 38px;
            height: 38px;
            z-index: 6000;
        }

            .prediction-score-scroll-top-btn i {
                font-size: 1rem;
            }
    }

    @@media (max-width: 390px) {
        .prediction-score-title-block h2 {
            font-size: 1.08rem;
        }

        .prediction-score-back-btn {
            font-size: .72rem;
            padding-left: 8px;
            padding-right: 8px;
        }
    }
</style>

<div class="dashboard-card prediction-score-page-card p-3 p-md-4 mb-4" id="predictionScoreCard">

    <div class="prediction-score-header mb-3">
        <div class="prediction-score-title-block">
            <h2 class="h4 fw-bold">
                <i class="bi bi-grid-1x2 text-primary"></i>
                Prediction &amp; Score
            </h2>

            <div class="text-muted small">
                All fixtures are shown date-time wise ascending.
            </div>
        </div>

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-outline-primary btn-sm prediction-score-back-btn">
            <i class="bi bi-arrow-left"></i>
            Back to Dashboard
        </a>
    </div>

    <div id="predictionPageAlert" class="alert d-none mb-3"></div>

    <div class="prediction-score-profile-panel mb-3">

        <div class="prediction-score-profile-main">

            <img src="@avatarPath"
                 alt="@Model.FullName"
                 class="prediction-score-profile-photo" />

            <div class="prediction-score-profile-info">
                <h5>@Model.FullName</h5>

                <div class="prediction-score-designation">
                    @(string.IsNullOrWhiteSpace(Model.Designation) ? "-" : Model.Designation)
                </div>

                <div class="prediction-score-department">
                    @(string.IsNullOrWhiteSpace(Model.Department) ? "-" : Model.Department)
                </div>
            </div>

        </div>

        <div class="prediction-score-highlight-area">

            <div class="prediction-score-highlight-card rank-highlight">
                <div class="highlight-icon">
                    <i class="bi bi-trophy"></i>
                </div>

                <div>
                    <span>Rank</span>
                    <strong>@Model.RankText</strong>
                </div>
            </div>

            <div class="prediction-score-highlight-card point-highlight">
                <div class="highlight-icon">
                    <i class="bi bi-star-fill"></i>
                </div>

                <div>
                    <span>Total Score</span>
                    <strong id="summaryTotalPoint">@Model.TotalScore</strong>
                </div>
            </div>

        </div>

    </div>

    <div class="prediction-filter-buttons prediction-filter-buttons-smart mb-3">

        <button type="button"
                class="prediction-filter-btn-smart filter-smart-upcoming active"
                data-filter="upcominglive">
            <i class="bi bi-calendar-event"></i>
            Upcoming + Live
            <span id="countUpcomingLive">@upcomingLiveCount</span>
        </button>

        <button type="button"
                class="prediction-filter-btn-smart filter-smart-finished"
                data-filter="Finished">
            <i class="bi bi-check-circle"></i>
            Finished
            <span id="countFinished">@finishedCount</span>
        </button>

        <button type="button"
                class="prediction-filter-btn-smart filter-smart-all"
                data-filter="all">
            <i class="bi bi-grid"></i>
            All
            <span id="countAll">@totalFixtureCount</span>
        </button>

        <button type="button"
                class="prediction-filter-btn-smart filter-smart-predicted"
                data-filter="predicted">
            <i class="bi bi-check2-square"></i>
            Predicted
            <span id="summaryTotalPrediction">@totalPredictionCount</span>
        </button>

        <button type="button"
                class="prediction-filter-btn-smart filter-smart-notpredict"
                data-filter="notpredict">
            <i class="bi bi-pencil"></i>
            No Prediction
            <span id="summaryNotPredict">@notPredictCount</span>
        </button>

        <button type="button"
                class="prediction-filter-btn-smart filter-smart-notparticipate"
                data-filter="notparticipate">
            <i class="bi bi-slash-circle"></i>
            Not Participated
            <span id="summaryNotParticipate">@notParticipateCount</span>
        </button>

    </div>

    <div class="prediction-score-toolbar mb-3">

        <div class="prediction-score-search-box">
            <span class="prediction-score-search-icon">
                <i class="bi bi-search"></i>
            </span>

            <input type="search"
                   id="predictionScoreSearch"
                   class="form-control prediction-score-search-no-native-clear"
                   placeholder="Search" />

            <button type="button"
                    class="prediction-score-search-clear-inside"
                    id="predictionScoreClearSearch"
                    title="Clear search"
                    aria-label="Clear search">
                <i class="bi bi-x-circle"></i>
            </button>
        </div>

    </div>

    <div class="prediction-table-wrap">
        <table class="table table-clean table-hover align-middle mb-0 prediction-table">
            <thead>
                <tr>
                    <th>
                        <button type="button"
                                id="predictionDateSortBtn"
                                class="prediction-score-sort-btn"
                                data-sort-direction="asc">
                            Date & Time
                            <i id="predictionDateSortIcon" class="bi bi-arrow-up-short"></i>
                        </button>
                    </th>

                    <th>Match</th>

                    <th>
                        <button type="button"
                                id="predictionStatusSortBtn"
                                class="prediction-score-sort-btn"
                                data-sort-direction="asc">
                            Status
                            <i id="predictionStatusSortIcon" class="bi bi-arrow-up-short"></i>
                        </button>
                    </th>

                    <th>Prediction</th>
                    <th>Actual</th>

                    <th>
                        <button type="button"
                                id="predictionPointSortBtn"
                                class="prediction-score-sort-btn"
                                data-sort-direction="desc">
                            Point
                            <i id="predictionPointSortIcon" class="bi bi-arrow-down-short"></i>
                        </button>
                    </th>

                    <th>Action</th>
                </tr>
            </thead>

            <tbody id="predictionTableBody">
                @if (Model.PredictionFixtures == null || !Model.PredictionFixtures.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            No fixture found.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var fixture in Model.PredictionFixtures.OrderBy(x => x.MatchDateTime))
                    {
                        Prediction? prediction = null;

                        var hasPrediction = Model.UserPredictionLookup != null &&
                        Model.UserPredictionLookup.TryGetValue(fixture.Id, out prediction);

                        var canPredict = fixture.Status == MatchStatus.Upcoming &&
                        !fixture.IsProcessed &&
                        DateTime.Now < fixture.MatchDateTime;

                        var participation = ParticipationText(hasPrediction, canPredict);

                        var teamOneFlag = ToImageUrl(Url, fixture.TeamOneFlagPath, "/img/default-flag.svg");
                        var teamTwoFlag = ToImageUrl(Url, fixture.TeamTwoFlagPath, "/img/default-flag.svg");

                        var actualText = fixture.TeamOneActualGoal.HasValue && fixture.TeamTwoActualGoal.HasValue
                        ? $"{fixture.TeamOneActualGoal} - {fixture.TeamTwoActualGoal}"
                        : "Pending";

                        var pointSortValue = hasPrediction && prediction != null && prediction.IsProcessed
                        ? prediction.EarnedPoint
                        : -1;

                        var predictionTextForSearch = hasPrediction && prediction != null
                        ? $"{prediction.TeamOnePredictedGoal} - {prediction.TeamTwoPredictedGoal}"
                        : canPredict
                        ? "Not Predict"
                        : "Not Participated";

                        var pointTextForSearch = hasPrediction && prediction != null && prediction.IsProcessed
                        ? prediction.EarnedPoint.ToString()
                        : hasPrediction
                        ? "Pending"
                        : "-";

                        var searchText = $"{fixture.TeamOneName} {fixture.TeamTwoName} {fixture.Stage.GetDisplayName()} {fixture.Status} {predictionTextForSearch} {actualText} {pointTextForSearch} {fixture.MatchDateTime:dd MMM yyyy hh:mm tt}"
                        .ToLowerInvariant();

                        <tr id="fixture-row-@fixture.Id"
                            class="prediction-fixture-row"
                            data-fixture-id="@fixture.Id"
                            data-status="@fixture.Status"
                            data-status-sort="@fixture.Status.ToString()"
                            data-can-predict="@(canPredict ? "true" : "false")"
                            data-has-prediction="@(hasPrediction ? "true" : "false")"
                            data-participation="@participation"
                            data-match-time="@fixture.MatchDateTime.ToString("yyyy-MM-ddTHH:mm:ss")"
                            data-point="@pointSortValue"
                            data-search="@searchText">

                            <td>
                                <div class="fw-semibold">
                                    @fixture.MatchDateTime.ToString("dd MMM yyyy")
                                </div>
                                <div class="small text-muted">
                                    @fixture.MatchDateTime.ToString("hh:mm tt")
                                </div>
                            </td>

                            <td>
                                <div class="prediction-score-team-row">

                                    <div class="prediction-score-team">
                                        <img src="@teamOneFlag"
                                             class="prediction-score-flag"
                                             alt="@fixture.TeamOneName" />

                                        <span>@fixture.TeamOneName</span>
                                    </div>

                                    <strong class="text-muted">vs</strong>

                                    <div class="prediction-score-team">
                                        <img src="@teamTwoFlag"
                                             class="prediction-score-flag"
                                             alt="@fixture.TeamTwoName" />

                                        <span>@fixture.TeamTwoName</span>
                                    </div>

                                    <span class="prediction-score-stage-pill">
                                        @fixture.Stage.GetDisplayName()
                                    </span>

                                </div>
                            </td>

                            <td>
                                <span class="fixture-status @StatusClass(fixture.Status)">
                                    @fixture.Status
                                </span>
                            </td>

                            <td class="prediction-value-cell" data-fixture-id="@fixture.Id">
                                @if (hasPrediction && prediction != null)
                                {
                                    <span class="prediction-text-success">
                                        @prediction.TeamOnePredictedGoal - @prediction.TeamTwoPredictedGoal
                                    </span>
                                }
                                else if (canPredict)
                                {
                                    <span class="prediction-text-danger">
                                        Not Predict
                                    </span>
                                }
                                else
                                {
                                    <span class="prediction-text-muted">
                                        -
                                    </span>
                                }
                            </td>

                            <td>
                                @if (fixture.TeamOneActualGoal.HasValue && fixture.TeamTwoActualGoal.HasValue)
                                {
                                    <strong>@actualText</strong>
                                }
                                else
                                {
                                    <span class="text-muted">Pending</span>
                                }
                            </td>

                            <td class="prediction-point-cell" data-fixture-id="@fixture.Id">
                                @if (hasPrediction && prediction != null && prediction.IsProcessed)
                                {
                                    <span class="badge @PointBadgeClass(prediction.EarnedPoint)">
                                        @prediction.EarnedPoint
                                    </span>
                                }
                                else if (hasPrediction && prediction != null)
                                {
                                    <span class="badge text-bg-secondary">
                                        Pending
                                    </span>
                                }
                                else
                                {
                                    <span class="badge text-bg-light text-muted">
                                        -
                                    </span>
                                }
                            </td>

                            <td class="prediction-action-cell" data-fixture-id="@fixture.Id">
                                @if (!hasPrediction && canPredict)
                                {
                                    <button type="button"
                                            class="btn btn-warning btn-sm fw-bold js-open-prediction-modal"
                                            data-fixture-id="@fixture.Id"
                                            data-team-one="@fixture.TeamOneName"
                                            data-team-two="@fixture.TeamTwoName"
                                            data-team-one-flag="@teamOneFlag"
                                            data-team-two-flag="@teamTwoFlag"
                                            data-team-one-goal="0"
                                            data-team-two-goal="0"
                                            data-match-time="@fixture.MatchDateTime.ToString("dd MMM yyyy, hh:mm tt")"
                                            data-mode="Predict">
                                        <i class="bi bi-send"></i>
                                        Predict
                                    </button>
                                }
                                else if (hasPrediction && canPredict && prediction != null)
                                {
                                    <button type="button"
                                            class="btn btn-primary btn-sm fw-bold js-open-prediction-modal"
                                            data-fixture-id="@fixture.Id"
                                            data-team-one="@fixture.TeamOneName"
                                            data-team-two="@fixture.TeamTwoName"
                                            data-team-one-flag="@teamOneFlag"
                                            data-team-two-flag="@teamTwoFlag"
                                            data-team-one-goal="@prediction.TeamOnePredictedGoal"
                                            data-team-two-goal="@prediction.TeamTwoPredictedGoal"
                                            data-match-time="@fixture.MatchDateTime.ToString("dd MMM yyyy, hh:mm tt")"
                                            data-mode="Update">
                                        <i class="bi bi-pencil-square"></i>
                                        Update
                                    </button>
                                }
                                else if (fixture.Status == MatchStatus.Live ||
                                fixture.Status == MatchStatus.Finished ||
                                DateTime.Now >= fixture.MatchDateTime)
                                {
                                    <a asp-controller="Dashboard"
                                       asp-action="PredictionDetail"
                                       asp-route-fixtureId="@fixture.Id"
                                       class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-list-check"></i>
                                        Match Predictions
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">Locked</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div id="predictionScoreNoResult" class="empty-state mt-3 d-none">
        No fixture matched your search/filter.
    </div>

</div>

<div class="modal fade" id="predictionModal" tabindex="-1" aria-labelledby="predictionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content prediction-modal-content">

            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="predictionModalLabel">
                    Submit Prediction
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <form id="predictionAjaxForm">
                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <input type="hidden" id="modalFixtureId" name="fixtureId" />

                    <div id="predictionAjaxMessage" class="alert d-none"></div>

                    <div class="prediction-modal-match-time mb-3">
                        <div class="match-time-icon">
                            <i class="bi bi-calendar-event"></i>
                        </div>

                        <div>
                            <div class="match-time-label">Match Date & Time</div>
                            <div class="match-time-value" id="modalMatchDateTime"></div>
                        </div>
                    </div>

                    <div class="prediction-modal-teams">

                        <div class="prediction-modal-team">
                            <img id="modalTeamOneFlag" src="" alt="Team One" />
                            <strong id="modalTeamOneName"></strong>
                        </div>

                        <div class="prediction-modal-vs">VS</div>

                        <div class="prediction-modal-team">
                            <img id="modalTeamTwoFlag" src="" alt="Team Two" />
                            <strong id="modalTeamTwoName"></strong>
                        </div>

                    </div>

                    <div class="row g-3 mt-3 align-items-end">
                        <div class="col-5">
                            <label class="form-label small text-muted" id="modalTeamOneLabel"></label>
                            <input type="number"
                                   id="modalTeamOneGoal"
                                   name="teamOneGoal"
                                   min="0"
                                   max="99"
                                   class="form-control prediction-input text-center fw-bold"
                                   required />
                        </div>

                        <div class="col-2 text-center fw-bold pb-2">
                            -
                        </div>

                        <div class="col-5">
                            <label class="form-label small text-muted" id="modalTeamTwoLabel"></label>
                            <input type="number"
                                   id="modalTeamTwoGoal"
                                   name="teamTwoGoal"
                                   min="0"
                                   max="99"
                                   class="form-control prediction-input text-center fw-bold"
                                   required />
                        </div>
                    </div>

                    <div class="small text-muted mt-3">
                        Prediction is allowed only before match starts and only for Upcoming fixtures.
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            id="modalSavePredictionBtn"
                            class="btn btn-warning fw-bold">
                        <i class="bi bi-send"></i>
                        Save Prediction
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

<button type="button"
        class="prediction-score-scroll-top-btn"
        id="predictionScoreScrollTopBtn"
        title="Go to top"
        aria-label="Go to top">
    <i class="bi bi-arrow-up"></i>
</button>

<div id="customToast" class="custom-toast d-none">
    <div class="custom-toast-icon">
        <i id="customToastIcon" class="bi bi-check-circle-fill"></i>
    </div>

    <div id="customToastMessage" class="custom-toast-message">
        Prediction saved successfully.
    </div>

    <button type="button" class="custom-toast-close" onclick="hideCustomToast()">
        <i class="bi bi-x-lg"></i>
    </button>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const labels = @Html.Raw(segmentLabels);
        const points = @Html.Raw(segmentPoints);

        if (document.getElementById('segmentChart') && labels.length > 0) {
            new Chart(document.getElementById('segmentChart'), {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{ label: 'Points', data: points }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                }
            });
        }
    </script>

    <script>
        let predictionModal;
        let activePredictionScoreFilter = "upcominglive";

        document.addEventListener("DOMContentLoaded", function () {
            const modalElement = document.getElementById("predictionModal");

            if (modalElement && typeof bootstrap !== "undefined") {
                predictionModal = new bootstrap.Modal(modalElement);
            }

            bindPredictionButtons();
            bindPredictionFilterButtons();
            bindPredictionScoreSearch();
            bindPredictionScoreSort();
            bindPredictionScoreScrollTopButton();

            const form = document.getElementById("predictionAjaxForm");

            if (form) {
                form.addEventListener("submit", function (e) {
                    e.preventDefault();
                    savePredictionAjax();
                });
            }

            applyPredictionScoreSearchAndFilter();
        });

        function bindPredictionScoreScrollTopButton() {
            const scrollTopButton = document.getElementById("predictionScoreScrollTopBtn");

            if (!scrollTopButton) {
                return;
            }

            const possibleScrollContainers = [
                window,
                document.documentElement,
                document.body,
                document.querySelector("main"),
                document.querySelector(".main-content"),
                document.querySelector(".content-wrapper"),
                document.querySelector(".page-content"),
                document.querySelector(".dashboard-content"),
                document.querySelector(".app-main"),
                document.querySelector(".container-fluid"),
                document.querySelector(".container"),
                document.querySelector(".layout-main")
            ].filter(Boolean);

            function getScrollTopValue() {
                let maxScrollTop = window.scrollY || document.documentElement.scrollTop || document.body.scrollTop || 0;

                possibleScrollContainers.forEach(function (container) {
                    if (container === window) {
                        return;
                    }

                    if (container.scrollTop && container.scrollTop > maxScrollTop) {
                        maxScrollTop = container.scrollTop;
                    }
                });

                return maxScrollTop;
            }

            function toggleScrollTopButton() {
                if (getScrollTopValue() > 220) {
                    scrollTopButton.classList.add("show");
                } else {
                    scrollTopButton.classList.remove("show");
                }
            }

            possibleScrollContainers.forEach(function (container) {
                if (container === window) {
                    window.addEventListener("scroll", toggleScrollTopButton, { passive: true });
                } else {
                    container.addEventListener("scroll", toggleScrollTopButton, { passive: true });
                }
            });

            window.addEventListener("touchmove", toggleScrollTopButton, { passive: true });
            window.addEventListener("resize", toggleScrollTopButton, { passive: true });

            scrollTopButton.addEventListener("click", function () {
                window.scrollTo({
                    top: 0,
                    behavior: "smooth"
                });

                document.documentElement.scrollTo({
                    top: 0,
                    behavior: "smooth"
                });

                document.body.scrollTo({
                    top: 0,
                    behavior: "smooth"
                });

                possibleScrollContainers.forEach(function (container) {
                    if (container === window) {
                        return;
                    }

                    if (typeof container.scrollTo === "function") {
                        container.scrollTo({
                            top: 0,
                            behavior: "smooth"
                        });
                    } else {
                        container.scrollTop = 0;
                    }
                });
            });

            toggleScrollTopButton();
        }

        function bindPredictionButtons() {
            document.querySelectorAll(".js-open-prediction-modal").forEach(function (button) {
                button.removeEventListener("click", predictionButtonClickHandler);
                button.addEventListener("click", predictionButtonClickHandler);
            });
        }

        function predictionButtonClickHandler(e) {
            openPredictionModal(e.currentTarget);
        }

        function bindPredictionFilterButtons() {
            document.querySelectorAll(".prediction-filter-btn-smart").forEach(function (button) {
                button.addEventListener("click", function () {
                    const filter = button.getAttribute("data-filter") || "upcominglive";

                    activePredictionScoreFilter = filter;

                    document.querySelectorAll(".prediction-filter-btn-smart").forEach(function (btn) {
                        btn.classList.remove("active");
                    });

                    button.classList.add("active");

                    applyPredictionScoreSearchAndFilter();
                });
            });
        }

        function bindPredictionScoreSearch() {
            const searchInput = document.getElementById("predictionScoreSearch");
            const clearButton = document.getElementById("predictionScoreClearSearch");

            if (searchInput) {
                searchInput.addEventListener("input", function () {
                    applyPredictionScoreSearchAndFilter();
                });
            }

            if (clearButton) {
                clearButton.addEventListener("click", function () {
                    if (searchInput) {
                        searchInput.value = "";
                        searchInput.focus();
                    }

                    applyPredictionScoreSearchAndFilter();
                });
            }
        }

        function bindPredictionScoreSort() {
            bindSinglePredictionSort("predictionDateSortBtn", "predictionDateSortIcon", "date");
            bindSinglePredictionSort("predictionStatusSortBtn", "predictionStatusSortIcon", "status");
            bindSinglePredictionSort("predictionPointSortBtn", "predictionPointSortIcon", "point");
        }

        function bindSinglePredictionSort(buttonId, iconId, sortBy) {
            const sortButton = document.getElementById(buttonId);

            if (!sortButton) {
                return;
            }

            sortButton.addEventListener("click", function () {
                const currentDirection = sortButton.getAttribute("data-sort-direction") || "asc";
                const nextDirection = currentDirection === "asc" ? "desc" : "asc";

                sortButton.setAttribute("data-sort-direction", nextDirection);

                const icon = document.getElementById(iconId);

                if (icon) {
                    icon.className = nextDirection === "asc"
                        ? "bi bi-arrow-up-short"
                        : "bi bi-arrow-down-short";
                }

                sortPredictionScoreRows(sortBy, nextDirection);
                applyPredictionScoreSearchAndFilter();
            });
        }

        function sortPredictionScoreRows(sortBy, direction) {
            const tbody = document.getElementById("predictionTableBody");

            if (!tbody) {
                return;
            }

            const rows = Array.from(tbody.querySelectorAll(".prediction-fixture-row"));

            rows.sort(function (a, b) {
                let aValue;
                let bValue;

                if (sortBy === "date") {
                    aValue = new Date(a.getAttribute("data-match-time")).getTime();
                    bValue = new Date(b.getAttribute("data-match-time")).getTime();
                } else if (sortBy === "point") {
                    aValue = parseInt(a.getAttribute("data-point") || "-1");
                    bValue = parseInt(b.getAttribute("data-point") || "-1");
                } else if (sortBy === "status") {
                    aValue = a.getAttribute("data-status-sort") || "";
                    bValue = b.getAttribute("data-status-sort") || "";
                }

                if (aValue < bValue) {
                    return direction === "asc" ? -1 : 1;
                }

                if (aValue > bValue) {
                    return direction === "asc" ? 1 : -1;
                }

                return 0;
            });

            rows.forEach(function (row) {
                tbody.appendChild(row);
            });
        }

        function applyPredictionScoreSearchAndFilter() {
            const searchInput = document.getElementById("predictionScoreSearch");
            const noResult = document.getElementById("predictionScoreNoResult");

            const searchText = searchInput
                ? searchInput.value.trim().toLowerCase()
                : "";

            let visibleCount = 0;

            document.querySelectorAll(".prediction-fixture-row").forEach(function (item) {
                const status = item.getAttribute("data-status");
                const participation = item.getAttribute("data-participation");
                const searchable = item.getAttribute("data-search") || "";

                let matchesFilter = false;

                if (activePredictionScoreFilter === "upcominglive") {
                    matchesFilter = status === "Upcoming" || status === "Live";
                } else if (activePredictionScoreFilter === "all") {
                    matchesFilter = true;
                } else if (activePredictionScoreFilter === "Finished") {
                    matchesFilter = status === "Finished";
                } else if (
                    activePredictionScoreFilter === "predicted" ||
                    activePredictionScoreFilter === "notpredict" ||
                    activePredictionScoreFilter === "notparticipate"
                ) {
                    matchesFilter = participation === activePredictionScoreFilter;
                }

                const matchesSearch = searchText === "" || searchable.includes(searchText);
                const shouldShow = matchesFilter && matchesSearch;

                if (shouldShow) {
                    item.classList.remove("d-none");
                    visibleCount++;
                } else {
                    item.classList.add("d-none");
                }
            });

            if (noResult) {
                if (visibleCount === 0 && document.querySelectorAll(".prediction-fixture-row").length > 0) {
                    noResult.classList.remove("d-none");
                } else {
                    noResult.classList.add("d-none");
                }
            }
        }

        function openPredictionModal(button) {
            if (!predictionModal) {
                showCustomToast("Prediction popup could not be loaded. Please refresh the page.", "error");
                return;
            }

            const fixtureId = button.getAttribute("data-fixture-id");
            const teamOne = button.getAttribute("data-team-one") || "";
            const teamTwo = button.getAttribute("data-team-two") || "";
            const teamOneFlag = button.getAttribute("data-team-one-flag") || "";
            const teamTwoFlag = button.getAttribute("data-team-two-flag") || "";
            const teamOneGoal = button.getAttribute("data-team-one-goal") || "0";
            const teamTwoGoal = button.getAttribute("data-team-two-goal") || "0";
            const matchTime = button.getAttribute("data-match-time") || "";
            const mode = button.getAttribute("data-mode") || "Predict";

            setText("predictionModalLabel", mode + " Prediction");
            setValue("modalFixtureId", fixtureId);
            setText("modalMatchDateTime", matchTime);

            setText("modalTeamOneName", teamOne);
            setText("modalTeamTwoName", teamTwo);

            setText("modalTeamOneLabel", teamOne);
            setText("modalTeamTwoLabel", teamTwo);

            setImage("modalTeamOneFlag", teamOneFlag);
            setImage("modalTeamTwoFlag", teamTwoFlag);

            setValue("modalTeamOneGoal", teamOneGoal);
            setValue("modalTeamTwoGoal", teamTwoGoal);

            const messageBox = document.getElementById("predictionAjaxMessage");

            if (messageBox) {
                messageBox.className = "alert d-none";
                messageBox.innerText = "";
            }

            const saveBtn = document.getElementById("modalSavePredictionBtn");

            if (saveBtn) {
                saveBtn.disabled = false;
                saveBtn.innerHTML = '<i class="bi bi-send"></i> Save Prediction';
            }

            predictionModal.show();
        }

        async function savePredictionAjax() {
            const form = document.getElementById("predictionAjaxForm");
            const saveBtn = document.getElementById("modalSavePredictionBtn");

            if (!form) {
                showModalMessage("Prediction form not found.", "danger");
                return;
            }

            const teamOneGoal = document.getElementById("modalTeamOneGoal")?.value;
            const teamTwoGoal = document.getElementById("modalTeamTwoGoal")?.value;

            if (teamOneGoal === "" || teamTwoGoal === "") {
                showModalMessage("Please enter both team goals.", "danger");
                return;
            }

            if (parseInt(teamOneGoal) < 0 || parseInt(teamTwoGoal) < 0) {
                showModalMessage("Goal cannot be negative.", "danger");
                return;
            }

            const formData = new FormData(form);
            const tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : "";

            if (saveBtn) {
                saveBtn.disabled = true;
                saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Saving...';
            }

            try {
                const response = await fetch('@Url.Action("SaveAjax", "Prediction")', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': token,
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                const contentType = response.headers.get("content-type") || "";

                if (!response.ok) {
                    throw new Error("Server returned " + response.status);
                }

                if (!contentType.includes("application/json")) {
                    throw new Error("Server did not return JSON. Check SaveAjax action and login/session.");
                }

                const data = await response.json();

                if (!data.success) {
                    showCustomToast(data.message || "Prediction could not be saved.", "error");
                    resetSaveButton();
                    return;
                }

                updatePredictionUi(data);

                if (predictionModal) {
                    predictionModal.hide();
                }

                showCustomToast(data.message || "Prediction saved successfully.", "success");

                resetSaveButton();
            }
            catch (error) {
                console.error(error);
                showCustomToast("Unexpected error occurred. Please try again.", "error");
                resetSaveButton();
            }
        }

        function updatePredictionUi(data) {
            const fixtureId = data.fixtureId;

            const row = document.getElementById("fixture-row-" + fixtureId);
            const wasPredictedBefore = row ? row.getAttribute("data-has-prediction") === "true" : true;
            const canPredict = row ? row.getAttribute("data-can-predict") === "true" : false;

            updatePredictionTableRow(data);

            if (!wasPredictedBefore && canPredict) {
                updatePredictionCountersAfterSave();
            }
        }

        function updatePredictionTableRow(data) {
            const fixtureId = data.fixtureId;

            const row = document.getElementById("fixture-row-" + fixtureId);
            const predictionCell = document.querySelector('.prediction-value-cell[data-fixture-id="' + fixtureId + '"]');
            const pointCell = document.querySelector('.prediction-point-cell[data-fixture-id="' + fixtureId + '"]');
            const actionCell = document.querySelector('.prediction-action-cell[data-fixture-id="' + fixtureId + '"]');

            if (predictionCell) {
                predictionCell.innerHTML =
                    '<span class="prediction-text-success">' + escapeHtml(data.predictionText) + '</span>';
            }

            if (pointCell) {
                pointCell.innerHTML =
                    '<span class="badge text-bg-secondary">' + escapeHtml(data.pointText || "Pending") + '</span>';
            }

            if (actionCell) {
                actionCell.innerHTML = buildUpdateButtonHtml(fixtureId);
                bindPredictionButtons();
            }

            if (row) {
                row.setAttribute("data-has-prediction", "true");
                row.setAttribute("data-participation", "predicted");
                row.setAttribute("data-point", "-1");

                const oldSearch = row.getAttribute("data-search") || "";
                const updatedSearch = oldSearch + " " + String(data.predictionText || "").toLowerCase() + " pending predicted";
                row.setAttribute("data-search", updatedSearch);

                flashUpdatedItem(row);
                applyPredictionScoreSearchAndFilter();
            }
        }

        function buildUpdateButtonHtml(fixtureId) {
            const teamOne = getText("modalTeamOneName");
            const teamTwo = getText("modalTeamTwoName");
            const teamOneFlag = document.getElementById("modalTeamOneFlag")?.src || "";
            const teamTwoFlag = document.getElementById("modalTeamTwoFlag")?.src || "";
            const teamOneGoal = document.getElementById("modalTeamOneGoal")?.value || "0";
            const teamTwoGoal = document.getElementById("modalTeamTwoGoal")?.value || "0";
            const matchTime = document.getElementById("modalMatchDateTime")?.innerText || "";

            return '<button type="button" ' +
                'class="btn btn-primary btn-sm fw-bold js-open-prediction-modal" ' +
                'data-fixture-id="' + escapeHtml(fixtureId) + '" ' +
                'data-team-one="' + escapeHtml(teamOne) + '" ' +
                'data-team-two="' + escapeHtml(teamTwo) + '" ' +
                'data-team-one-flag="' + escapeHtml(teamOneFlag) + '" ' +
                'data-team-two-flag="' + escapeHtml(teamTwoFlag) + '" ' +
                'data-team-one-goal="' + escapeHtml(teamOneGoal) + '" ' +
                'data-team-two-goal="' + escapeHtml(teamTwoGoal) + '" ' +
                'data-match-time="' + escapeHtml(matchTime) + '" ' +
                'data-mode="Update">' +
                '<i class="bi bi-pencil-square"></i> Update' +
                '</button>';
        }

        function updatePredictionCountersAfterSave() {
            incrementNumber("summaryTotalPrediction", 1);
            incrementNumber("summaryNotPredict", -1);
        }

        function incrementNumber(id, amount) {
            const element = document.getElementById(id);

            if (!element) {
                return;
            }

            const currentValue = parseInt(element.innerText || "0");
            const nextValue = Math.max(currentValue + amount, 0);

            element.innerText = nextValue;
        }

        function flashUpdatedItem(element) {
            element.classList.add("prediction-row-updated");

            setTimeout(function () {
                element.classList.remove("prediction-row-updated");
            }, 1800);
        }

        function showModalMessage(message, type) {
            const messageBox = document.getElementById("predictionAjaxMessage");

            if (!messageBox) {
                showCustomToast(message, type === "danger" ? "error" : "success");
                return;
            }

            messageBox.className = "alert alert-" + type;
            messageBox.innerText = message;
        }

        function showCustomToast(message, type = "success") {
            const toast = document.getElementById("customToast");
            const toastMessage = document.getElementById("customToastMessage");
            const toastIcon = document.getElementById("customToastIcon");

            if (!toast || !toastMessage) {
                console.log(message);
                return;
            }

            toastMessage.innerText = message;

            toast.classList.remove("success", "error", "d-none", "show");
            toast.classList.add(type === "error" ? "error" : "success");

            if (toastIcon) {
                toastIcon.className = type === "error"
                    ? "bi bi-x-circle-fill"
                    : "bi bi-check-circle-fill";
            }

            setTimeout(function () {
                toast.classList.add("show");
            }, 20);

            setTimeout(function () {
                hideCustomToast();
            }, 2000);
        }

        function hideCustomToast() {
            const toast = document.getElementById("customToast");

            if (!toast) {
                return;
            }

            toast.classList.remove("show");

            setTimeout(function () {
                toast.classList.add("d-none");
            }, 250);
        }

        function resetSaveButton() {
            const saveBtn = document.getElementById("modalSavePredictionBtn");

            if (saveBtn) {
                saveBtn.disabled = false;
                saveBtn.innerHTML = '<i class="bi bi-send"></i> Save Prediction';
            }
        }

        function setText(id, value) {
            const element = document.getElementById(id);

            if (element) {
                element.innerText = value;
            }
        }

        function getText(id) {
            const element = document.getElementById(id);
            return element ? element.innerText : "";
        }

        function setValue(id, value) {
            const element = document.getElementById(id);

            if (element) {
                element.value = value;
            }
        }

        function setImage(id, value) {
            const element = document.getElementById(id);

            if (element) {
                element.src = value;
            }
        }

        function escapeHtml(value) {
            return String(value)
                .replace(/&/g, "&amp;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;");
        }
    </script>
}