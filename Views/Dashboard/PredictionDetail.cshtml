@model FootballPredictionGame.ViewModels.FixturePredictionDetailViewModel

@{
    ViewData["Title"] = "Match Predictions";

    string TeamFlag(string? path)
    {
        return string.IsNullOrWhiteSpace(path)
            ? Url.Content("~/img/default-flag.svg")
            : Url.Content("~/" + path.TrimStart('/', '~'));
    }

    string UserPhoto(string? path)
    {
        return string.IsNullOrWhiteSpace(path)
            ? Url.Content("~/img/default-avatar.svg")
            : Url.Content("~/" + path.TrimStart('/', '~'));
    }

    string UserInfo(string? designation, string? department)
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(designation))
        {
            parts.Add(designation);
        }

        if (!string.IsNullOrWhiteSpace(department))
        {
            parts.Add(department);
        }

        return parts.Any() ? string.Join(" • ", parts) : "-";
    }

    string PointBadgeClass(int point)
    {
        return point == 0
            ? "text-bg-secondary"
            : point == 3
                ? "text-bg-primary"
                : "text-bg-warning";
    }

    int RankSortValue(string? rankText)
    {
        if (string.IsNullOrWhiteSpace(rankText))
        {
            return 999999;
        }

        var clean = rankText.Replace("#", "").Trim();

        return int.TryParse(clean, out var value)
            ? value
            : 999999;
    }

    var actualScore = Model.TeamOneActualGoal.HasValue && Model.TeamTwoActualGoal.HasValue
        ? $"{Model.TeamOneActualGoal} - {Model.TeamTwoActualGoal}"
        : "Pending";

    var statusClass = Model.StatusName == "Live"
        ? "status-live blink-live"
        : "status-finished";
}

<style>
    .prediction-detail-page {
        overflow: hidden;
    }

    .prediction-detail-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: nowrap;
    }

    .prediction-detail-title-row {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }

        .prediction-detail-title-row h2 {
            margin: 0;
            font-weight: 800;
        }

    .prediction-detail-action-row {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
        flex-wrap: nowrap;
        margin-left: auto;
    }

        .prediction-detail-action-row .btn {
            font-weight: 700;
            border-radius: 10px;
            white-space: nowrap;
        }

    .prediction-mobile-action-row {
        display: none;
    }

    .prediction-history-back-btn {
        border-radius: 999px !important;
        font-weight: 700;
        white-space: nowrap;
    }

    .match-prediction-summary {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
        align-items: center;
        gap: 12px;
        border: 1px solid #bfdbfe;
        background: #fffdf8;
        border-radius: 16px;
        padding: 16px;
    }

    .match-summary-team {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        min-width: 0;
        text-align: center;
    }

        .match-summary-team strong {
            display: block;
            width: 100%;
            font-size: .9rem;
            color: #111827;
            line-height: 1.2;
            white-space: normal;
            overflow-wrap: anywhere;
            word-break: normal;
        }

    .match-summary-flag {
        width: 52px;
        height: 34px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        background: #ffffff;
    }

    .match-summary-center {
        min-width: 150px;
        text-align: center;
    }

    .match-summary-meta {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        flex-wrap: wrap;
        margin-bottom: 7px;
    }

    .match-summary-stage {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        padding: 4px 9px;
        font-size: .75rem;
        font-weight: 800;
        color: #0f766e;
        background: #ccfbf1;
        border: 1px solid #99f6e4;
        white-space: nowrap;
    }

    .match-summary-date {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        border-radius: 999px;
        padding: 4px 9px;
        font-size: .75rem;
        font-weight: 700;
        color: #475569;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        white-space: nowrap;
    }

        .match-summary-date i {
            display: inline-block !important;
            visibility: visible !important;
            opacity: 1 !important;
            line-height: 1;
        }

    .match-summary-score {
        font-size: 1.55rem;
        font-weight: 900;
        color: #020617;
        line-height: 1.1;
        margin-bottom: 6px;
    }

    .match-prediction-toolbar {
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        gap: 8px;
        width: 100%;
    }

    .match-prediction-search-box {
        position: relative;
        flex: 1 1 auto;
        min-width: 0;
    }

    .match-prediction-search-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #64748b;
        z-index: 2;
    }

    .match-prediction-search-box .form-control {
        padding-left: 38px;
        padding-right: 42px;
        min-height: 42px;
        border-radius: 12px;
        width: 100%;
    }

    .match-prediction-search-clear {
        position: absolute;
        right: 9px;
        top: 50%;
        transform: translateY(-50%);
        width: 26px;
        height: 26px;
        border: 0;
        border-radius: 50%;
        background: #ffffff;
        color: #dc2626;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        z-index: 3;
        padding: 0;
        font-size: .9rem;
        line-height: 1;
    }

        .match-prediction-search-clear:hover,
        .match-prediction-search-clear:focus {
            background: #fee2e2;
            color: #b91c1c;
        }

    .match-prediction-search-no-native-clear::-webkit-search-decoration,
    .match-prediction-search-no-native-clear::-webkit-search-cancel-button,
    .match-prediction-search-no-native-clear::-webkit-search-results-button,
    .match-prediction-search-no-native-clear::-webkit-search-results-decoration {
        display: none;
        -webkit-appearance: none;
    }

    .match-prediction-search-no-native-clear {
        appearance: none;
        -webkit-appearance: none;
    }

    .match-prediction-mobile-excel-btn {
        display: none;
    }

    .match-prediction-sort-btn {
        border: 0;
        background: transparent;
        padding: 0;
        font-weight: 800;
        color: #111827;
        display: inline-flex;
        align-items: center;
        gap: 3px;
        white-space: nowrap;
    }

        .match-prediction-sort-btn:hover,
        .match-prediction-sort-btn:focus {
            color: #0d6efd;
        }

    .match-prediction-table-wrap {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .match-prediction-scroll-top-btn {
        position: fixed;
        right: 18px;
        bottom: 22px;
        width: 42px;
        height: 42px;
        border-radius: 50%;
        border: 1px solid #bfdbfe;
        background: #0d6efd;
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        z-index: 5000;
        box-shadow: 0 10px 24px rgba(13, 110, 253, .28);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateY(10px);
        transition: transform .2s ease, opacity .2s ease, visibility .2s ease, background .2s ease;
    }

        .match-prediction-scroll-top-btn:hover,
        .match-prediction-scroll-top-btn:focus {
            background: #0b5ed7;
            color: #ffffff;
        }

        .match-prediction-scroll-top-btn.show {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
            transform: translateY(0);
        }

            .match-prediction-scroll-top-btn.show:hover,
            .match-prediction-scroll-top-btn.show:focus {
                transform: translateY(-2px);
            }

        .match-prediction-scroll-top-btn i {
            font-size: 1.15rem;
            line-height: 1;
        }

    @@media (max-width: 767.98px) {
        .prediction-detail-page {
            padding: 14px !important;
            border-radius: 16px;
        }

        .prediction-detail-topbar {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            align-items: center;
            gap: 10px;
            margin-bottom: 12px !important;
        }

        .prediction-detail-title-row {
            min-width: 0;
        }

            .prediction-detail-title-row h2 {
                font-size: 1.25rem;
                line-height: 1.2;
            }

        .prediction-detail-action-row {
            display: none !important;
        }

        .prediction-mobile-action-row {
            display: inline-flex !important;
            align-items: center;
            justify-content: flex-end;
            gap: 6px;
        }

        .prediction-mobile-icon-btn {
            min-width: 42px;
            height: 34px;
            border-radius: 999px;
            padding: 6px 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 3px;
            font-size: .8rem;
            font-weight: 700;
        }

        .prediction-mobile-back-btn {
            min-width: 64px;
        }

        .match-prediction-summary {
            grid-template-columns: minmax(0, 1fr) minmax(104px, auto) minmax(0, 1fr);
            gap: 8px;
            padding: 14px 10px;
            border-radius: 16px;
            margin-bottom: 12px !important;
        }

        .match-summary-flag {
            width: 48px;
            height: 32px;
        }

        .match-summary-team {
            gap: 5px;
        }

            .match-summary-team strong {
                font-size: .78rem;
                line-height: 1.12;
                max-width: 96px;
                white-space: normal;
                overflow-wrap: anywhere;
                word-break: normal;
            }

        .match-summary-center {
            min-width: 104px;
        }

        .match-summary-meta {
            gap: 4px;
            margin-bottom: 6px;
        }

        .match-summary-stage,
        .match-summary-date {
            font-size: .62rem;
            padding: 3px 6px;
        }

            .match-summary-date i {
                display: inline-block !important;
                visibility: visible !important;
                opacity: 1 !important;
                font-size: .68rem;
                margin-right: 2px;
            }

        .match-summary-score {
            font-size: 1.32rem;
        }

        .match-prediction-toolbar {
            gap: 6px !important;
            margin-bottom: 12px !important;
        }

        .match-prediction-search-icon {
            left: 10px;
        }

        .match-prediction-search-box .form-control {
            min-height: 40px;
            font-size: .86rem;
            padding-left: 34px;
            padding-right: 38px;
        }

        .match-prediction-search-clear {
            right: 7px;
            width: 24px;
            height: 24px;
            font-size: .82rem;
        }

        .match-prediction-mobile-excel-btn {
            flex: 0 0 auto;
            display: inline-flex !important;
            align-items: center;
            justify-content: center;
            gap: 2px;
            width: 42px !important;
            min-width: 42px !important;
            height: 40px !important;
            min-height: 40px !important;
            border-radius: 12px;
            padding: 0 !important;
            line-height: 1;
        }

            .match-prediction-mobile-excel-btn i {
                margin: 0 !important;
                line-height: 1;
                font-size: .82rem;
            }

        .match-prediction-scroll-top-btn {
            right: 14px;
            bottom: 16px;
            width: 38px;
            height: 38px;
            z-index: 6000;
        }

            .match-prediction-scroll-top-btn i {
                font-size: 1rem;
            }
    }

    @@media (max-width: 390px) {
        .prediction-mobile-icon-btn {
            min-width: 40px;
            padding-left: 8px;
            padding-right: 8px;
            font-size: .76rem;
        }

        .prediction-mobile-back-btn {
            min-width: 58px;
        }

        .match-prediction-summary {
            grid-template-columns: minmax(0, 1fr) minmax(98px, auto) minmax(0, 1fr);
            gap: 6px;
            padding-left: 8px;
            padding-right: 8px;
        }

        .match-summary-center {
            min-width: 98px;
        }

        .match-summary-score {
            font-size: 1.22rem;
        }

        .match-summary-team strong {
            font-size: .74rem;
            max-width: 90px;
        }

        .match-summary-stage,
        .match-summary-date {
            font-size: .58rem;
            padding-left: 5px;
            padding-right: 5px;
        }

            .match-summary-date i {
                font-size: .62rem;
            }

        .match-prediction-mobile-excel-btn {
            width: 40px !important;
            min-width: 40px !important;
        }

            .match-prediction-mobile-excel-btn i {
                font-size: .78rem;
            }
    }
</style>

<div class="dashboard-card prediction-detail-page p-3 p-md-4 mb-4">

    <div class="prediction-detail-topbar mb-3">

        <div class="prediction-detail-title-row">
            <h2 class="h4 fw-bold">
                <i class="bi bi-list-check text-primary"></i>
                Match Predictions
            </h2>
        </div>

        <div class="prediction-mobile-action-row">
            <a asp-action="Index"
               class="btn btn-outline-primary btn-sm prediction-mobile-icon-btn"
               title="Back to Dashboard"
               aria-label="Back to Dashboard">
                <i class="bi bi-arrow-left"></i>
                <i class="bi bi-speedometer2"></i>
            </a>

            <button type="button"
                    class="btn btn-outline-primary btn-sm prediction-mobile-icon-btn prediction-mobile-back-btn"
                    onclick="window.history.back();">
                <i class="bi bi-arrow-left"></i>
                Back
            </button>
        </div>

        <div class="prediction-detail-action-row">

            <a asp-action="DownloadFixturePredictionsExcel"
               asp-route-fixtureId="@Model.FixtureId"
               class="btn btn-success btn-sm">
                <i class="bi bi-file-earmark-excel"></i>
                Download Excel
            </a>

            <a asp-action="Index"
               class="btn btn-outline-primary btn-sm">
                <i class="bi bi-speedometer2"></i>
                Back to Dashboard
            </a>

            <button type="button"
                    class="btn btn-outline-primary btn-sm prediction-history-back-btn"
                    onclick="window.history.back();">
                <i class="bi bi-arrow-left"></i>
                Back
            </button>

        </div>

    </div>

    <div class="match-prediction-summary mb-4">

        <div class="match-summary-team">
            <img src="@TeamFlag(Model.TeamOneFlagPath)"
                 class="match-summary-flag"
                 alt="@Model.TeamOneName" />

            <strong>@Model.TeamOneName</strong>
        </div>

        <div class="match-summary-center">

            <div class="match-summary-meta">
                <span class="match-summary-stage">
                    @Model.StageName
                </span>

                <span class="match-summary-date">
                    <i class="bi bi-clock"></i>
                    @Model.MatchDateTime.ToString("dd MMM yyyy, hh:mm tt")
                </span>
            </div>

            <div class="match-summary-score">
                @actualScore
            </div>

            <div class="fixture-status @statusClass">
                @Model.StatusName
            </div>
        </div>

        <div class="match-summary-team">
            <img src="@TeamFlag(Model.TeamTwoFlagPath)"
                 class="match-summary-flag"
                 alt="@Model.TeamTwoName" />

            <strong>@Model.TeamTwoName</strong>
        </div>

    </div>

    <div class="match-prediction-toolbar mb-3">

        <div class="match-prediction-search-box">
            <span class="match-prediction-search-icon">
                <i class="bi bi-search"></i>
            </span>

            <input type="search"
                   id="matchPredictionSearch"
                   class="form-control match-prediction-search-no-native-clear"
                   placeholder="Search" />

            <button type="button"
                    class="match-prediction-search-clear"
                    id="matchPredictionClearSearch"
                    title="Clear search"
                    aria-label="Clear search">
                <i class="bi bi-x-circle"></i>
            </button>
        </div>

        <a asp-action="DownloadFixturePredictionsExcel"
           asp-route-fixtureId="@Model.FixtureId"
           class="btn btn-success match-prediction-mobile-excel-btn"
           title="Download Excel"
           aria-label="Download Excel">
            <i class="bi bi-download"></i>
            <i class="bi bi-file-earmark-excel"></i>
        </a>

    </div>

    <div class="match-prediction-table-wrap">
        <table class="table table-clean table-hover align-middle mb-0 match-prediction-table">
            <thead>
                <tr>
                    <th>
                        <button type="button"
                                class="match-prediction-sort-btn"
                                data-sort-field="rank"
                                data-sort-direction="asc">
                            Rank
                            <i class="bi bi-arrow-down-up"></i>
                        </button>
                    </th>

                    <th>Player</th>
                    <th>Prediction</th>

                    <th>
                        <button type="button"
                                class="match-prediction-sort-btn"
                                data-sort-field="point"
                                data-sort-direction="desc">
                            Point
                            <i class="bi bi-arrow-down-up"></i>
                        </button>
                    </th>

                    <th>
                        <button type="button"
                                class="match-prediction-sort-btn"
                                data-sort-field="score"
                                data-sort-direction="desc">
                            Total Score
                            <i class="bi bi-arrow-down-up"></i>
                        </button>
                    </th>

                    <th>
                        <button type="button"
                                class="match-prediction-sort-btn"
                                data-sort-field="exact"
                                data-sort-direction="desc">
                            Exact
                            <i class="bi bi-arrow-down-up"></i>
                        </button>
                    </th>

                    <th>
                        <button type="button"
                                class="match-prediction-sort-btn"
                                data-sort-field="win"
                                data-sort-direction="desc">
                            Win
                            <i class="bi bi-arrow-down-up"></i>
                        </button>
                    </th>

                    <th>Detail</th>
                </tr>
            </thead>

            <tbody id="matchPredictionTableBody">
                @if (Model.Predictions == null || !Model.Predictions.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            No prediction submitted for this fixture.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model.Predictions)
                    {
                        var userInfo = UserInfo(item.Designation, item.Department);
                        var predictionText = $"{item.TeamOnePredictedGoal} - {item.TeamTwoPredictedGoal}";
                        var rankSort = RankSortValue(item.RankText);

                        var searchableText = $"{item.RankText} {item.UserName} {userInfo} {predictionText} {item.EarnedPoint} {item.TotalScore} {item.ExactPredictionCount} {item.WinMatchPredictionCount}".ToLowerInvariant();

                        <tr class="match-prediction-row"
                            data-search="@searchableText"
                            data-rank="@rankSort"
                            data-point="@item.EarnedPoint"
                            data-score="@item.TotalScore"
                            data-exact="@item.ExactPredictionCount"
                            data-win="@item.WinMatchPredictionCount">
                            <td>
                                <span class="rank-circle">
                                    @item.RankText
                                </span>
                            </td>

                            <td>
                                <div class="match-prediction-player-cell">
                                    <img src="@UserPhoto(item.PhotoPath)"
                                         class="match-prediction-avatar"
                                         alt="@item.UserName" />

                                    <div class="match-prediction-player-info">
                                        <strong>@item.UserName</strong>

                                        <div class="small text-muted match-prediction-subtitle">
                                            @userInfo
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <span class="prediction-score-pill">
                                    @predictionText
                                </span>
                            </td>

                            <td>
                                <span class="badge @PointBadgeClass(item.EarnedPoint)">
                                    @item.EarnedPoint
                                </span>
                            </td>

                            <td>
                                <span class="score-pill">
                                    @item.TotalScore
                                </span>
                            </td>

                            <td>
                                <span class="badge text-bg-primary">
                                    @item.ExactPredictionCount
                                </span>
                            </td>

                            <td>
                                <span class="badge text-bg-warning">
                                    @item.WinMatchPredictionCount
                                </span>
                            </td>

                            <td>
                                <a asp-action="UserPredictionDetail"
                                   asp-route-userId="@item.UserId"
                                   class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-list-check"></i>
                                    Detail
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div id="matchPredictionNoResult" class="empty-state mt-3 d-none">
        No player matched your search.
    </div>

</div>

<button type="button"
        class="match-prediction-scroll-top-btn"
        id="matchPredictionScrollTopBtn"
        title="Go to top"
        aria-label="Go to top">
    <i class="bi bi-arrow-up"></i>
</button>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            bindMatchPredictionSearch();
            bindMatchPredictionSort();
            bindMatchPredictionScrollTopButton();
        });

        function bindMatchPredictionScrollTopButton() {
            const scrollTopButton = document.getElementById("matchPredictionScrollTopBtn");

            if (!scrollTopButton) {
                return;
            }

            const possibleScrollContainers = [
                window,
                document.documentElement,
                document.body,
                document.querySelector("main"),
                document.querySelector(".main-content"),
                document.querySelector(".content-wrapper"),
                document.querySelector(".page-content"),
                document.querySelector(".dashboard-content"),
                document.querySelector(".app-main"),
                document.querySelector(".container-fluid"),
                document.querySelector(".container"),
                document.querySelector(".layout-main")
            ].filter(Boolean);

            function getScrollTopValue() {
                let maxScrollTop = window.scrollY || document.documentElement.scrollTop || document.body.scrollTop || 0;

                possibleScrollContainers.forEach(function (container) {
                    if (container === window) {
                        return;
                    }

                    if (container.scrollTop && container.scrollTop > maxScrollTop) {
                        maxScrollTop = container.scrollTop;
                    }
                });

                return maxScrollTop;
            }

            function toggleScrollTopButton() {
                if (getScrollTopValue() > 220) {
                    scrollTopButton.classList.add("show");
                } else {
                    scrollTopButton.classList.remove("show");
                }
            }

            possibleScrollContainers.forEach(function (container) {
                if (container === window) {
                    window.addEventListener("scroll", toggleScrollTopButton, { passive: true });
                } else {
                    container.addEventListener("scroll", toggleScrollTopButton, { passive: true });
                }
            });

            window.addEventListener("touchmove", toggleScrollTopButton, { passive: true });
            window.addEventListener("resize", toggleScrollTopButton, { passive: true });

            scrollTopButton.addEventListener("click", function () {
                window.scrollTo({
                    top: 0,
                    behavior: "smooth"
                });

                document.documentElement.scrollTo({
                    top: 0,
                    behavior: "smooth"
                });

                document.body.scrollTo({
                    top: 0,
                    behavior: "smooth"
                });

                possibleScrollContainers.forEach(function (container) {
                    if (container === window) {
                        return;
                    }

                    if (typeof container.scrollTo === "function") {
                        container.scrollTo({
                            top: 0,
                            behavior: "smooth"
                        });
                    } else {
                        container.scrollTop = 0;
                    }
                });
            });

            toggleScrollTopButton();
        }

        function bindMatchPredictionSearch() {
            const searchInput = document.getElementById("matchPredictionSearch");
            const clearButton = document.getElementById("matchPredictionClearSearch");

            if (searchInput) {
                searchInput.addEventListener("input", function () {
                    applyMatchPredictionSearch();
                });
            }

            if (clearButton) {
                clearButton.addEventListener("click", function () {
                    if (searchInput) {
                        searchInput.value = "";
                        searchInput.focus();
                    }

                    applyMatchPredictionSearch();
                });
            }
        }

        function bindMatchPredictionSort() {
            document.querySelectorAll(".match-prediction-sort-btn").forEach(function (button) {
                button.addEventListener("click", function () {
                    const field = button.getAttribute("data-sort-field");
                    const currentDirection = button.getAttribute("data-sort-direction") || "asc";
                    const nextDirection = currentDirection === "asc" ? "desc" : "asc";

                    button.setAttribute("data-sort-direction", nextDirection);

                    sortMatchPredictionRows(field, nextDirection);
                    applyMatchPredictionSearch();
                    updateMatchPredictionSortIcons(button, nextDirection);
                });
            });
        }

        function sortMatchPredictionRows(field, direction) {
            const tbody = document.getElementById("matchPredictionTableBody");

            if (!tbody || !field) {
                return;
            }

            const rows = Array.from(tbody.querySelectorAll(".match-prediction-row"));

            rows.sort(function (a, b) {
                const aValue = parseInt(a.getAttribute("data-" + field) || "0");
                const bValue = parseInt(b.getAttribute("data-" + field) || "0");

                if (direction === "asc") {
                    return aValue - bValue;
                }

                return bValue - aValue;
            });

            rows.forEach(function (row) {
                tbody.appendChild(row);
            });
        }

        function updateMatchPredictionSortIcons(activeButton, direction) {
            document.querySelectorAll(".match-prediction-sort-btn i").forEach(function (icon) {
                icon.className = "bi bi-arrow-down-up";
            });

            const activeIcon = activeButton.querySelector("i");

            if (activeIcon) {
                activeIcon.className = direction === "asc"
                    ? "bi bi-arrow-up-short"
                    : "bi bi-arrow-down-short";
            }
        }

        function applyMatchPredictionSearch() {
            const searchInput = document.getElementById("matchPredictionSearch");
            const noResult = document.getElementById("matchPredictionNoResult");

            const searchText = searchInput
                ? searchInput.value.trim().toLowerCase()
                : "";

            let visibleCount = 0;

            document.querySelectorAll(".match-prediction-row").forEach(function (row) {
                const searchable = row.getAttribute("data-search") || "";
                const shouldShow = searchText === "" || searchable.includes(searchText);

                if (shouldShow) {
                    row.classList.remove("d-none");
                    visibleCount++;
                } else {
                    row.classList.add("d-none");
                }
            });

            if (noResult) {
                if (visibleCount === 0 && document.querySelectorAll(".match-prediction-row").length > 0) {
                    noResult.classList.remove("d-none");
                } else {
                    noResult.classList.add("d-none");
                }
            }
        }
    </script>
}