@model DashboardViewModel
@using FootballPredictionGame.Models
@using FootballPredictionGame.Helpers
@using System.Text.Json

@{
    ViewData["Title"] = "Dashboard";

    var avatarPath = string.IsNullOrWhiteSpace(Model.ProfilePhotoPath)
        ? Url.Content("~/img/default-avatar.svg")
        : Url.Content("~/" + Model.ProfilePhotoPath.TrimStart('/', '~'));

    var totalFixtureCount = Model.PredictionFixtures?.Count ?? 0;

    var predictedCount = Model.PredictionFixtures?
        .Count(f => Model.UserPredictionLookup != null && Model.UserPredictionLookup.ContainsKey(f.Id)) ?? 0;

    var noPredictionCount = Model.PredictionFixtures?
        .Count(f =>
            f.Status == MatchStatus.Upcoming &&
            !f.IsProcessed &&
            DateTime.Now < f.MatchDateTime &&
            (Model.UserPredictionLookup == null || !Model.UserPredictionLookup.ContainsKey(f.Id))) ?? 0;

    var notParticipateCount = Model.PredictionFixtures?
        .Count(f =>
            (f.Status == MatchStatus.Live ||
             f.Status == MatchStatus.Finished ||
             DateTime.Now >= f.MatchDateTime) &&
            (Model.UserPredictionLookup == null || !Model.UserPredictionLookup.ContainsKey(f.Id))) ?? 0;

    var upcomingCount = Model.PredictionFixtures?.Count(f => f.Status == MatchStatus.Upcoming) ?? 0;
    var liveCount = Model.PredictionFixtures?.Count(f => f.Status == MatchStatus.Live) ?? 0;
    var finishedCount = Model.PredictionFixtures?.Count(f => f.Status == MatchStatus.Finished) ?? 0;

    var today = DateTime.Today;
    var tomorrow = today.AddDays(1);
    var dayAfterTomorrow = today.AddDays(2);

    var todaysMatchCount = Model.PredictionFixtures?
        .Count(f => f.MatchDateTime >= today && f.MatchDateTime < tomorrow) ?? 0;

    var tomorrowMatchCount = Model.PredictionFixtures?
        .Count(f => f.MatchDateTime >= tomorrow && f.MatchDateTime < dayAfterTomorrow) ?? 0;

    var segmentLabels = JsonSerializer.Serialize(Model.SegmentPoints.Select(x => x.SegmentName));
    var segmentPoints = JsonSerializer.Serialize(Model.SegmentPoints.Select(x => x.Points));
}

@functions {
    private string ToImageUrl(IUrlHelper url, string? path, string fallback)
    {
        var finalPath = string.IsNullOrWhiteSpace(path) ? fallback : path;
        return url.Content("~/" + finalPath.TrimStart('/', '~'));
    }

    private string StatusClass(MatchStatus status)
    {
        return status == MatchStatus.Live ? "status-live blink-live" :
               status == MatchStatus.Finished ? "status-finished" :
               "status-upcoming";
    }

    private string ParticipationText(bool hasPrediction, bool canPredict)
    {
        if (hasPrediction)
        {
            return "predicted";
        }

        if (canPredict)
        {
            return "noprediction";
        }

        return "notparticipated";
    }

    private string PointBadgeClass(int point)
    {
        return point == 0
            ? "text-bg-secondary"
            : point == 3
                ? "text-bg-primary"
                : "text-bg-warning";
    }
}

<style>
    .dashboard-fixture-search-toolbar {
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        gap: 8px;
        width: 100%;
    }

    .dashboard-fixture-search-box {
        position: relative;
        flex: 1 1 auto;
        min-width: 0;
    }

        .dashboard-fixture-search-box span {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            z-index: 2;
        }

        .dashboard-fixture-search-box .form-control {
            padding-left: 38px;
            min-height: 42px;
            border-radius: 12px;
            width: 100%;
        }

    .dashboard-fixture-clear-btn {
        flex: 0 0 auto;
        width: auto !important;
        border: 1px solid #fecaca;
        color: #dc2626;
        background: #ffffff;
        font-weight: 700;
        white-space: nowrap;
        min-height: 42px;
        border-radius: 12px;
        padding-left: 14px;
        padding-right: 14px;
    }

        .dashboard-fixture-clear-btn:hover,
        .dashboard-fixture-clear-btn:focus {
            color: #ffffff;
            background: #dc2626;
            border-color: #dc2626;
        }

    @@media (max-width: 767.98px) {
        .dashboard-fixture-search-toolbar {
            display: flex !important;
            flex-direction: row !important;
            align-items: center !important;
            gap: 6px !important;
            width: 100%;
        }

        .dashboard-fixture-search-box {
            flex: 1 1 auto;
            min-width: 0;
        }

            .dashboard-fixture-search-box span {
                left: 10px;
            }

            .dashboard-fixture-search-box .form-control {
                min-height: 40px;
                font-size: .86rem;
                padding-left: 34px;
            }

        .dashboard-fixture-clear-btn {
            flex: 0 0 auto;
            width: auto !important;
            min-width: 74px;
            min-height: 40px;
            padding-left: 9px;
            padding-right: 9px;
            font-size: .8rem;
        }
    }
</style>

<!-- TOP SECTION: PROFILE LEFT + BANNER RIGHT -->
<div class="row g-4 mb-4 dashboard-top-layout">

    <!-- LEFT SIDE: PROFILE + ACTIONS -->
    <div class="col-xl-4 col-lg-5">
        <div class="dashboard-card dashboard-left-panel p-3 p-md-4 h-100">

            <div class="dashboard-smart-profile-card mb-3">

                <div class="dashboard-smart-profile-main">
                    <img src="@avatarPath"
                         alt="@Model.FullName"
                         class="dashboard-smart-profile-photo" />

                    <div class="dashboard-smart-profile-info">
                        <h2>@Model.FullName</h2>

                        <div class="dashboard-smart-designation">
                            @(string.IsNullOrWhiteSpace(Model.Designation) ? "-" : Model.Designation)
                        </div>

                        <div class="dashboard-smart-department">
                            @(string.IsNullOrWhiteSpace(Model.Department) ? "-" : Model.Department)
                        </div>
                    </div>
                </div>

                <div class="dashboard-smart-highlight-row">

                    <div class="dashboard-smart-highlight-card rank-highlight">
                        <div class="highlight-icon">
                            <i class="bi bi-trophy"></i>
                        </div>

                        <div>
                            <span>Rank</span>
                            <strong>@Model.RankText</strong>
                        </div>
                    </div>

                    <div class="dashboard-smart-highlight-card point-highlight">
                        <div class="highlight-icon">
                            <i class="bi bi-star-fill"></i>
                        </div>

                        <div>
                            <span>Total Score</span>
                            <strong>@Model.TotalScore</strong>
                        </div>
                    </div>

                </div>

            </div>

            <div class="dashboard-action-row dashboard-action-row-smart mt-3">

                <a asp-controller="Leaderboard"
                   asp-action="Index"
                   class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-trophy"></i>
                    Leaderboard
                </a>

                <a asp-controller="Dashboard"
                   asp-action="Rules"
                   class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-journal-check"></i>
                    Rules
                </a>

                <a asp-controller="Dashboard"
                   asp-action="PredictionScore"
                   class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-clipboard-data"></i>
                    Prediction Score
                </a>

            </div>

        </div>
    </div>

    <!-- RIGHT SIDE: BANNER SLIDER -->
    <div class="col-xl-8 col-lg-7">
        <div class="dashboard-card p-0 h-100 overflow-hidden dashboard-banner-side-card">

            @if (Model.Banners != null && Model.Banners.Any())
            {
                <div id="dashboardBannerCarousel"
                     class="carousel slide h-100"
                     data-bs-ride="carousel"
                     data-bs-interval="4500">

                    <div class="carousel-indicators">
                        @for (int i = 0; i < Model.Banners.Count; i++)
                        {
                            <button type="button"
                                    data-bs-target="#dashboardBannerCarousel"
                                    data-bs-slide-to="@i"
                                    class="@(i == 0 ? "active" : "")"
                                    aria-current="@(i == 0 ? "true" : "false")"
                                    aria-label="Slide @(i + 1)">
                            </button>
                        }
                    </div>

                    <div class="carousel-inner h-100">
                        @for (int i = 0; i < Model.Banners.Count; i++)
                        {
                            var banner = Model.Banners[i];

                            <div class="carousel-item h-100 @(i == 0 ? "active" : "")">

                                <a href="@banner.RedirectUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="dashboard-banner-click-area">

                                    <div class="dashboard-banner-side"
                                         style="background-image:url('.@Url.Content(banner.ImageUrl)')">

                                        <div class="dashboard-banner-side-overlay">

                                            <span class="btn btn-warning btn-sm fw-bold banner-action-btn">
                                                @banner.ButtonText
                                                <i class="bi bi-arrow-right"></i>
                                            </span>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        }
                    </div>

                    <button class="carousel-control-prev"
                            type="button"
                            data-bs-target="#dashboardBannerCarousel"
                            data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>

                    <button class="carousel-control-next"
                            type="button"
                            data-bs-target="#dashboardBannerCarousel"
                            data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>

                </div>
            }
            else
            {
                <div class="empty-state m-4">
                    No banner configured.
                </div>
            }

        </div>
    </div>

</div>

<!-- FIXTURE FILTER + SEARCH -->
<div class="dashboard-card p-3 p-md-4 mb-4">

    <div class="fixture-header-compact mb-3">
        <div>
            <h2 class="h4 fw-bold mb-1">
                <i class="bi bi-calendar-check text-primary"></i>
                Fixtures & Predictions
            </h2>

            <div class="text-muted small">
                Exact score = 3 points, correct winner/result = 1 point
            </div>
        </div>
    </div>

    <div class="dashboard-fixture-filter-bar">

        <button type="button"
                class="dashboard-filter-chip filter-all active"
                data-filter="all">
            <i class="bi bi-grid"></i>
            All
            <span id="fixtureAllCount">@totalFixtureCount</span>
        </button>

        <button type="button"
                class="dashboard-filter-chip filter-upcoming"
                data-filter="Upcoming">
            <i class="bi bi-calendar-event"></i>
            Upcoming
            <span id="fixtureUpcomingCount">@upcomingCount</span>
        </button>

        <button type="button"
                class="dashboard-filter-chip filter-live"
                data-filter="Live">
            <i class="bi bi-broadcast"></i>
            Live
            <span id="fixtureLiveCount">@liveCount</span>
        </button>

        <button type="button"
                class="dashboard-filter-chip filter-finished"
                data-filter="Finished">
            <i class="bi bi-check-circle"></i>
            Finished
            <span id="fixtureFinishedCount">@finishedCount</span>
        </button>

        <button type="button"
                class="dashboard-filter-chip filter-predicted"
                data-filter="predicted">
            <i class="bi bi-check2-square"></i>
            Predicted
            <span id="fixturePredictedCount">@predictedCount</span>
        </button>

        <button type="button"
                class="dashboard-filter-chip filter-noprediction"
                data-filter="noprediction">
            <i class="bi bi-pencil"></i>
            No Prediction
            <span id="fixtureNoPredictionCount">@noPredictionCount</span>
        </button>

        <button type="button"
                class="dashboard-filter-chip filter-notparticipated"
                data-filter="notparticipated">
            <i class="bi bi-slash-circle"></i>
            Not Participated
            <span id="fixtureNotParticipatedCount">@notParticipateCount</span>
        </button>

        <button type="button"
                class="dashboard-filter-chip filter-today"
                data-filter="today">
            <i class="bi bi-calendar-day"></i>
            Today's Match
            <span>@todaysMatchCount</span>
        </button>

        <button type="button"
                class="dashboard-filter-chip filter-tomorrow"
                data-filter="tomorrow">
            <i class="bi bi-calendar2-plus"></i>
            Tomorrow's Match
            <span>@tomorrowMatchCount</span>
        </button>

    </div>

    <div class="dashboard-fixture-search-toolbar mt-3">

        <div class="dashboard-fixture-search-box">
            <span>
                <i class="bi bi-search"></i>
            </span>

            <input type="search"
                   id="dashboardFixtureSearch"
                   class="form-control"
                   placeholder="Search" />
        </div>

        <button type="button"
                class="btn dashboard-fixture-clear-btn"
                id="dashboardFixtureClearSearch">
            <i class="bi bi-x-circle"></i>
            Clear
        </button>

    </div>

</div>

<!-- FIXTURE LIST -->
<div class="dashboard-card p-3 p-md-4 mb-4">

    @if (Model.PredictionFixtures == null || !Model.PredictionFixtures.Any())
    {
        <div class="empty-state">
            No fixture found.
        </div>
    }
    else
    {
        <div class="dashboard-fixture-grid" id="dashboardFixtureGrid">

            @foreach (var fixture in Model.PredictionFixtures.OrderBy(x => x.MatchDateTime))
            {
                Prediction? prediction = null;

                var hasPrediction = Model.UserPredictionLookup != null &&
                Model.UserPredictionLookup.TryGetValue(fixture.Id, out prediction);

                var canPredict = fixture.Status == MatchStatus.Upcoming &&
                !fixture.IsProcessed &&
                DateTime.Now < fixture.MatchDateTime;

                var participation = ParticipationText(hasPrediction, canPredict);

                var teamOneFlag = ToImageUrl(Url, fixture.TeamOneFlagPath, "/img/default-flag.svg");
                var teamTwoFlag = ToImageUrl(Url, fixture.TeamTwoFlagPath, "/img/default-flag.svg");

                var actualText = fixture.TeamOneActualGoal.HasValue && fixture.TeamTwoActualGoal.HasValue
                ? $"{fixture.TeamOneActualGoal} - {fixture.TeamTwoActualGoal}"
                : "Pending";

                var fixtureDateValue = fixture.MatchDateTime.Date == today
                ? "today"
                : fixture.MatchDateTime.Date == tomorrow
                ? "tomorrow"
                : "";

                var predictionSearchText = hasPrediction && prediction != null
                ? $"{prediction.TeamOnePredictedGoal} - {prediction.TeamTwoPredictedGoal}"
                : canPredict
                ? "No Prediction"
                : "Not Participated";

                var pointSearchText = hasPrediction && prediction != null && prediction.IsProcessed
                ? prediction.EarnedPoint.ToString()
                : hasPrediction
                ? "Pending"
                : "-";

                var fixtureSearchText =
                $"{fixture.TeamOneName} {fixture.TeamTwoName} {fixture.Stage.GetDisplayName()} {fixture.Status} {predictionSearchText} {actualText} {pointSearchText} {fixture.MatchDateTime:dd MMM yyyy hh:mm tt}"
                .ToLowerInvariant();

                <div class="dashboard-fixture-card"
                     data-fixture-id="@fixture.Id"
                     data-status="@fixture.Status"
                     data-participation="@participation"
                     data-date-filter="@fixtureDateValue"
                     data-has-prediction="@(hasPrediction ? "true" : "false")"
                     data-can-predict="@(canPredict ? "true" : "false")"
                     data-search="@fixtureSearchText">

                    <div class="fixture-card-top">
                        <span class="dashboard-stage-pill">
                            @fixture.Stage.GetDisplayName()
                        </span>

                        <span class="fixture-status @StatusClass(fixture.Status)">
                            @fixture.Status
                        </span>
                    </div>

                    <div class="fixture-card-time">
                        <i class="bi bi-calendar-event"></i>
                        @fixture.MatchDateTime.ToString("dd MMM yyyy, hh:mm tt")
                    </div>

                    <div class="fixture-card-teams">
                        <div class="fixture-team">
                            <img src="@teamOneFlag" alt="@fixture.TeamOneName" />
                            <span>@fixture.TeamOneName</span>
                        </div>

                        <div class="fixture-vs">VS</div>

                        <div class="fixture-team">
                            <img src="@teamTwoFlag" alt="@fixture.TeamTwoName" />
                            <span>@fixture.TeamTwoName</span>
                        </div>
                    </div>

                    <div class="fixture-mini-info fixture-mini-info-smart">

                        <div class="mini-info-item prediction-info">
                            <div class="mini-info-label">
                                <i class="bi bi-pencil-square"></i>
                                <span>Prediction</span>
                            </div>

                            <strong>
                                @if (hasPrediction && prediction != null)
                                {
                                    <span class="prediction-text-success">
                                        @prediction.TeamOnePredictedGoal - @prediction.TeamTwoPredictedGoal
                                    </span>
                                }
                                else if (canPredict)
                                {
                                    <span class="prediction-text-danger">
                                        No Prediction
                                    </span>
                                }
                                else
                                {
                                    <span class="prediction-text-muted">
                                        Not Participated
                                    </span>
                                }
                            </strong>
                        </div>

                        <div class="mini-info-item actual-info">
                            <div class="mini-info-label">
                                <i class="bi bi-bullseye"></i>
                                <span>Actual</span>
                            </div>

                            <strong>@actualText</strong>
                        </div>

                        <div class="mini-info-item point-info">
                            <div class="mini-info-label">
                                <i class="bi bi-star-fill"></i>
                                <span>Point</span>
                            </div>

                            <strong>
                                @if (hasPrediction && prediction != null && prediction.IsProcessed)
                                {
                                    <span class="badge @PointBadgeClass(prediction.EarnedPoint)">
                                        @prediction.EarnedPoint
                                    </span>
                                }
                                else if (hasPrediction && prediction != null)
                                {
                                    <span class="badge text-bg-secondary">
                                        Pending
                                    </span>
                                }
                                else
                                {
                                    <span class="badge text-bg-light text-muted">
                                        -
                                    </span>
                                }
                            </strong>
                        </div>

                    </div>

                    <div class="fixture-card-action">
                        @if (canPredict)
                        {
                            <form class="dashboard-prediction-form"
                                  asp-controller="Dashboard"
                                  asp-action="SavePredictionAjax"
                                  method="post"
                                  data-fixture-id="@fixture.Id"
                                  data-was-predicted="@(hasPrediction ? "true" : "false")">

                                @Html.AntiForgeryToken()

                                <input type="hidden" name="fixtureId" value="@fixture.Id" />

                                <div class="row g-2 align-items-end">
                                    <div class="col-5">
                                        <input type="number"
                                               min="0"
                                               max="99"
                                               name="teamOneGoal"
                                               class="form-control prediction-input prediction-input-sm"
                                               value="@(hasPrediction && prediction != null ? prediction.TeamOnePredictedGoal : 0)"
                                               required />
                                    </div>

                                    <div class="col-2 text-center pb-2 fw-bold">-</div>

                                    <div class="col-5">
                                        <input type="number"
                                               min="0"
                                               max="99"
                                               name="teamTwoGoal"
                                               class="form-control prediction-input prediction-input-sm"
                                               value="@(hasPrediction && prediction != null ? prediction.TeamTwoPredictedGoal : 0)"
                                               required />
                                    </div>
                                </div>

                                <button type="submit"
                                        class="btn btn-@(hasPrediction ? "primary" : "warning") w-100 mt-2 fw-bold dashboard-prediction-save-btn">
                                    <i class="bi @(hasPrediction ? "bi-pencil-square" : "bi-send")"></i>
                                    @(hasPrediction ? "Update Prediction" : "Submit Prediction")
                                </button>
                            </form>
                        }
                        else if (fixture.Status == MatchStatus.Live ||
                        fixture.Status == MatchStatus.Finished ||
                        DateTime.Now >= fixture.MatchDateTime)
                        {
                            <a asp-controller="Dashboard"
                               asp-action="PredictionDetail"
                               asp-route-fixtureId="@fixture.Id"
                               class="btn btn-outline-primary w-100">
                                <i class="bi bi-list-check"></i>
                                Match Predictions
                            </a>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-secondary w-100"
                                    disabled>
                                <i class="bi bi-lock-fill"></i>
                                Locked
                            </button>
                        }
                    </div>

                </div>
            }

        </div>

        <div id="dashboardFixtureNoResult" class="empty-state mt-3 d-none">
            No fixture matched your search/filter.
        </div>
    }

</div>

<div id="dashboardAjaxToast" class="custom-toast d-none">
    <div class="custom-toast-icon">
        <i id="dashboardAjaxToastIcon" class="bi bi-check-circle-fill"></i>
    </div>

    <div id="dashboardAjaxToastMessage" class="custom-toast-message">
        Prediction saved successfully.
    </div>

    <button type="button" class="custom-toast-close" onclick="hideDashboardAjaxToast()">
        <i class="bi bi-x-lg"></i>
    </button>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const labels = @Html.Raw(segmentLabels);
        const points = @Html.Raw(segmentPoints);

        if (document.getElementById('segmentChart') && labels.length > 0) {
            new Chart(document.getElementById('segmentChart'), {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Points',
                            data: points
                        }
                    ]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0
                            }
                        }
                    }
                }
            });
        }

        let activeDashboardFixtureFilter = "all";

        document.addEventListener("DOMContentLoaded", function () {
            bindDashboardFixtureFilters();
            bindDashboardFixtureSearch();
            bindDashboardPredictionAjaxForms();
            applyDashboardFixtureSearchAndFilter();
        });

        function bindDashboardFixtureFilters() {
            document.querySelectorAll(".dashboard-filter-chip").forEach(function (button) {
                button.addEventListener("click", function (e) {
                    const filter = button.getAttribute("data-filter");

                    if (!filter) {
                        return;
                    }

                    e.preventDefault();

                    activeDashboardFixtureFilter = filter;

                    document.querySelectorAll(".dashboard-filter-chip").forEach(function (btn) {
                        btn.classList.remove("active");
                    });

                    button.classList.add("active");

                    applyDashboardFixtureSearchAndFilter();
                });
            });
        }

        function bindDashboardFixtureSearch() {
            const searchInput = document.getElementById("dashboardFixtureSearch");
            const clearButton = document.getElementById("dashboardFixtureClearSearch");

            if (searchInput) {
                searchInput.addEventListener("input", function () {
                    applyDashboardFixtureSearchAndFilter();
                });
            }

            if (clearButton) {
                clearButton.addEventListener("click", function () {
                    if (searchInput) {
                        searchInput.value = "";
                        searchInput.focus();
                    }

                    applyDashboardFixtureSearchAndFilter();
                });
            }
        }

        function applyDashboardFixtureSearchAndFilter() {
            const searchInput = document.getElementById("dashboardFixtureSearch");
            const noResult = document.getElementById("dashboardFixtureNoResult");

            const searchText = searchInput
                ? searchInput.value.trim().toLowerCase()
                : "";

            let visibleCount = 0;

            document.querySelectorAll(".dashboard-fixture-card").forEach(function (card) {
                const status = card.getAttribute("data-status");
                const participation = card.getAttribute("data-participation");
                const dateFilter = card.getAttribute("data-date-filter");
                const searchable = card.getAttribute("data-search") || "";

                let matchesFilter = false;

                if (activeDashboardFixtureFilter === "all") {
                    matchesFilter = true;
                } else if (
                    activeDashboardFixtureFilter === "Upcoming" ||
                    activeDashboardFixtureFilter === "Live" ||
                    activeDashboardFixtureFilter === "Finished"
                ) {
                    matchesFilter = status === activeDashboardFixtureFilter;
                } else if (
                    activeDashboardFixtureFilter === "predicted" ||
                    activeDashboardFixtureFilter === "noprediction" ||
                    activeDashboardFixtureFilter === "notparticipated"
                ) {
                    matchesFilter = participation === activeDashboardFixtureFilter;
                } else if (
                    activeDashboardFixtureFilter === "today" ||
                    activeDashboardFixtureFilter === "tomorrow"
                ) {
                    matchesFilter = dateFilter === activeDashboardFixtureFilter;
                }

                const matchesSearch = searchText === "" || searchable.includes(searchText);
                const shouldShow = matchesFilter && matchesSearch;

                if (shouldShow) {
                    card.classList.remove("d-none");
                    visibleCount++;
                } else {
                    card.classList.add("d-none");
                }
            });

            if (noResult) {
                if (visibleCount === 0 && document.querySelectorAll(".dashboard-fixture-card").length > 0) {
                    noResult.classList.remove("d-none");
                } else {
                    noResult.classList.add("d-none");
                }
            }
        }

        function bindDashboardPredictionAjaxForms() {
            document.querySelectorAll(".dashboard-prediction-form").forEach(function (form) {
                form.addEventListener("submit", function (e) {
                    e.preventDefault();
                    submitDashboardPrediction(form);
                });
            });
        }

        async function submitDashboardPrediction(form) {
            const fixtureId = form.getAttribute("data-fixture-id");
            const card = document.querySelector('.dashboard-fixture-card[data-fixture-id="' + fixtureId + '"]');
            const saveBtn = form.querySelector(".dashboard-prediction-save-btn");

            const teamOneInput = form.querySelector('input[name="teamOneGoal"]');
            const teamTwoInput = form.querySelector('input[name="teamTwoGoal"]');

            if (!teamOneInput || !teamTwoInput) {
                showDashboardAjaxToast("Prediction input not found.", "error");
                return;
            }

            if (teamOneInput.value === "" || teamTwoInput.value === "") {
                showDashboardAjaxToast("Please enter both team goals.", "error");
                return;
            }

            const teamOneGoal = parseInt(teamOneInput.value);
            const teamTwoGoal = parseInt(teamTwoInput.value);

            if (teamOneGoal < 0 || teamTwoGoal < 0 || teamOneGoal > 99 || teamTwoGoal > 99) {
                showDashboardAjaxToast("Goal value must be between 0 and 99.", "error");
                return;
            }

            const tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : "";
            const formData = new FormData(form);

            if (saveBtn) {
                saveBtn.disabled = true;
                saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Saving...';
            }

            try {
                const response = await fetch(form.action, {
                    method: "POST",
                    body: formData,
                    headers: {
                        "RequestVerificationToken": token,
                        "X-Requested-With": "XMLHttpRequest"
                    }
                });

                const contentType = response.headers.get("content-type") || "";

                if (!response.ok) {
                    throw new Error("Server returned " + response.status);
                }

                if (!contentType.includes("application/json")) {
                    throw new Error("Server did not return JSON. Please check login/session.");
                }

                const data = await response.json();

                if (!data.success) {
                    showDashboardAjaxToast(data.message || "Prediction could not be saved.", "error");
                    resetDashboardPredictionButton(saveBtn, form);
                    return;
                }

                updateDashboardPredictionCard(card, form, data);
                showDashboardAjaxToast(data.message || "Prediction saved successfully.", "success");
            }
            catch (error) {
                console.error(error);
                showDashboardAjaxToast("Unexpected error occurred. Please try again.", "error");
                resetDashboardPredictionButton(saveBtn, form);
            }
        }

        function updateDashboardPredictionCard(card, form, data) {
            const predictionCell = card ? card.querySelector(".prediction-info strong") : null;
            const pointCell = card ? card.querySelector(".point-info strong") : null;
            const saveBtn = form.querySelector(".dashboard-prediction-save-btn");

            const wasPredictedBefore = form.getAttribute("data-was-predicted") === "true";

            if (predictionCell) {
                predictionCell.innerHTML =
                    '<span class="prediction-text-success">' + escapeDashboardHtml(data.predictionText) + '</span>';
            }

            if (pointCell) {
                pointCell.innerHTML =
                    '<span class="badge text-bg-secondary">' + escapeDashboardHtml(data.pointText || "Pending") + '</span>';
            }

            if (saveBtn) {
                saveBtn.disabled = false;
                saveBtn.classList.remove("btn-warning", "btn-secondary");
                saveBtn.classList.add("btn-primary");
                saveBtn.innerHTML = '<i class="bi bi-pencil-square"></i> Update Prediction';
            }

            form.setAttribute("data-was-predicted", "true");

            if (card) {
                card.setAttribute("data-has-prediction", "true");
                card.setAttribute("data-participation", "predicted");

                const oldSearch = card.getAttribute("data-search") || "";
                const updatedSearch = oldSearch + " " + String(data.predictionText || "").toLowerCase() + " pending predicted";
                card.setAttribute("data-search", updatedSearch);

                card.classList.add("prediction-row-updated");

                setTimeout(function () {
                    card.classList.remove("prediction-row-updated");
                }, 1600);

                applyDashboardFixtureSearchAndFilter();
            }

            if (!wasPredictedBefore && data.wasNewPrediction) {
                incrementDashboardCounter("fixturePredictedCount", 1);
                incrementDashboardCounter("fixtureNoPredictionCount", -1);
            }
        }

        function resetDashboardPredictionButton(saveBtn, form) {
            if (!saveBtn) {
                return;
            }

            const wasPredicted = form.getAttribute("data-was-predicted") === "true";

            saveBtn.disabled = false;

            if (wasPredicted) {
                saveBtn.classList.remove("btn-warning");
                saveBtn.classList.add("btn-primary");
                saveBtn.innerHTML = '<i class="bi bi-pencil-square"></i> Update Prediction';
            } else {
                saveBtn.classList.remove("btn-primary");
                saveBtn.classList.add("btn-warning");
                saveBtn.innerHTML = '<i class="bi bi-send"></i> Submit Prediction';
            }
        }

        function incrementDashboardCounter(id, amount) {
            const element = document.getElementById(id);

            if (!element) {
                return;
            }

            const currentValue = parseInt(element.innerText || "0");
            const nextValue = Math.max(currentValue + amount, 0);

            element.innerText = nextValue;
        }

        function showDashboardAjaxToast(message, type) {
            const toast = document.getElementById("dashboardAjaxToast");
            const toastMessage = document.getElementById("dashboardAjaxToastMessage");
            const toastIcon = document.getElementById("dashboardAjaxToastIcon");

            if (!toast || !toastMessage) {
                return;
            }

            toastMessage.innerText = message;

            toast.classList.remove("success", "error", "d-none", "show");
            toast.classList.add(type === "error" ? "error" : "success");

            if (toastIcon) {
                toastIcon.className = type === "error"
                    ? "bi bi-x-circle-fill"
                    : "bi bi-check-circle-fill";
            }

            setTimeout(function () {
                toast.classList.add("show");
            }, 20);

            setTimeout(function () {
                hideDashboardAjaxToast();
            }, 2200);
        }

        function hideDashboardAjaxToast() {
            const toast = document.getElementById("dashboardAjaxToast");

            if (!toast) {
                return;
            }

            toast.classList.remove("show");

            setTimeout(function () {
                toast.classList.add("d-none");
            }, 250);
        }

        function escapeDashboardHtml(value) {
            return String(value)
                .replace(/&/g, "&amp;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;");
        }
    </script>
}