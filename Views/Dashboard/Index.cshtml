@model DashboardViewModel
@using FootballPredictionGame.Models
@using FootballPredictionGame.Helpers
@using System.Text.Json

@{
    ViewData["Title"] = "Dashboard";

    var avatarPath = string.IsNullOrWhiteSpace(Model.ProfilePhotoPath)
        ? Url.Content("~/img/default-avatar.svg")
        : Url.Content("~/" + Model.ProfilePhotoPath.TrimStart('/', '~'));

    var totalFixtureCount = Model.PredictionFixtures?.Count ?? 0;

    var predictedCount = Model.PredictionFixtures?
        .Count(f => Model.UserPredictionLookup != null && Model.UserPredictionLookup.ContainsKey(f.Id)) ?? 0;

    var noPredictionCount = Model.PredictionFixtures?
        .Count(f =>
            f.Status == MatchStatus.Upcoming &&
            !f.IsProcessed &&
            DateTime.Now < f.MatchDateTime &&
            (Model.UserPredictionLookup == null || !Model.UserPredictionLookup.ContainsKey(f.Id))) ?? 0;

    var notParticipateCount = Model.PredictionFixtures?
        .Count(f =>
            (f.Status == MatchStatus.Live ||
             f.Status == MatchStatus.Finished ||
             DateTime.Now >= f.MatchDateTime) &&
            (Model.UserPredictionLookup == null || !Model.UserPredictionLookup.ContainsKey(f.Id))) ?? 0;

    var upcomingCount = Model.PredictionFixtures?.Count(f => f.Status == MatchStatus.Upcoming) ?? 0;
    var liveCount = Model.PredictionFixtures?.Count(f => f.Status == MatchStatus.Live) ?? 0;
    var finishedCount = Model.PredictionFixtures?.Count(f => f.Status == MatchStatus.Finished) ?? 0;

    var today = DateTime.Today;
    var tomorrow = today.AddDays(1);
    var dayAfterTomorrow = today.AddDays(2);

    var todaysMatchCount = Model.PredictionFixtures?
        .Count(f => f.MatchDateTime >= today && f.MatchDateTime < tomorrow) ?? 0;

    var tomorrowMatchCount = Model.PredictionFixtures?
        .Count(f => f.MatchDateTime >= tomorrow && f.MatchDateTime < dayAfterTomorrow) ?? 0;

    var segmentLabels = JsonSerializer.Serialize(Model.SegmentPoints.Select(x => x.SegmentName));
    var segmentPoints = JsonSerializer.Serialize(Model.SegmentPoints.Select(x => x.Points));
}

@functions {
    private string ToImageUrl(IUrlHelper url, string? path, string fallback)
    {
        var finalPath = string.IsNullOrWhiteSpace(path) ? fallback : path;
        return url.Content("~/" + finalPath.TrimStart('/', '~'));
    }

    private string StatusClass(MatchStatus status)
    {
        return status == MatchStatus.Live ? "status-live blink-live" :
               status == MatchStatus.Finished ? "status-finished" :
               "status-upcoming";
    }

    private string ParticipationText(bool hasPrediction, bool canPredict)
    {
        if (hasPrediction)
        {
            return "predicted";
        }

        if (canPredict)
        {
            return "noprediction";
        }

        return "notparticipated";
    }
}

<!-- DASHBOARD SUMMARY -->
<!-- TOP SECTION: PROFILE LEFT + BANNER RIGHT -->
<div class="row g-4 mb-4 dashboard-top-layout">

    <!-- LEFT SIDE: PROFILE + STATS -->
    <div class="col-xl-4 col-lg-5">
        <div class="dashboard-card dashboard-left-panel p-3 p-md-4 h-100">

            <div class="dashboard-profile-compact mb-3">
                <img src="@avatarPath"
                     alt="@Model.FullName"
                     class="dashboard-profile-photo-compact" />

                <div class="dashboard-profile-info-compact">
                    <h2 class="h5 fw-bold mb-1">@Model.FullName</h2>

                    <div class="dashboard-mini-meta">
                        <span>
                            Rank:
                            <strong>@Model.RankText</strong>
                        </span>

                        <span>
                            Top Score:
                            <strong>@Model.TopScore</strong>
                        </span>

                        <span class="total-point-smart">
                            Total Point:
                            <strong>@Model.TotalScore</strong>
                        </span>
                    </div>
                </div>
            </div>

            <div class="dashboard-quick-stats dashboard-quick-stats-left">

                <button type="button"
                        class="dashboard-stat-tile stat-noprediction"
                        data-filter="noprediction">
                    <strong id="dashboardNoPredictionCount">@noPredictionCount</strong>
                    <span>Pending Prediction</span>
                </button>

                <button type="button"
                        class="dashboard-stat-tile stat-predicted"
                        data-filter="predicted">
                    <strong id="dashboardPredictedCount">@predictedCount</strong>
                    <span>Predicted</span>
                </button>

                <button type="button"
                        class="dashboard-stat-tile stat-notparticipated"
                        data-filter="notparticipated">
                    <strong id="dashboardNotParticipateCount">@notParticipateCount</strong>
                    <span>Not Participate</span>
                </button>

                <button type="button"
                        class="dashboard-stat-tile stat-finished"
                        data-filter="Finished">
                    <strong>@finishedCount</strong>
                    <span>Finished</span>
                </button>

                <button type="button"
                        class="dashboard-stat-tile stat-today"
                        data-filter="today">
                    <strong>@todaysMatchCount</strong>
                    <span>Today's Match</span>
                </button>

                <button type="button"
                        class="dashboard-stat-tile stat-tomorrow"
                        data-filter="tomorrow">
                    <strong>@tomorrowMatchCount</strong>
                    <span>Tomorrow's Match</span>
                </button>

            </div>

            <div class="dashboard-action-row mt-3">

                <a asp-controller="Leaderboard"
                   asp-action="Index"
                   class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-trophy"></i>
                    Leaderboard
                </a>

                <a asp-controller="Account"
                   asp-action="Profile"
                   class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-person"></i>
                    Profile
                </a>

                <a asp-controller="Dashboard"
                   asp-action="Rules"
                   class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-journal-check"></i>
                    Rules
                </a>

                <a asp-controller="Dashboard"
                   asp-action="PredictionScore"
                   class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-grid-1x2"></i>
                    Prediction Score
                </a>

            </div>

        </div>
    </div>

    <!-- RIGHT SIDE: BANNER SLIDER -->
    <div class="col-xl-8 col-lg-7">
        <div class="dashboard-card p-0 h-100 overflow-hidden dashboard-banner-side-card">

            @if (Model.Banners != null && Model.Banners.Any())
            {
                <div id="dashboardBannerCarousel"
                     class="carousel slide h-100"
                     data-bs-ride="carousel"
                     data-bs-interval="4500">

                    <div class="carousel-indicators">
                        @for (int i = 0; i < Model.Banners.Count; i++)
                        {
                            <button type="button"
                                    data-bs-target="#dashboardBannerCarousel"
                                    data-bs-slide-to="@i"
                                    class="@(i == 0 ? "active" : "")"
                                    aria-current="@(i == 0 ? "true" : "false")"
                                    aria-label="Slide @(i + 1)">
                            </button>
                        }
                    </div>

                    <div class="carousel-inner h-100">
                        @for (int i = 0; i < Model.Banners.Count; i++)
                        {
                            var banner = Model.Banners[i];

                            <div class="carousel-item h-100 @(i == 0 ? "active" : "")">
                                <div class="dashboard-banner-side"
                                     style="background-image:url('.@Url.Content(banner.ImageUrl)')">

                                    <div class="dashboard-banner-side-overlay">
                                        @* <span class="banner-badge">
                                            <i class="bi bi-stars"></i>
                                            Transtec 360°
                                        </span>

                                        <h2>@banner.Title</h2>

                                        <p>@banner.Subtitle</p> *@
                                        <h2></h2><p></p>
                                        <a href="@banner.RedirectUrl"
                                           target="_blank"
                                           class="btn btn-warning btn-sm fw-bold banner-action-btn">
                                            @banner.ButtonText
                                            <i class="bi bi-arrow-right"></i>
                                        </a>
                                    </div>

                                </div>
                            </div>
                        }
                    </div>

                    <button class="carousel-control-prev"
                            type="button"
                            data-bs-target="#dashboardBannerCarousel"
                            data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>

                    <button class="carousel-control-next"
                            type="button"
                            data-bs-target="#dashboardBannerCarousel"
                            data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>

                </div>
            }
            else
            {
                <div class="empty-state m-4">
                    No banner configured.
                </div>
            }

        </div>
    </div>

</div>

<!-- FIXTURE FILTER BAR -->
<div class="dashboard-card p-3 p-md-4 mb-4">

    <div class="fixture-header-compact mb-3">
        <div>
            <h2 class="h4 fw-bold mb-1">
                <i class="bi bi-calendar-check text-primary"></i>
                Fixtures & Predictions
            </h2>

            <div class="text-muted small">
                Exact score = 3 points, correct winner/result = 1 point
            </div>
        </div>
    </div>

    <div class="dashboard-fixture-filter-bar">

        <button type="button"
                class="dashboard-filter-chip filter-all active"
                data-filter="all">
            <i class="bi bi-grid"></i>
            All
            <span id="fixtureAllCount">@totalFixtureCount</span>
        </button>

        <button type="button"
                class="dashboard-filter-chip filter-upcoming"
                data-filter="Upcoming">
            <i class="bi bi-calendar-event"></i>
            Upcoming
            <span id="fixtureUpcomingCount">@upcomingCount</span>
        </button>

        <button type="button"
                class="dashboard-filter-chip filter-live"
                data-filter="Live">
            <i class="bi bi-broadcast"></i>
            Live
            <span id="fixtureLiveCount">@liveCount</span>
        </button>

        <button type="button"
                class="dashboard-filter-chip filter-finished"
                data-filter="Finished">
            <i class="bi bi-check-circle"></i>
            Finished
            <span id="fixtureFinishedCount">@finishedCount</span>
        </button>

        <button type="button"
                class="dashboard-filter-chip filter-predicted"
                data-filter="predicted">
            <i class="bi bi-check2-square"></i>
            Predicted
            <span id="fixturePredictedCount">@predictedCount</span>
        </button>

        <button type="button"
                class="dashboard-filter-chip filter-noprediction"
                data-filter="noprediction">
            <i class="bi bi-pencil"></i>
            No Prediction
            <span id="fixtureNoPredictionCount">@noPredictionCount</span>
        </button>

        <button type="button"
                class="dashboard-filter-chip filter-notparticipated"
                data-filter="notparticipated">
            <i class="bi bi-slash-circle"></i>
            Not Participated
            <span id="fixtureNotParticipatedCount">@notParticipateCount</span>
        </button>

    </div>

</div>

<!-- FIXTURE LIST -->
<div class="dashboard-card p-3 p-md-4 mb-4">

    @if (Model.PredictionFixtures == null || !Model.PredictionFixtures.Any())
    {
        <div class="empty-state">
            No fixture found.
        </div>
    }
    else
    {
        <div class="dashboard-fixture-grid" id="dashboardFixtureGrid">

            @foreach (var fixture in Model.PredictionFixtures.OrderBy(x => x.MatchDateTime))
            {
                Prediction? prediction = null;

                var hasPrediction = Model.UserPredictionLookup != null &&
                                    Model.UserPredictionLookup.TryGetValue(fixture.Id, out prediction);

                var canPredict = fixture.Status == MatchStatus.Upcoming &&
                                 !fixture.IsProcessed &&
                                 DateTime.Now < fixture.MatchDateTime;

                var participation = ParticipationText(hasPrediction, canPredict);

                var teamOneFlag = ToImageUrl(Url, fixture.TeamOneFlagPath, "/img/default-flag.svg");
                var teamTwoFlag = ToImageUrl(Url, fixture.TeamTwoFlagPath, "/img/default-flag.svg");

                var actualText = fixture.TeamOneActualGoal.HasValue && fixture.TeamTwoActualGoal.HasValue
                    ? $"{fixture.TeamOneActualGoal} - {fixture.TeamTwoActualGoal}"
                    : "Pending";

                var fixtureDateValue = fixture.MatchDateTime.Date == today
                    ? "today"
                    : fixture.MatchDateTime.Date == tomorrow
                        ? "tomorrow"
                        : "";

                <div class="dashboard-fixture-card"
                     data-fixture-id="@fixture.Id"
                     data-status="@fixture.Status"
                     data-participation="@participation"
                     data-date-filter="@fixtureDateValue"
                     data-has-prediction="@(hasPrediction ? "true" : "false")"
                     data-can-predict="@(canPredict ? "true" : "false")">

                    <div class="fixture-card-top">
                        <span class="segment-chip">
                            @fixture.Stage.GetDisplayName()
                        </span>

                        <span class="fixture-status @StatusClass(fixture.Status)">
                            @fixture.Status
                        </span>
                    </div>

                    <div class="fixture-card-time">
                        <i class="bi bi-calendar-event"></i>
                        @fixture.MatchDateTime.ToString("dd MMM yyyy, hh:mm tt")
                    </div>

                    <div class="fixture-card-teams">
                        <div class="fixture-team">
                            <img src="@teamOneFlag" alt="@fixture.TeamOneName" />
                            <span>@fixture.TeamOneName</span>
                        </div>

                        <div class="fixture-vs">VS</div>

                        <div class="fixture-team">
                            <img src="@teamTwoFlag" alt="@fixture.TeamTwoName" />
                            <span>@fixture.TeamTwoName</span>
                        </div>
                    </div>

                    <div class="fixture-mini-info">
                        <div class="mini-info-item prediction-info">
                            <span>Prediction</span>

                            <strong>
                                @if (hasPrediction && prediction != null)
                                {
                                    <span class="prediction-text-success">
                                        @prediction.TeamOnePredictedGoal - @prediction.TeamTwoPredictedGoal
                                    </span>
                                }
                                else if (canPredict)
                                {
                                    <span class="prediction-text-danger">
                                        No Prediction
                                    </span>
                                }
                                else
                                {
                                    <span class="prediction-text-muted">
                                        Not Participated
                                    </span>
                                }
                            </strong>
                        </div>

                        <div class="mini-info-item actual-info">
                            <span>Actual</span>
                            <strong>@actualText</strong>
                        </div>

                        <div class="mini-info-item point-info">
                            <span>Point</span>

                            <strong>
                                @if (hasPrediction && prediction != null && prediction.IsProcessed)
                                {
                                    <span class="badge text-bg-warning">
                                        @prediction.EarnedPoint
                                    </span>
                                }
                                else if (hasPrediction && prediction != null)
                                {
                                    <span class="badge text-bg-secondary">
                                        Pending
                                    </span>
                                }
                                else
                                {
                                    <span class="badge text-bg-light text-muted">
                                        -
                                    </span>
                                }
                            </strong>
                        </div>
                    </div>

                    <div class="fixture-card-action">
                        @if (canPredict)
                        {
                            <form asp-controller="Prediction" asp-action="Save" method="post">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="fixtureId" value="@fixture.Id" />

                                <div class="row g-2 align-items-end">
                                    <div class="col-5">
                                        <input type="number"
                                               min="0"
                                               max="99"
                                               name="teamOneGoal"
                                               class="form-control prediction-input prediction-input-sm"
                                               value="@(hasPrediction && prediction != null ? prediction.TeamOnePredictedGoal : 0)" />
                                    </div>

                                    <div class="col-2 text-center pb-2 fw-bold">-</div>

                                    <div class="col-5">
                                        <input type="number"
                                               min="0"
                                               max="99"
                                               name="teamTwoGoal"
                                               class="form-control prediction-input prediction-input-sm"
                                               value="@(hasPrediction && prediction != null ? prediction.TeamTwoPredictedGoal : 0)" />
                                    </div>
                                </div>

                                <button type="submit"
                                        class="btn btn-@(hasPrediction ? "primary" : "warning") w-100 mt-2 fw-bold">
                                    <i class="bi bi-send"></i>
                                    @(hasPrediction ? "Update Prediction" : "Submit Prediction")
                                </button>
                            </form>
                        }
                        else if (fixture.Status == MatchStatus.Live || fixture.Status == MatchStatus.Finished)
                        {
                            <a asp-controller="Dashboard"
                               asp-action="PredictionDetail"
                               asp-route-fixtureId="@fixture.Id"
                               class="btn btn-outline-primary w-100">
                                <i class="bi bi-list-check"></i>
                                Prediction Detail
                            </a>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-secondary w-100"
                                    disabled>
                                <i class="bi bi-lock-fill"></i>
                                Locked
                            </button>
                        }
                    </div>

                </div>
            }

        </div>
    }

</div>

@if (Model.SegmentPoints.Any())
{
    <div class="dashboard-card p-4 mb-4 chart-box">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <span class="pill">
                    <i class="bi bi-bar-chart"></i>
                    Segment Performance
                </span>

                <h2 class="h4 fw-bold mt-2 mb-0">
                    Points by Group / Knockout Segment
                </h2>
            </div>
        </div>

        <canvas id="segmentChart" height="100"></canvas>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const labels = @Html.Raw(segmentLabels);
        const points = @Html.Raw(segmentPoints);

        if (document.getElementById('segmentChart') && labels.length > 0) {
            new Chart(document.getElementById('segmentChart'), {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Points',
                            data: points
                        }
                    ]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0
                            }
                        }
                    }
                }
            });
        }

        document.addEventListener("DOMContentLoaded", function () {
            bindDashboardFixtureFilters();
        });

        function bindDashboardFixtureFilters() {
            document.querySelectorAll(".dashboard-filter-chip, .dashboard-stat-tile").forEach(function (button) {
                button.addEventListener("click", function (e) {
                    const filter = button.getAttribute("data-filter");

                    if (!filter) {
                        return;
                    }

                    e.preventDefault();

                    document.querySelectorAll(".dashboard-filter-chip").forEach(function (btn) {
                        btn.classList.remove("active");
                    });

                    const matchingButton = document.querySelector('.dashboard-filter-chip[data-filter="' + filter + '"]');

                    if (matchingButton) {
                        matchingButton.classList.add("active");
                    }

                    filterDashboardFixtures(filter);
                });
            });
        }

        function filterDashboardFixtures(filter) {
            document.querySelectorAll(".dashboard-fixture-card").forEach(function (card) {
                const status = card.getAttribute("data-status");
                const participation = card.getAttribute("data-participation");
                const dateFilter = card.getAttribute("data-date-filter");

                let shouldShow = false;

                if (filter === "all") {
                    shouldShow = true;
                } else if (filter === "Upcoming" || filter === "Live" || filter === "Finished") {
                    shouldShow = status === filter;
                } else if (filter === "predicted" || filter === "noprediction" || filter === "notparticipated") {
                    shouldShow = participation === filter;
                } else if (filter === "today" || filter === "tomorrow") {
                    shouldShow = dateFilter === filter;
                }

                if (shouldShow) {
                    card.classList.remove("d-none");
                } else {
                    card.classList.add("d-none");
                }
            });
        }
    </script>
}