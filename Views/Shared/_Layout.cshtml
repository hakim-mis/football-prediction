@using Microsoft.AspNetCore.Identity
@using FootballPredictionGame.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Football Prediction</title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>        
        .brand-ball {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .brand-logo {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }
        </style>
</head>
<body>
    @if (!(ViewData["HideNavbar"] as bool? ?? false))
    {
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top app-navbar">
        <div class="container-fluid px-lg-4">
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand-ball">
                    <img src="~/img/football_logo.png" alt="Transtec 360 Logo" class="brand-logo" />
                </span>
                Transtec 360° Football
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Admin</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Users" asp-action="Index"><i class="bi bi-people"></i> Users</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Fixtures" asp-action="Index"><i class="bi bi-calendar-event"></i> Fixtures</a></li>
             @*                <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Users" asp-action="Index"><i class="bi bi-person-check"></i> Approve Users</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Fixtures" asp-action="Create"><i class="bi bi-plus-circle"></i> Add Fixture</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Fixtures" asp-action="Index"><i class="bi bi-gear"></i> Process Results</a></li> *@
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2"></i> Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Dashboard" asp-action="PredictionScore"><i class="bi bi-grid-1x2"></i> Prediction & Score</a></li>
                        }
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Leaderboard" asp-action="Index"><i class="bi bi-trophy"></i> Leaderboard</a></li>
                    }
                </ul>
                <div class="d-flex align-items-center gap-2">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        var currentUser = await UserManager.GetUserAsync(User);
                        <a class="btn btn-outline-light btn-sm" asp-area="" asp-controller="Account" asp-action="Profile">
                            <i class="bi bi-person-circle"></i> @(currentUser?.FullName ?? "Profile")
                        </a>
                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-warning btn-sm"><i class="bi bi-box-arrow-right"></i> Logout</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-outline-light btn-sm" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
                        <a class="btn btn-warning btn-sm" asp-area="" asp-controller="Account" asp-action="Register">Sign Up</a>
                    }
                </div>
            </div>
        </div>
    </nav>
    }
    <main class="container-fluid px-lg-4 py-4">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="text-center text-white-50 small py-4">
        <span>Transtec 360&deg; Football Prediction System</span>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
