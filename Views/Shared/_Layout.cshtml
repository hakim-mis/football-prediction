@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using FootballPredictionGame.Data
@using FootballPredictionGame.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext

@{
    var hideNavbar = ViewData["HideNavbar"] as bool? ?? false;

    AutomationSettings? portalSettings = null;

    if (!hideNavbar)
    {
        portalSettings = await DbContext.AutomationSettings
            .AsNoTracking()
            .OrderBy(x => x.Id)
            .FirstOrDefaultAsync();
    }

    var showWhatsAppButton =
        portalSettings != null &&
        portalSettings.ShowWhatsAppJoinMenu &&
        !string.IsNullOrWhiteSpace(portalSettings.WhatsAppGroupUrl);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Football Prediction</title>

    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        .brand-ball {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .brand-logo {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .whatsapp-nav-link {
            color: #25D366 !important;
            font-weight: 700;
        }

            .whatsapp-nav-link i {
                color: #25D366 !important;
            }

            .whatsapp-nav-link:hover,
            .whatsapp-nav-link:focus {
                color: #1ebe5d !important;
            }

        .navbar-action-area {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        @@media (max-width: 991.98px) {
            .navbar-action-area {
                width: 100%;
                margin-top: 12px;
                display: grid !important;
                grid-template-columns: 1fr 1fr;
                gap: 8px;
                align-items: stretch !important;
            }

                .navbar-action-area .btn,
                .navbar-action-area form,
                .navbar-action-area form button {
                    width: 100%;
                }

                .navbar-action-area .btn,
                .navbar-action-area form button {
                    min-height: 42px;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    gap: 5px;
                    white-space: normal;
                    line-height: 1.25;
                }

            .navbar-nav .nav-link {
                padding-top: 9px;
                padding-bottom: 9px;
            }

            .whatsapp-nav-link {
                color: #25D366 !important;
            }
        }

        @@media (max-width: 380px) {
            .navbar-action-area {
                gap: 6px;
            }

                .navbar-action-area .btn,
                .navbar-action-area form button {
                    font-size: .82rem;
                    padding-left: 8px;
                    padding-right: 8px;
                }
        }
    </style>
</head>

<body>
    @if (!hideNavbar)
    {
        <nav class="navbar navbar-expand-lg navbar-dark sticky-top app-navbar">
            <div class="container-fluid px-lg-4">

                <a class="navbar-brand fw-bold d-flex align-items-center gap-2"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="brand-ball">
                        <img src="~/img/football_logo.png" alt="Transtec 360 Logo" class="brand-logo" />
                    </span>
                    Transtec 360&deg; Football
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                        <i class="bi bi-speedometer2"></i> Admin
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-controller="Users" asp-action="Index">
                                        <i class="bi bi-people"></i> Users
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-controller="Fixtures" asp-action="Index">
                                        <i class="bi bi-calendar-event"></i> Fixtures
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-controller="AutomationSettings" asp-action="Index">
                                        <i class="bi bi-robot"></i> Settings
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-controller="Ads" asp-action="Index">
                                        <i class="bi bi-megaphone"></i> Ads
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Dashboard" asp-action="Index">
                                        <i class="bi bi-grid-1x2"></i> Dashboard
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Dashboard" asp-action="PredictionScore">
                                        <i class="bi bi-ui-checks-grid"></i> My Prediction &amp; Score
                                    </a>
                                </li>
                            }

                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Leaderboard" asp-action="Index">
                                    <i class="bi bi-trophy"></i> Leaderboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Dashboard" asp-action="Rules">
                                    <i class="bi bi-journal-check"></i> Game Rules
                                </a>
                            </li>

                            @if (showWhatsAppButton)
                            {
                                <li class="nav-item">
                                    <a class="nav-link whatsapp-nav-link"
                                       href="@portalSettings!.WhatsAppGroupUrl"
                                       target="_blank"
                                       rel="noopener noreferrer">
                                        <i class="bi bi-whatsapp"></i> Join WhatsApp Group
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <div class="navbar-action-area">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            var currentUser = await UserManager.GetUserAsync(User);

                            <a class="btn btn-outline-light btn-sm"
                               asp-area=""
                               asp-controller="Account"
                               asp-action="Profile">
                                <i class="bi bi-person-circle"></i> @(currentUser?.FullName ?? "Profile")
                            </a>

                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()

                                <button type="submit" class="btn btn-warning btn-sm">
                                    <i class="bi bi-box-arrow-right"></i> Logout
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-outline-light btn-sm"
                               asp-area=""
                               asp-controller="Account"
                               asp-action="Login">
                                Login
                            </a>

                            <a class="btn btn-warning btn-sm"
                               asp-area=""
                               asp-controller="Account"
                               asp-action="Register">
                                Sign Up
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    }

    <main class="container-fluid px-lg-4 py-4">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="text-center text-white-50 small py-4">
        <span>Transtec 360&deg; Football Prediction System</span>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
    @await Component.InvokeAsync("Ads")

    @if (User.Identity?.IsAuthenticated == true)
    {
        <form id="heartbeatAntiForgeryForm" class="d-none">
            @Html.AntiForgeryToken()
        </form>

        <script>
            document.addEventListener("DOMContentLoaded", function () {
                startUserHeartbeat();
            });

            function startUserHeartbeat() {
                sendUserHeartbeat();

                setInterval(function () {
                    sendUserHeartbeat();
                }, 60000);
            }

            async function sendUserHeartbeat() {
                const tokenInput = document.querySelector('#heartbeatAntiForgeryForm input[name="__RequestVerificationToken"]');
                const token = tokenInput ? tokenInput.value : "";

                try {
                    await fetch('@Url.Action("Heartbeat", "Account", new { area = "" })', {
                        method: "POST",
                        headers: {
                            "RequestVerificationToken": token,
                            "X-Requested-With": "XMLHttpRequest"
                        }
                    });
                }
                catch (error) {
                    console.warn("Heartbeat failed.", error);
                }
            }
        </script>
    }

</body>
</html>