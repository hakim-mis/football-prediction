@using Microsoft.EntityFrameworkCore
@using FootballPredictionGame.Data
@inject ApplicationDbContext DbContext

@{
    ViewData["Title"] = "Email Verified";
    ViewData["HideNavbar"] = true;

    var settings = await DbContext.AutomationSettings
        .AsNoTracking()
        .OrderBy(x => x.Id)
        .FirstOrDefaultAsync();

    var showWhatsApp =
        settings != null &&
        settings.ShowWhatsAppJoinMenu &&
        !string.IsNullOrWhiteSpace(settings.WhatsAppGroupUrl);
}

<style>
    .verify-wrapper {
        min-height: 100vh;
        padding: 24px 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .verify-card {
        width: 100%;
        max-width: 650px;
        overflow: hidden;
    }

    .verify-logo {
        width: 180px;
        max-width: 100%;
        height: auto;
        object-fit: contain;
    }

    .verify-icon {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: #ffc107;
        color: #111827;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        margin-bottom: 12px;
    }

    .verify-info-box {
        background: #fff7ed;
        border: 1px solid #fed7aa;
        color: #9a3412;
        border-radius: 16px;
        padding: 18px;
        margin-bottom: 22px;
        text-align: left;
    }

        .verify-info-box h5 {
            font-weight: 800;
            margin-bottom: 6px;
        }

    .whatsapp-success-btn {
        background: #25D366;
        border-color: #25D366;
        color: #ffffff !important;
        font-weight: 800;
    }

        .whatsapp-success-btn:hover {
            background: #1ebe5d;
            border-color: #1ebe5d;
            color: #ffffff !important;
        }

    @@media (max-width: 767.98px) {
        .verify-wrapper {
            padding: 12px 8px;
        }

        .verify-logo {
            width: 220px;
        }

        .verify-card {
            border-radius: 14px;
        }

        .d-grid.d-md-flex .btn {
            width: 100%;
        }
    }
</style>

<div class="verify-wrapper">
    <div class="col-12 col-sm-11 col-md-8 col-lg-6">
        <div class="glass-card verify-card p-3 p-sm-4 p-lg-5 text-center">

            <img src="~/img/logo2.png" alt="Logo" class="verify-logo mb-3" />

            <div class="verify-icon">
                <i class="bi bi-envelope-check"></i>
            </div>

            <h1 class="h3 fw-bold mb-2">
                Email Verified Successfully
            </h1>

            <p class="text-muted mb-4">
                Your email address has been verified. Your account is now waiting for admin approval.
            </p>

            <div class="verify-info-box">
                <h5>
                    <i class="bi bi-person-check"></i>
                    Admin approval required
                </h5>

                <p class="mb-0">
                    Admin will review your profile and activate your account. After activation, you will receive an account activation email and can start submitting predictions.
                </p>
            </div>

            <div class="d-grid d-md-flex gap-2">
                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn btn-warning btn-lg fw-bold flex-fill">
                    <i class="bi bi-box-arrow-in-right"></i>
                    Back to Login
                </a>

                @if (showWhatsApp)
                {
                    <a href="@settings!.WhatsAppGroupUrl"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="btn btn-lg whatsapp-success-btn flex-fill">
                        <i class="bi bi-whatsapp"></i>
                        Join WhatsApp Group
                    </a>
                }
            </div>

        </div>
    </div>
</div>