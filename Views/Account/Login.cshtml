@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    ViewData["HideNavbar"] = true;
}
<div class="auth-wrapper row align-items-center justify-content-center">
    <div class="col-lg-5 col-md-8">
        <div class="glass-card auth-card p-4 p-lg-5">
            <div class="text-center mb-4">
                @* <div class="auth-icon mx-auto"><i class="bi bi-dribbble"></i></div>
                <h1 class="h3 fw-bold mt-3">Welcome Back</h1>
                <p class="text-white-50 mb-0">Login to predict matches and climb the leaderboard.</p> *@
                
                    <img src="~/img/baner.png" alt="Logo" class="brand-logo" />
                
            </div>
            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="text-warning mb-3"></div>
                <input type="hidden" name="returnUrl" value='@ViewData["ReturnUrl"]' />
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control form-control-lg" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="text-warning small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control form-control-lg" placeholder="Password" />
                    <span asp-validation-for="Password" class="text-warning small"></span>
                </div>
                <div class="form-check mb-4">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>
                <button type="submit" class="btn btn-warning btn-lg w-100 fw-bold">Login</button>
            </form>
            <div class="text-center mt-4">
                <span class="text-white-50">New player?</span>
                <a asp-action="Register" class="text-warning fw-bold text-decoration-none">Create account</a>
            </div>

        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
