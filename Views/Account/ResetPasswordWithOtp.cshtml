@model FootballPredictionGame.ViewModels.ResetPasswordWithOtpViewModel

@{
    ViewData["Title"] = "Reset Password";
    ViewData["HideNavbar"] = true;
}

<style>
    .forgot-wrapper {
        min-height: 100vh;
        padding: 24px 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .forgot-card {
        width: 100%;
        max-width: 700px;
        overflow: hidden;
    }

    .forgot-logo {
        width: 180px;
        max-width: 100%;
        height: auto;
        object-fit: contain;
    }

    @@media (max-width: 767.98px) {

        .forgot-wrapper {
            padding: 12px 8px;
        }

        .forgot-logo {
            width: 220px;
        }

        .forgot-card {
            border-radius: 14px;
        }

        .d-grid.d-md-flex .btn {
            width: 100%;
        }
    }

    @@media (max-width: 420px) {

        .forgot-logo {
            width: 190px;
        }
    }
</style>

<div class="forgot-wrapper">

    <div class="col-12 col-sm-11 col-md-8 col-lg-7">

        <div class="glass-card forgot-card p-3 p-sm-4 p-lg-5">

            <div class="d-flex flex-column flex-md-row align-items-center text-center text-md-start gap-3 gap-md-4 mb-4">

                <div>
                    <img src="~/img/logo2.png" alt="Logo" class="forgot-logo" />
                </div>

                <div>
                    <h1 class="h3 fw-bold mb-1">
                        Reset Password
                    </h1>

                    <p class="text-white-50 mb-0">
                        Enter the OTP sent to your verified email address and create a new secure password.
                    </p>
                </div>

            </div>

            <form asp-action="ResetPasswordWithOtp" method="post">
                @Html.AntiForgeryToken()

                <input asp-for="Email" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-warning mb-3">
                </div>

                <!-- OTP -->

                <div class="mb-4">
                    <label asp-for="Otp" class="form-label"></label>

                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-shield-lock"></i>
                        </span>

                        <input asp-for="Otp"
                               maxlength="6"
                               class="form-control text-center fw-bold"
                               placeholder="Enter 6 Digit OTP" />
                    </div>

                    <span asp-validation-for="Otp"
                          class="text-warning small">
                    </span>
                </div>

                <!-- NEW PASSWORD -->

                <div class="mb-4">
                    <label asp-for="NewPassword" class="form-label"></label>

                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-lock"></i>
                        </span>

                        <input asp-for="NewPassword"
                               class="form-control"
                               placeholder="New Password" />
                    </div>

                    <span asp-validation-for="NewPassword"
                          class="text-warning small">
                    </span>

                    <small class="text-white-50">
                        Minimum 8 characters with uppercase, lowercase,
                        number and special character.
                    </small>
                </div>

                <!-- CONFIRM PASSWORD -->

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label"></label>

                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-lock-fill"></i>
                        </span>

                        <input asp-for="ConfirmPassword"
                               class="form-control"
                               placeholder="Confirm Password" />
                    </div>

                    <span asp-validation-for="ConfirmPassword"
                          class="text-warning small">
                    </span>
                </div>

                <div class="d-grid d-md-flex gap-2">

                    <button type="submit"
                            class="btn btn-warning btn-lg fw-bold flex-fill">
                        <i class="bi bi-key-fill"></i>
                        Reset Password
                    </button>

                    <a asp-action="Login"
                       class="btn btn-outline-light btn-lg flex-fill">
                        Back to Login
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}