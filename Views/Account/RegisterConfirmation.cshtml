@using Microsoft.EntityFrameworkCore
@using FootballPredictionGame.Data
@inject ApplicationDbContext DbContext

@{
    ViewData["Title"] = "Registration Submitted";
    ViewData["HideNavbar"] = true;

    var settings = await DbContext.AutomationSettings
        .AsNoTracking()
        .OrderBy(x => x.Id)
        .FirstOrDefaultAsync();

    var autoActivateAfterVerification = settings?.AutoActivateUserAfterEmailVerification ?? false;
}

<style>
    .forgot-wrapper {
        min-height: 100vh;
        padding: 24px 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .forgot-card {
        width: 100%;
        max-width: 650px;
        overflow: hidden;
    }

    .forgot-header {
        width: 100%;
    }

    .forgot-logo-box {
        flex: 0 0 auto;
    }

    .forgot-logo {
        width: 180px;
        max-width: 100%;
        height: auto;
        object-fit: contain;
    }

    .forgot-title-box {
        flex: 1;
        min-width: 0;
    }

        .forgot-title-box h1 {
            line-height: 1.2;
            color: #111827;
        }

        .forgot-title-box p {
            line-height: 1.5;
            color: #475569 !important;
        }

    .registration-status-box {
        background: #f8fbff;
        border: 1px solid #bfdbfe;
        border-radius: 16px;
        padding: 18px;
        margin-bottom: 22px;
    }

    .registration-status-item {
        display: flex;
        align-items: flex-start;
        gap: 13px;
        padding: 12px;
        border-radius: 14px;
        background: #ffffff;
        border: 1px solid #e5eefb;
        margin-bottom: 12px;
    }

        .registration-status-item:last-child {
            margin-bottom: 0;
        }

    .registration-status-icon {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #ffc107;
        color: #111827;
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        font-size: 17px;
        box-shadow: 0 8px 20px rgba(255, 193, 7, .25);
    }

        .registration-status-icon.success {
            background: #16a34a;
            color: #ffffff;
            box-shadow: 0 8px 20px rgba(22, 163, 74, .25);
        }

    .registration-status-text strong {
        display: block;
        color: #111827;
        font-weight: 800;
        margin-bottom: 3px;
        line-height: 1.25;
    }

    .registration-status-text span {
        display: block;
        color: #475569;
        font-size: .92rem;
        line-height: 1.45;
    }

    .registration-note {
        background: #fff7ed;
        border: 1px solid #fed7aa;
        color: #9a3412;
        border-radius: 14px;
        padding: 12px 14px;
        font-size: .9rem;
        line-height: 1.5;
        margin-bottom: 22px;
    }

        .registration-note i {
            color: #f97316;
            margin-right: 5px;
        }

    @@media (max-width: 767.98px) {
        .forgot-wrapper {
            padding: 12px 8px;
        }

        .forgot-logo {
            width: 220px;
        }

        .forgot-title-box h1 {
            font-size: 1.6rem;
        }

        .forgot-title-box p {
            font-size: .95rem;
        }

        .forgot-card {
            border-radius: 14px;
        }

        .registration-status-box {
            padding: 12px;
        }

        .registration-status-item {
            padding: 11px;
        }

        .d-grid.d-md-flex .btn {
            width: 100%;
        }
    }

    @@media (max-width: 420px) {
        .forgot-logo {
            width: 190px;
        }

        .forgot-title-box h1 {
            font-size: 1.4rem;
        }

        .forgot-title-box p {
            font-size: .9rem;
        }

        .registration-status-item {
            gap: 10px;
        }

        .registration-status-icon {
            width: 34px;
            height: 34px;
            font-size: 15px;
        }

        .registration-status-text span {
            font-size: .86rem;
        }
    }
</style>

<div class="forgot-wrapper">

    <div class="col-12 col-sm-11 col-md-8 col-lg-6">

        <div class="glass-card forgot-card p-3 p-sm-4 p-lg-5">

            <div class="forgot-header d-flex flex-column flex-md-row align-items-center text-center text-md-start gap-3 gap-md-4 mb-4">

                <div class="forgot-logo-box">
                    <img src="~/img/logo2.png" alt="Logo" class="forgot-logo" />
                </div>

                <div class="forgot-title-box">
                    <h1 class="h3 fw-bold mb-1">
                        Check Your Email
                    </h1>

                    <p class="mb-0">
                        Your registration has been submitted successfully. Please verify your email address to continue.
                    </p>
                </div>

            </div>

            <div class="registration-status-box">

                <div class="registration-status-item">
                    <div class="registration-status-icon">
                        <i class="bi bi-envelope-check"></i>
                    </div>

                    <div class="registration-status-text">
                        <strong>Email verification required</strong>
                        <span>
                            We have sent a verification link to your registered email address.
                            Please open your inbox and click the verification link.
                        </span>
                    </div>
                </div>

                @if (autoActivateAfterVerification)
                {
                    <div class="registration-status-item">
                        <div class="registration-status-icon success">
                            <i class="bi bi-person-check"></i>
                        </div>

                        <div class="registration-status-text">
                            <strong>Automatic account activation</strong>
                            <span>
                                After email verification, your account will be activated automatically.
                                You can then log in and start submitting predictions.
                            </span>
                        </div>
                    </div>

                    <div class="registration-status-item">
                        <div class="registration-status-icon">
                            <i class="bi bi-trophy"></i>
                        </div>

                        <div class="registration-status-text">
                            <strong>Start prediction after verification</strong>
                            <span>
                                Once your email is verified, you can log in, predict fixtures, earn points, and compete on the leaderboard.
                            </span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="registration-status-item">
                        <div class="registration-status-icon">
                            <i class="bi bi-person-check"></i>
                        </div>

                        <div class="registration-status-text">
                            <strong>Admin approval required</strong>
                            <span>
                                After email verification, admin will review your profile and approve your account.
                            </span>
                        </div>
                    </div>

                    <div class="registration-status-item">
                        <div class="registration-status-icon">
                            <i class="bi bi-trophy"></i>
                        </div>

                        <div class="registration-status-text">
                            <strong>Start prediction after approval</strong>
                            <span>
                                Once approved, you can log in, predict fixtures, earn points, and compete on the leaderboard.
                            </span>
                        </div>
                    </div>
                }

            </div>

            <div class="registration-note">
                <i class="bi bi-info-circle-fill"></i>
                If you do not find the email, please check your spam or junk folder. You can also resend the verification link.
            </div>

            <div class="d-grid d-md-flex gap-2">

                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn btn-warning btn-lg fw-bold flex-fill">
                    <i class="bi bi-box-arrow-in-right"></i>
                    Back to Login
                </a>

                <a asp-controller="Account"
                   asp-action="ResendEmailVerification"
                   class="btn btn-outline-primary btn-lg flex-fill">
                    <i class="bi bi-send"></i>
                    Resend Link
                </a>

            </div>

        </div>

    </div>

</div>