@model RegisterViewModel

@{
    ViewData["Title"] = "Sign Up";
    ViewData["HideNavbar"] = true;
}

<style>
    .register-wrapper {
        min-height: 100vh;
        padding: 24px 12px;
        margin: 0;
    }

    .register-card {
        width: 100%;
        overflow: hidden;
    }

    .register-header {
        width: 100%;
    }

    .register-logo-box {
        flex: 0 0 auto;
    }

    .register-logo {
        width: 180px;
        max-width: 100%;
        height: auto;
        object-fit: contain;
    }

    .register-title-box {
        flex: 1;
        min-width: 0;
    }

        .register-title-box h1 {
            line-height: 1.2;
        }

        .register-title-box p {
            line-height: 1.5;
        }

    .password-input-group .form-control {
        border-right: 0;
    }

    .password-eye-btn {
        width: 46px;
        border: 1px solid #ced4da;
        border-left: 0;
        background: #ffffff;
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .password-eye-btn:hover,
        .password-eye-btn:focus {
            background: #eef6ff;
            color: #0a58ca;
            border-color: #86b7fe;
            box-shadow: none;
        }

    .password-field-message {
        display: block;
        margin-top: 6px;
        font-size: .82rem;
        font-weight: 400;
        color: #dc2626;
    }

    .password-rule-box {
        border: 1px solid rgba(220, 38, 38, .18);
        background: rgba(255, 247, 247, .96);
        border-radius: 12px;
        padding: 10px 12px;
    }

    .password-rule-title {
        font-size: .82rem;
        font-weight: 600;
        color: #334155;
        margin-bottom: 7px;
    }

    .password-rule-item {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: .82rem;
        font-weight: 400;
        margin: 6px 0;
    }

        .password-rule-item.invalid {
            color: #dc2626;
        }

        .password-rule-item.valid {
            color: #16a34a;
        }

        .password-rule-item i {
            font-size: .9rem;
        }

    @@media (max-width: 767.98px) {
        .register-wrapper {
            padding: 12px 8px;
        }

        .register-logo {
            width: 220px;
        }

        .register-title-box h1 {
            font-size: 1.6rem;
        }

        .register-title-box p {
            font-size: 0.95rem;
        }

        .register-card {
            border-radius: 14px;
        }

        .d-grid.d-md-flex .btn {
            width: 100%;
        }
    }

    @@media (max-width: 420px) {
        .register-logo {
            width: 190px;
        }

        .register-title-box h1 {
            font-size: 1.4rem;
        }

        .register-title-box p {
            font-size: 0.9rem;
        }
    }
</style>

<div class="register-wrapper row justify-content-center">
    <div class="col-12 col-sm-11 col-md-10 col-lg-8 col-xl-7">
        <div class="glass-card register-card p-3 p-sm-4 p-lg-5">

            <div class="register-header d-flex flex-column flex-md-row align-items-center text-center text-md-start gap-3 gap-md-4 mb-4">
                <div class="register-logo-box">
                    <img src="~/img/logo2.png" alt="Logo" class="register-logo" />
                </div>

                <div class="register-title-box">
                    <h1 class="h3 fw-bold mb-1">Create Player Profile</h1>
                    <p class="text-white-50 mb-0">
                        Please verify your email address first. After verification, admin will approve your account.
                    </p>
                </div>
            </div>

            <form asp-action="Register" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-warning mb-3"></div>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" placeholder="Your full name" />
                        <span asp-validation-for="FullName" class="text-warning small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="MobileNo" class="form-label"></label>
                        <input asp-for="MobileNo" class="form-control" placeholder="Mobile number" />
                        <span asp-validation-for="MobileNo" class="text-warning small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Designation" class="form-label"></label>
                        <input asp-for="Designation" class="form-control" placeholder="Your designation" />
                        <span asp-validation-for="Designation" class="text-warning small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Department" class="form-label"></label>
                        <input asp-for="Department" class="form-control" placeholder="Example: MIS & IT, TEL" />
                        <span asp-validation-for="Department" class="text-warning small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                        <span asp-validation-for="Email" class="text-warning small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="ProfilePhoto" class="form-label"></label>
                        <input asp-for="ProfilePhoto" class="form-control" type="file" accept="image/*" />
                        <span asp-validation-for="ProfilePhoto" class="text-warning small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Password" class="form-label"></label>

                        <div class="input-group password-input-group">
                            <input asp-for="Password"
                                   class="form-control"
                                   id="Password"
                                   autocomplete="new-password" />

                            <button class="btn password-eye-btn"
                                    type="button"
                                    onclick="togglePasswordVisibility('Password', this)"
                                    aria-label="Show or hide password">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>

                        <div class="password-rule-box mt-2 d-none" id="passwordRuleBox">
                            <div class="password-rule-title">
                                Password must contain:
                            </div>

                            <div class="password-rule-item invalid" id="ruleLength">
                                <i class="bi bi-x-circle-fill"></i>
                                <span>Minimum 8 characters</span>
                            </div>

                            <div class="password-rule-item invalid" id="ruleUppercase">
                                <i class="bi bi-x-circle-fill"></i>
                                <span>At least 1 uppercase letter</span>
                            </div>

                            <div class="password-rule-item invalid" id="ruleNumber">
                                <i class="bi bi-x-circle-fill"></i>
                                <span>At least 1 number</span>
                            </div>

                            <div class="password-rule-item invalid" id="ruleSpecial">
                                <i class="bi bi-x-circle-fill"></i>
                                <span>At least 1 special character</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label"></label>

                        <div class="input-group password-input-group">
                            <input asp-for="ConfirmPassword"
                                   class="form-control"
                                   id="ConfirmPassword"
                                   autocomplete="new-password" />

                            <button class="btn password-eye-btn"
                                    type="button"
                                    onclick="togglePasswordVisibility('ConfirmPassword', this)"
                                    aria-label="Show or hide confirm password">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>

                        <span asp-validation-for="ConfirmPassword" class="password-field-message small"></span>
                    </div>
                </div>

                <div class="d-grid d-md-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-warning btn-lg fw-bold flex-fill">
                        <i class="bi bi-person-check"></i>
                        Submit Registration
                    </button>

                    <a asp-action="Login" class="btn btn-outline-light btn-lg flex-fill">
                        Already registered?
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const passwordInput = document.getElementById("Password");
            const confirmPasswordInput = document.getElementById("ConfirmPassword");

            if (passwordInput) {
                passwordInput.addEventListener("input", function () {
                    validatePasswordRules();
                    triggerConfirmPasswordValidation();
                });

                passwordInput.addEventListener("focus", function () {
                    validatePasswordRules();
                });
            }

            if (confirmPasswordInput) {
                confirmPasswordInput.addEventListener("input", function () {
                    triggerConfirmPasswordValidation();
                });
            }

            validatePasswordRules();
        });

        function validatePasswordRules() {
            const passwordInput = document.getElementById("Password");
            const ruleBox = document.getElementById("passwordRuleBox");

            if (!passwordInput || !ruleBox) {
                return;
            }

            const password = passwordInput.value || "";

            const hasLength = password.length >= 8;
            const hasUppercase = /[A-Z]/.test(password);
            const hasNumber = /[0-9]/.test(password);
            const hasSpecial = /[^a-zA-Z0-9]/.test(password);

            setPasswordRuleStatus("ruleLength", hasLength);
            setPasswordRuleStatus("ruleUppercase", hasUppercase);
            setPasswordRuleStatus("ruleNumber", hasNumber);
            setPasswordRuleStatus("ruleSpecial", hasSpecial);

            const allValid = hasLength && hasUppercase && hasNumber && hasSpecial;

            if (password.length === 0 || allValid) {
                ruleBox.classList.add("d-none");
            } else {
                ruleBox.classList.remove("d-none");
            }
        }

        function setPasswordRuleStatus(ruleId, isValid) {
            const rule = document.getElementById(ruleId);

            if (!rule) {
                return;
            }

            const icon = rule.querySelector("i");

            if (isValid) {
                rule.classList.remove("invalid");
                rule.classList.add("valid");

                if (icon) {
                    icon.className = "bi bi-check-circle-fill";
                }
            } else {
                rule.classList.remove("valid");
                rule.classList.add("invalid");

                if (icon) {
                    icon.className = "bi bi-x-circle-fill";
                }
            }
        }

        function triggerConfirmPasswordValidation() {
            const confirmPasswordInput = document.getElementById("ConfirmPassword");

            if (confirmPasswordInput && window.jQuery && $.validator) {
                $(confirmPasswordInput).valid();
            }
        }

        function togglePasswordVisibility(inputId, button) {
            const input = document.getElementById(inputId);

            if (!input) {
                return;
            }

            const icon = button.querySelector("i");

            if (input.type === "password") {
                input.type = "text";

                if (icon) {
                    icon.className = "bi bi-eye-slash";
                }
            } else {
                input.type = "password";

                if (icon) {
                    icon.className = "bi bi-eye";
                }
            }
        }
    </script>
}