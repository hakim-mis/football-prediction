@model ForceChangePasswordViewModel

@{
    ViewData["Title"] = "Change Default Password";
    ViewData["HideNavbar"] = true;
}

<style>
    .forgot-wrapper {
        min-height: 100vh;
        padding: 24px 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .forgot-card {
        width: 100%;
        max-width: 700px;
        overflow: hidden;
    }

    .forgot-header {
        width: 100%;
    }

    .forgot-logo-box {
        flex: 0 0 auto;
    }

    .forgot-logo {
        width: 180px;
        max-width: 100%;
        height: auto;
        object-fit: contain;
    }

    .forgot-title-box {
        flex: 1;
        min-width: 0;
    }

        .forgot-title-box h1 {
            line-height: 1.2;
        }

        .forgot-title-box p {
            line-height: 1.5;
        }

    .password-rule-box {
        background: rgba(255, 255, 255, .08);
        border: 1px solid rgba(255, 255, 255, .18);
        border-radius: 14px;
        padding: 14px 16px;
        margin-bottom: 20px;
    }

    .password-rule-title {
        color: #ffffff;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .password-rule-list {
        margin: 0;
        padding-left: 18px;
        color: rgba(255, 255, 255, .68);
        font-size: .9rem;
        line-height: 1.6;
    }

    @@media (max-width: 767.98px) {

        .forgot-wrapper {
            padding: 12px 8px;
        }

        .forgot-logo {
            width: 220px;
        }

        .forgot-title-box h1 {
            font-size: 1.6rem;
        }

        .forgot-title-box p {
            font-size: .95rem;
        }

        .forgot-card {
            border-radius: 14px;
        }

        .d-grid.d-md-flex .btn {
            width: 100%;
        }
    }

    @@media (max-width: 420px) {

        .forgot-logo {
            width: 190px;
        }

        .forgot-title-box h1 {
            font-size: 1.4rem;
        }

        .forgot-title-box p {
            font-size: .9rem;
        }
    }
</style>

<div class="forgot-wrapper">

    <div class="col-12 col-sm-11 col-md-8 col-lg-6">

        <div class="glass-card forgot-card p-3 p-sm-4 p-lg-5">

            <div class="forgot-header d-flex flex-column flex-md-row align-items-center text-center text-md-start gap-3 gap-md-4 mb-4">

                <div class="forgot-logo-box">
                    <img src="~/img/logo2.png" alt="Logo" class="forgot-logo" />
                </div>

                <div class="forgot-title-box">
                    <h1 class="h3 fw-bold mb-1">
                        Set New Password
                    </h1>

                    <p class="text-white-50 mb-0">
                        @(ViewBag.Message ?? "For security, please change your default password before using the system.")
                    </p>
                </div>

            </div>

            <div class="password-rule-box">
                <div class="password-rule-title">
                    <i class="bi bi-shield-lock"></i>
                    Password Requirements
                </div>

                <ul class="password-rule-list">
                    <li>Minimum 8 characters</li>
                    <li>At least one uppercase and one lowercase letter</li>
                    <li>At least one number</li>
                    <li>At least one special character</li>
                </ul>
            </div>

            <form asp-action="ForceChangePassword" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-warning mb-3"></div>

                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label"></label>

                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-key"></i>
                        </span>

                        <input asp-for="CurrentPassword"
                               class="form-control"
                               autocomplete="current-password"
                               placeholder="Current temporary password" />
                    </div>

                    <span asp-validation-for="CurrentPassword" class="text-warning small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>

                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-lock"></i>
                        </span>

                        <input asp-for="NewPassword"
                               class="form-control"
                               autocomplete="new-password"
                               placeholder="New password" />
                    </div>

                    <span asp-validation-for="NewPassword" class="text-warning small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label"></label>

                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-lock-fill"></i>
                        </span>

                        <input asp-for="ConfirmPassword"
                               class="form-control"
                               autocomplete="new-password"
                               placeholder="Confirm new password" />
                    </div>

                    <span asp-validation-for="ConfirmPassword" class="text-warning small"></span>
                </div>

                <div class="d-grid d-md-flex gap-2">

                    <button type="submit"
                            class="btn btn-warning btn-lg fw-bold flex-fill">
                        <i class="bi bi-check-circle"></i>
                        Update Password
                    </button>

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-outline-light btn-lg flex-fill">
                        <i class="bi bi-box-arrow-in-right"></i>
                        Back to Login
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}