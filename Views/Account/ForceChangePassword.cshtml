@model ForceChangePasswordViewModel

@{
    ViewData["Title"] = "Change Default Password";
    ViewData["HideNavbar"] = true;
}

<style>
    .forgot-wrapper {
        min-height: 100vh;
        padding: 24px 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .forgot-card {
        width: 100%;
        max-width: 700px;
        overflow: hidden;
    }

    .forgot-header {
        width: 100%;
    }

    .forgot-logo-box {
        flex: 0 0 auto;
    }

    .forgot-logo {
        width: 180px;
        max-width: 100%;
        height: auto;
        object-fit: contain;
    }

    .forgot-title-box {
        flex: 1;
        min-width: 0;
    }

        .forgot-title-box h1 {
            line-height: 1.2;
        }

        .forgot-title-box p {
            line-height: 1.5;
        }

    .password-input-group .form-control {
        border-right: 0;
    }

    .password-eye-btn {
        width: 46px;
        border: 1px solid #ced4da;
        border-left: 0;
        background: #ffffff;
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .password-eye-btn:hover,
        .password-eye-btn:focus {
            background: #eef6ff;
            color: #0a58ca;
            border-color: #86b7fe;
            box-shadow: none;
        }

    .password-field-message {
        display: block;
        margin-top: 6px;
        font-size: .82rem;
        font-weight: 400;
        color: #dc2626;
    }

    .password-rule-box {
        border: 1px solid rgba(220, 38, 38, .18);
        background: rgba(255, 247, 247, .96);
        border-radius: 12px;
        padding: 10px 12px;
    }

    .password-rule-title {
        font-size: .82rem;
        font-weight: 600;
        color: #334155;
        margin-bottom: 7px;
    }

    .password-rule-item {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: .82rem;
        font-weight: 400;
        margin: 6px 0;
    }

        .password-rule-item.invalid {
            color: #dc2626;
        }

        .password-rule-item.valid {
            color: #16a34a;
        }

        .password-rule-item i {
            font-size: .9rem;
        }

    @@media (max-width: 767.98px) {
        .forgot-wrapper {
            padding: 12px 8px;
        }

        .forgot-logo {
            width: 220px;
        }

        .forgot-title-box h1 {
            font-size: 1.6rem;
        }

        .forgot-title-box p {
            font-size: .95rem;
        }

        .forgot-card {
            border-radius: 14px;
        }

        .d-grid.d-md-flex .btn {
            width: 100%;
        }
    }

    @@media (max-width: 420px) {
        .forgot-logo {
            width: 190px;
        }

        .forgot-title-box h1 {
            font-size: 1.4rem;
        }

        .forgot-title-box p {
            font-size: .9rem;
        }
    }
</style>

<div class="forgot-wrapper">

    <div class="col-12 col-sm-11 col-md-8 col-lg-6">

        <div class="glass-card forgot-card p-3 p-sm-4 p-lg-5">

            <div class="forgot-header d-flex flex-column flex-md-row align-items-center text-center text-md-start gap-3 gap-md-4 mb-4">

                <div class="forgot-logo-box">
                    <img src="~/img/logo2.png" alt="Logo" class="forgot-logo" />
                </div>

                <div class="forgot-title-box">
                    <h1 class="h3 fw-bold mb-1">
                        Set New Password
                    </h1>

                    <p class="text-white-50 mb-0">
                        @(ViewBag.Message ?? "For security, please change the default password before using the system.")
                    </p>
                </div>

            </div>

            <form asp-action="ForceChangePassword" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-warning mb-3"></div>

                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label"></label>

                    <div class="input-group password-input-group">
                        <span class="input-group-text">
                            <i class="bi bi-key"></i>
                        </span>

                        <input asp-for="CurrentPassword"
                               class="form-control"
                               id="CurrentPassword"
                               autocomplete="current-password"
                               placeholder="Current temporary password" />

                        <button class="btn password-eye-btn"
                                type="button"
                                onclick="togglePasswordVisibility('CurrentPassword', this)"
                                aria-label="Show or hide current password">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>

                    <span asp-validation-for="CurrentPassword" class="text-warning small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>

                    <div class="input-group password-input-group">
                        <span class="input-group-text">
                            <i class="bi bi-lock"></i>
                        </span>

                        <input asp-for="NewPassword"
                               class="form-control"
                               id="NewPassword"
                               autocomplete="new-password"
                               placeholder="New password" />

                        <button class="btn password-eye-btn"
                                type="button"
                                onclick="togglePasswordVisibility('NewPassword', this)"
                                aria-label="Show or hide new password">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>

                    <div class="password-rule-box mt-2 d-none" id="passwordRuleBox">
                        <div class="password-rule-title">
                            Password must contain:
                        </div>

                        <div class="password-rule-item invalid" id="ruleLength">
                            <i class="bi bi-x-circle-fill"></i>
                            <span>Minimum 8 characters</span>
                        </div>

                        <div class="password-rule-item invalid" id="ruleUppercase">
                            <i class="bi bi-x-circle-fill"></i>
                            <span>At least 1 uppercase letter</span>
                        </div>

                        <div class="password-rule-item invalid" id="ruleNumber">
                            <i class="bi bi-x-circle-fill"></i>
                            <span>At least 1 number</span>
                        </div>

                        <div class="password-rule-item invalid" id="ruleSpecial">
                            <i class="bi bi-x-circle-fill"></i>
                            <span>At least 1 special character</span>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label"></label>

                    <div class="input-group password-input-group">
                        <span class="input-group-text">
                            <i class="bi bi-lock-fill"></i>
                        </span>

                        <input asp-for="ConfirmPassword"
                               class="form-control"
                               id="ConfirmPassword"
                               autocomplete="new-password"
                               placeholder="Confirm new password" />

                        <button class="btn password-eye-btn"
                                type="button"
                                onclick="togglePasswordVisibility('ConfirmPassword', this)"
                                aria-label="Show or hide confirm password">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>

                    <span asp-validation-for="ConfirmPassword" class="password-field-message small"></span>
                </div>

                <div class="d-grid d-md-flex gap-2">

                    <button type="submit"
                            class="btn btn-warning btn-lg fw-bold flex-fill">
                        <i class="bi bi-check-circle"></i>
                        Update Password
                    </button>

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-outline-light btn-lg flex-fill">
                        <i class="bi bi-box-arrow-in-right"></i>
                        Back to Login
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const passwordInput = document.getElementById("NewPassword");
            const confirmPasswordInput = document.getElementById("ConfirmPassword");

            if (passwordInput) {
                passwordInput.addEventListener("input", function () {
                    validatePasswordRules();
                    triggerConfirmPasswordValidation();
                });

                passwordInput.addEventListener("focus", function () {
                    validatePasswordRules();
                });
            }

            if (confirmPasswordInput) {
                confirmPasswordInput.addEventListener("input", function () {
                    triggerConfirmPasswordValidation();
                });
            }

            validatePasswordRules();
        });

        function validatePasswordRules() {
            const passwordInput = document.getElementById("NewPassword");
            const ruleBox = document.getElementById("passwordRuleBox");

            if (!passwordInput || !ruleBox) {
                return;
            }

            const password = passwordInput.value || "";

            const hasLength = password.length >= 8;
            const hasUppercase = /[A-Z]/.test(password);
            const hasNumber = /[0-9]/.test(password);
            const hasSpecial = /[^a-zA-Z0-9]/.test(password);

            setPasswordRuleStatus("ruleLength", hasLength);
            setPasswordRuleStatus("ruleUppercase", hasUppercase);
            setPasswordRuleStatus("ruleNumber", hasNumber);
            setPasswordRuleStatus("ruleSpecial", hasSpecial);

            const allValid = hasLength && hasUppercase && hasNumber && hasSpecial;

            if (password.length === 0 || allValid) {
                ruleBox.classList.add("d-none");
            } else {
                ruleBox.classList.remove("d-none");
            }
        }

        function setPasswordRuleStatus(ruleId, isValid) {
            const rule = document.getElementById(ruleId);

            if (!rule) {
                return;
            }

            const icon = rule.querySelector("i");

            if (isValid) {
                rule.classList.remove("invalid");
                rule.classList.add("valid");

                if (icon) {
                    icon.className = "bi bi-check-circle-fill";
                }
            } else {
                rule.classList.remove("valid");
                rule.classList.add("invalid");

                if (icon) {
                    icon.className = "bi bi-x-circle-fill";
                }
            }
        }

        function triggerConfirmPasswordValidation() {
            const confirmPasswordInput = document.getElementById("ConfirmPassword");

            if (confirmPasswordInput && window.jQuery && $.validator) {
                $(confirmPasswordInput).valid();
            }
        }

        function togglePasswordVisibility(inputId, button) {
            const input = document.getElementById(inputId);

            if (!input) {
                return;
            }

            const icon = button.querySelector("i");

            if (input.type === "password") {
                input.type = "text";

                if (icon) {
                    icon.className = "bi bi-eye-slash";
                }
            } else {
                input.type = "password";

                if (icon) {
                    icon.className = "bi bi-eye";
                }
            }
        }
    </script>
}