@using Microsoft.EntityFrameworkCore
@using FootballPredictionGame.Data
@inject ApplicationDbContext DbContext

@{
    ViewData["Title"] = "Account Activated";
    ViewData["HideNavbar"] = true;

    var settings = await DbContext.AutomationSettings
        .AsNoTracking()
        .OrderBy(x => x.Id)
        .FirstOrDefaultAsync();

    var showWhatsApp =
        settings != null &&
        settings.ShowWhatsAppJoinMenu &&
        !string.IsNullOrWhiteSpace(settings.WhatsAppGroupUrl);
}

<style>
    .forgot-wrapper {
        min-height: 100vh;
        padding: 24px 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .forgot-card {
        width: 100%;
        max-width: 650px;
        overflow: hidden;
    }

    .forgot-logo {
        width: 180px;
        max-width: 100%;
        height: auto;
        object-fit: contain;
    }

    .success-box {
        background: #ecfdf5;
        border: 1px solid #86efac;
        color: #14532d;
        border-radius: 16px;
        padding: 18px;
        margin-bottom: 22px;
    }

    .success-icon {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: #16a34a;
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        margin-bottom: 10px;
    }

    .whatsapp-success-btn {
        background: #25D366;
        border-color: #25D366;
        color: #ffffff !important;
        font-weight: 800;
    }

        .whatsapp-success-btn:hover {
            background: #1ebe5d;
            border-color: #1ebe5d;
            color: #ffffff !important;
        }

    @@media (max-width: 767.98px) {
        .forgot-wrapper {
            padding: 12px 8px;
        }

        .forgot-logo {
            width: 220px;
        }

        .forgot-card {
            border-radius: 14px;
        }

        .d-grid.d-md-flex .btn {
            width: 100%;
        }
    }
</style>

<div class="forgot-wrapper">
    <div class="col-12 col-sm-11 col-md-8 col-lg-6">
        <div class="glass-card forgot-card p-3 p-sm-4 p-lg-5 text-center">

            <img src="~/img/logo2.png" alt="Logo" class="forgot-logo mb-3" />

            <div class="success-icon">
                <i class="bi bi-check-lg"></i>
            </div>

            <h1 class="h3 fw-bold mb-2">
                Account Activated Successfully
            </h1>

            <p class="text-muted mb-4">
                Your email has been verified and your account is now active.
                You can log in and start submitting predictions.
            </p>

            <div class="success-box text-start">
                <h5 class="fw-bold">
                    <i class="bi bi-trophy"></i>
                    You are ready to play
                </h5>

                <p class="mb-0">
                    Log in to view fixtures, submit your match predictions, earn points, and compete on the leaderboard.
                </p>
            </div>

            <div class="d-grid d-md-flex gap-2">
                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn btn-warning btn-lg fw-bold flex-fill">
                    <i class="bi bi-box-arrow-in-right"></i>
                    Go to Login
                </a>

                @if (showWhatsApp)
                {
                    <a href="@settings!.WhatsAppGroupUrl"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="btn btn-lg whatsapp-success-btn flex-fill">
                        <i class="bi bi-whatsapp"></i>
                        Join WhatsApp Group
                    </a>
                }
            </div>

        </div>
    </div>
</div>