@{
    ViewData["Title"] = "Email Verified";
    ViewData["HideNavbar"] = true;
}

<style>
    .forgot-wrapper {
        min-height: 100vh;
        padding: 24px 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .forgot-card {
        width: 100%;
        max-width: 650px;
        overflow: hidden;
    }

    .forgot-header {
        width: 100%;
    }

    .forgot-logo-box {
        flex: 0 0 auto;
    }

    .forgot-logo {
        width: 180px;
        max-width: 100%;
        height: auto;
        object-fit: contain;
    }

    .forgot-title-box {
        flex: 1;
        min-width: 0;
    }

        .forgot-title-box h1 {
            line-height: 1.2;
        }

        .forgot-title-box p {
            line-height: 1.5;
        }

    .verified-status-box {
        background: rgba(255, 255, 255, .08);
        border: 1px solid rgba(255, 255, 255, .18);
        border-radius: 14px;
        padding: 18px;
        margin-bottom: 20px;
    }

    .verified-icon-main {
        width: 76px;
        height: 76px;
        border-radius: 50%;
        background: #dcfce7;
        color: #15803d;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 38px;
        margin: 0 auto 16px;
        border: 1px solid #86efac;
    }

    .verified-status-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 14px;
    }

        .verified-status-item:last-child {
            margin-bottom: 0;
        }

    .verified-status-icon {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #ffc107;
        color: #111827;
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        font-size: 17px;
    }

    .verified-status-text strong {
        display: block;
        color: #ffffff;
        font-weight: 800;
        margin-bottom: 2px;
    }

    .verified-status-text span {
        color: rgba(255, 255, 255, .65);
        font-size: .92rem;
        line-height: 1.45;
    }

    @@media (max-width: 767.98px) {
        .forgot-wrapper {
            padding: 12px 8px;
        }

        .forgot-logo {
            width: 220px;
        }

        .forgot-title-box h1 {
            font-size: 1.6rem;
        }

        .forgot-title-box p {
            font-size: .95rem;
        }

        .forgot-card {
            border-radius: 14px;
        }

        .d-grid.d-md-flex .btn {
            width: 100%;
        }
    }

    @@media (max-width: 420px) {
        .forgot-logo {
            width: 190px;
        }

        .forgot-title-box h1 {
            font-size: 1.4rem;
        }

        .forgot-title-box p {
            font-size: .9rem;
        }
    }
</style>

<div class="forgot-wrapper">

    <div class="col-12 col-sm-11 col-md-8 col-lg-6">

        <div class="glass-card forgot-card p-3 p-sm-4 p-lg-5">

            <div class="forgot-header d-flex flex-column flex-md-row align-items-center text-center text-md-start gap-3 gap-md-4 mb-4">

                <div class="forgot-logo-box">
                    <img src="~/img/logo2.png" alt="Logo" class="forgot-logo" />
                </div>

                <div class="forgot-title-box">
                    <h1 class="h3 fw-bold mb-1">
                        Email Verified
                    </h1>

                    <p class="text-white-50 mb-0">
                        Your email address has been verified successfully.
                    </p>
                </div>

            </div>

            <div class="verified-status-box">

                <div class="verified-icon-main">
                    <i class="bi bi-check2-circle"></i>
                </div>

                <div class="text-center mb-4">
                    <h3 class="fw-bold text-success mb-2">
                        Email Verified Successfully
                    </h3>

                    <p class="text-white-50 mb-0">
                        Thank you for verifying your email address. Your account is now ready for admin review.
                    </p>
                </div>

                <div class="verified-status-item">
                    <div class="verified-status-icon">
                        <i class="bi bi-envelope-check"></i>
                    </div>

                    <div class="verified-status-text">
                        <strong>Email verification completed</strong>
                        <span>
                            Your registered email address has been verified successfully.
                        </span>
                    </div>
                </div>

                <div class="verified-status-item">
                    <div class="verified-status-icon">
                        <i class="bi bi-person-check"></i>
                    </div>

                    <div class="verified-status-text">
                        <strong>Waiting for admin approval</strong>
                        <span>
                            Admin will review your account and activate it before you can log in.
                        </span>
                    </div>
                </div>

                <div class="verified-status-item">
                    <div class="verified-status-icon">
                        <i class="bi bi-trophy"></i>
                    </div>

                    <div class="verified-status-text">
                        <strong>Start after activation</strong>
                        <span>
                            After approval, you can predict fixtures, earn points, and compete on the leaderboard.
                        </span>
                    </div>
                </div>

            </div>

            <div class="d-grid d-md-flex gap-2">

                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn btn-warning btn-lg fw-bold flex-fill">
                    <i class="bi bi-box-arrow-in-right"></i>
                    Go to Login
                </a>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-outline-light btn-lg flex-fill">
                    <i class="bi bi-house"></i>
                    Back to Home
                </a>

            </div>

        </div>

    </div>

</div>