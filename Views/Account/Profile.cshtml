@model ProfileViewModel
@{
    ViewData["Title"] = "Profile";
    var photo = string.IsNullOrWhiteSpace(Model.ExistingPhotoPath) ? "../img/default-avatar.svg" : Model.ExistingPhotoPath;
}
<div class="row justify-content-center">
    <div class="col-xl-8">
        <div class="glass-card p-4 p-lg-5">
            <div class="d-flex align-items-center gap-3 mb-4">
                <img src="..@photo" class="avatar-lg" alt="Profile" />
                <div>
                    <h1 class="h3 fw-bold mb-1">My Profile</h1>
                    <p class="text-white-50 mb-0">Update profile photo, contact information and password.</p>
                </div>
            </div>
            <form asp-action="Profile" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-warning mb-3"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-warning small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="MobileNo" class="form-label"></label>
                        <input asp-for="MobileNo" class="form-control" />
                        <span asp-validation-for="MobileNo" class="text-warning small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Designation" class="form-label"></label>
                        <input asp-for="Designation" class="form-control" />
                        <span asp-validation-for="Designation" class="text-warning small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Department" class="form-label"></label>
                        <input asp-for="Department" class="form-control" />
                        <span asp-validation-for="Department" class="text-warning small"></span>
                    </div>

@*                     <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control"/>
                        <span asp-validation-for="Email" class="text-warning small"></span>
                    </div> *@
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>

                        <div class="form-control bg-light">
                            @Model.Email
                        </div>

                        @* <input type="hidden" asp-for="Email" /> *@

@*                         <span asp-validation-for="Email" class="text-warning small"></span> *@
                    </div>
                    <div class="col-md-6">
                        <label asp-for="NewPhoto" class="form-label"></label>
                        <input asp-for="NewPhoto" type="file" class="form-control" accept="image/*" />
                        <span asp-validation-for="NewPhoto" class="text-warning small"></span>
                    </div>
                </div>
                <hr class="border-light opacity-25 my-4" />
                <h5 class="fw-bold">Change Password</h5>
                <p class="text-white-50 small">Leave password fields blank if you do not want to change password.</p>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="CurrentPassword" class="form-label"></label>
                        <input asp-for="CurrentPassword" class="form-control" />
                        <span asp-validation-for="CurrentPassword" class="text-warning small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <input asp-for="NewPassword" class="form-control" />
                        <span asp-validation-for="NewPassword" class="text-warning small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ConfirmNewPassword" class="form-label"></label>
                        <input asp-for="ConfirmNewPassword" class="form-control" />
                        <span asp-validation-for="ConfirmNewPassword" class="text-warning small"></span>
                    </div>
                </div>
                <button class="btn btn-warning btn-lg mt-4 fw-bold" type="submit"><i class="bi bi-save"></i> Save Profile</button>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
