    }

    .leaderboard-search-no-native-clear {
        appearance: none;
        -webkit-appearance: none;
    }

    .leaderboard-table-wrap {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .leaderboard-sort-btn {
        border: 0;
        background: transparent;
        padding: 0;
        font-weight: 800;
        color: #111827;
        display: inline-flex;
        align-items: center;
        gap: 3px;
        white-space: nowrap;
    }

        .leaderboard-sort-btn:hover,
        .leaderboard-sort-btn:focus {
            color: #0d6efd;
        }

    .leaderboard-sl-badge {
        min-width: 38px;
        height: 30px;
        border-radius: 999px;
        background: #eef6ff;
        color: #0d6efd;
        border: 1px solid #bfdbfe;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: .8rem;
        font-weight: 800;
    }

    .leaderboard-count-badge {
        border-radius: 999px;
        padding: 6px 10px;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 42px;
        border: 1px solid transparent;
        line-height: 1;
    }

    .leaderboard-exact-count {
        background: #eef6ff;
        color: #0d6efd;
        border-color: #bfdbfe;
    }

    .leaderboard-win-count {
        background: #fff7ed;
        color: #b45309;
        border-color: #fed7aa;
    }

    .leaderboard-count-badge.is-zero {
        background: #f1f5f9;
        color: #64748b;
        border-color: #e2e8f0;
    }

    .leaderboard-page .score-pill {
        min-width: 46px;
        min-height: 32px;
        padding: 7px 14px;
        border-radius: 999px;
        font-size: .92rem;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
    }

    .leaderboard-scroll-top-btn {
        position: fixed;
        right: 18px;
        bottom: 22px;
        width: 42px;
        height: 42px;
        border-radius: 50%;
        border: 1px solid #bfdbfe;
        background: #0d6efd;
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        z-index: 5000;
        box-shadow: 0 10px 24px rgba(13, 110, 253, .28);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateY(10px);
        transition: transform .2s ease, opacity .2s ease, visibility .2s ease, background .2s ease;
    }

        .leaderboard-scroll-top-btn:hover,
        .leaderboard-scroll-top-btn:focus {
            background: #0b5ed7;
            color: #ffffff;
        }

        .leaderboard-scroll-top-btn.show {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
            transform: translateY(0);
        }

            .leaderboard-scroll-top-btn.show:hover,
            .leaderboard-scroll-top-btn.show:focus {
                transform: translateY(-2px);
            }

        .leaderboard-scroll-top-btn i {
            font-size: 1.15rem;
            line-height: 1;
        }

    @@media (max-width: 767.98px) {
        .leaderboard-topbar {
            margin-bottom: 12px !important;
        }

        .leaderboard-header-line {
            align-items: center;
        }

        .leaderboard-title-pill {
            font-size: 1.35rem;
            gap: 7px;
        }

            .leaderboard-title-pill i {
                font-size: 1.35rem;
            }

        .leaderboard-header-actions {
            gap: 6px;
        }

        .leaderboard-back-btn {
            padding: 6px 10px;
            font-size: .82rem;
            min-height: 34px;
        }

        .leaderboard-download-icon-btn {
            width: 38px;
            height: 38px;
            min-width: 38px;
            font-size: .88rem;
        }

            .leaderboard-download-icon-btn .bi-file-earmark-excel {
                font-size: .76rem;
            }

        .leaderboard-range-filter {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 6px;
            margin-bottom: 12px;
        }

            .leaderboard-range-filter .btn {
