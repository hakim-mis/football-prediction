    @@media (max-width: 390px) {
        .leaderboard-title-pill {
            font-size: 1.18rem;
        }

            .leaderboard-title-pill i {
                font-size: 1.18rem;
            }

        .leaderboard-back-btn {
            padding-left: 9px;
            padding-right: 9px;
            font-size: .78rem;
        }

        .leaderboard-download-icon-btn {
            width: 36px;
            height: 36px;
            min-width: 36px;
            font-size: .82rem;
        }

            .leaderboard-download-icon-btn .bi-file-earmark-excel {
                font-size: .72rem;
            }

        .leaderboard-range-filter .btn {
            font-size: .7rem;
            padding-left: 3px;
            padding-right: 3px;
        }

        .leaderboard-sl-badge {
            min-width: 34px;
            height: 28px;
            font-size: .74rem;
        }

        .leaderboard-count-badge {
            padding: 5px 7px;
            min-width: 34px;
            font-size: .72rem;
        }

