                padding: 6px 5px;
            }

        .leaderboard-search-toolbar {
            display: flex !important;
            flex-direction: row !important;
            align-items: center !important;
            gap: 6px !important;
            width: 100%;
        }

        .leaderboard-search-box {
            flex: 1 1 auto;
            min-width: 0;
        }

            .leaderboard-search-box .form-control {
                min-height: 40px;
                font-size: .86rem;
                padding-left: 34px;
                padding-right: 38px;
            }

        .leaderboard-search-icon {
            left: 10px;
        }

        .leaderboard-search-clear-inside {
            right: 7px;
            width: 24px;
            height: 24px;
            font-size: .82rem;
        }

        .leaderboard-count-badge {
            padding: 5px 8px;
            min-width: 36px;
            font-size: .75rem;
        }

        .leaderboard-page .score-pill {
            min-width: 42px;
            min-height: 30px;
            padding: 7px 12px;
            font-size: .85rem;
        }

        .leaderboard-scroll-top-btn {
            right: 14px;
            bottom: 16px;
            width: 38px;
            height: 38px;
            z-index: 6000;
        }

            .leaderboard-scroll-top-btn i {
