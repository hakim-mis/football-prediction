@model List<LeaderboardUserViewModel>

@{
    ViewData["Title"] = "Leaderboard";

    var selectedRange = (string?)ViewBag.Range ?? "1-50";
    var startSl = ViewBag.StartSl is int slValue ? slValue : 1;

    string UserPhoto(string? path)
    {
        return string.IsNullOrWhiteSpace(path)
            ? Url.Content("~/img/default-avatar.svg")
            : Url.Content("~/" + path.TrimStart('/', '~'));
    }

    string BuildMobileInfo(string? designation, string? department)
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(designation))
        {
            parts.Add(designation);
        }

        if (!string.IsNullOrWhiteSpace(department))
        {
            parts.Add(department);
        }

        return parts.Any() ? string.Join(" • ", parts) : "-";
    }

    int RankSortValue(string? rankText)
    {
        if (string.IsNullOrWhiteSpace(rankText))
        {
            return 999999;
        }

        var clean = rankText.Replace("#", "").Trim();

        return int.TryParse(clean, out var value)
            ? value
            : 999999;
    }
}

<style>
    .leaderboard-topbar {
        width: 100%;
    }

    .leaderboard-header-line {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        width: 100%;
    }

    .leaderboard-title-pill {
        margin: 0;
        padding: 0 !important;
        border: 0 !important;
        background: transparent !important;
        box-shadow: none !important;
        border-radius: 0 !important;
        color: #111827 !important;
        font-size: 1.55rem;
        font-weight: 900;
        line-height: 1.15;
        letter-spacing: -.02em;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
