@model List<LeaderboardUserViewModel>

@{
    ViewData["Title"] = "Leaderboard";

    string UserPhoto(string? path)
    {
        return string.IsNullOrWhiteSpace(path)
            ? Url.Content("~/img/default-avatar.svg")
            : Url.Content("~/" + path.TrimStart('/', '~'));
    }

    string BuildMobileInfo(string? designation, string? department)
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(designation))
        {
            parts.Add(designation);
        }

        if (!string.IsNullOrWhiteSpace(department))
        {
            parts.Add(department);
        }

        return parts.Any() ? string.Join(" • ", parts) : "-";
    }
}

<div class="dashboard-card leaderboard-page p-3 p-md-4 mb-4">

    <div class="leaderboard-topbar mb-4">
        <div>
            <span class="pill">
                <i class="bi bi-trophy"></i>
                Ranking Table
            </span>

            <h1 class="h3 fw-bold mt-3 mb-1">
                Leaderboard Top 100
            </h1>

            <p class="text-muted mb-0 small">
                Users with the same score share the same rank. Users with zero score show No rank.
            </p>
        </div>

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-outline-primary btn-sm">
            <i class="bi bi-arrow-left"></i>
            Back to Dashboard
        </a>
    </div>

    <div class="leaderboard-search-toolbar mb-3">
        <div class="leaderboard-search-box">
            <span>
                <i class="bi bi-search"></i>
            </span>

            <input type="search"
                   id="leaderboardSearch"
                   class="form-control"
                   placeholder="Search name, designation, department, rank, score..." />
        </div>

        <button type="button"
                class="btn btn-outline-secondary btn-sm"
                id="leaderboardClearSearch">
            <i class="bi bi-x-circle"></i>
            Clear
        </button>
    </div>

    <div class="leaderboard-table-wrap">
        <table class="table table-clean table-hover align-middle mb-0 leaderboard-table">
            <thead>
                <tr>
                    <th>Rank</th>
                    <th>Player</th>
                    <th class="leaderboard-designation-col">Designation</th>
                    <th class="leaderboard-department-col">Department</th>
                    <th>Total Score</th>
                    <th>Exact</th>
                    <th>Detail</th>
                </tr>
            </thead>

            <tbody id="leaderboardTableBody">
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            No active user found.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var user in Model)
                    {
                        var designation = string.IsNullOrWhiteSpace(user.Designation) ? "-" : user.Designation;
                        var department = string.IsNullOrWhiteSpace(user.Department) ? "-" : user.Department;
                        var searchableText = $"{user.RankText} {user.FullName} {designation} {department} {user.TotalScore} {user.ExactPredictionCount}".ToLowerInvariant();

                        <tr class="leaderboard-row-item"
                            data-search="@searchableText">
                            <td>
                                <span class="rank-circle">
                                    @user.RankText
                                </span>
                            </td>

                            <td>
                                <div class="leaderboard-player-cell">
                                    <img src="@UserPhoto(user.PhotoPath)"
                                         class="leaderboard-avatar"
                                         alt="@user.FullName" />

                                    <div class="leaderboard-player-info">
                                        <strong>@user.FullName</strong>

                                        <div class="small text-muted d-md-none leaderboard-mobile-subtitle">
                                            @BuildMobileInfo(user.Designation, user.Department)
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <td class="leaderboard-designation-col">
                                @designation
                            </td>

                            <td class="leaderboard-department-col">
                                @department
                            </td>

                            <td>
                                <span class="score-pill">
                                    @user.TotalScore pts
                                </span>
                            </td>

                            <td>
                                <span class="badge @(user.ExactPredictionCount == 0 ? "text-bg-secondary" : "text-bg-primary")">
                                    @user.ExactPredictionCount
                                </span>
                            </td>

                            <td>
                                <a asp-controller="Dashboard"
                                   asp-action="UserPredictionDetail"
                                   asp-route-userId="@user.UserId"
                                   class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-list-check"></i>
                                    Detail
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div id="leaderboardNoResult" class="empty-state mt-3 d-none">
        No player matched your search.
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            bindLeaderboardSearch();
        });

        function bindLeaderboardSearch() {
            const searchInput = document.getElementById("leaderboardSearch");
            const clearButton = document.getElementById("leaderboardClearSearch");

            if (searchInput) {
                searchInput.addEventListener("input", function () {
                    applyLeaderboardSearch();
                });
            }

            if (clearButton) {
                clearButton.addEventListener("click", function () {
                    if (searchInput) {
                        searchInput.value = "";
                        searchInput.focus();
                    }

                    applyLeaderboardSearch();
                });
            }
        }

        function applyLeaderboardSearch() {
            const searchInput = document.getElementById("leaderboardSearch");
            const noResult = document.getElementById("leaderboardNoResult");

            const searchText = searchInput
                ? searchInput.value.trim().toLowerCase()
                : "";

            let visibleCount = 0;

            document.querySelectorAll(".leaderboard-row-item").forEach(function (row) {
                const searchable = row.getAttribute("data-search") || "";
                const shouldShow = searchText === "" || searchable.includes(searchText);

                if (shouldShow) {
                    row.classList.remove("d-none");
                    visibleCount++;
                } else {
                    row.classList.add("d-none");
                }
            });

            if (noResult) {
                if (visibleCount === 0 && document.querySelectorAll(".leaderboard-row-item").length > 0) {
                    noResult.classList.remove("d-none");
                } else {
                    noResult.classList.add("d-none");
                }
            }
        }
    </script>
}