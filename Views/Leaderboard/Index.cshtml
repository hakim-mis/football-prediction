</style>

<div class="dashboard-card leaderboard-page p-3 p-md-4 mb-4">

    <div class="leaderboard-topbar mb-3">

        <div class="leaderboard-header-line">
            <span class="leaderboard-title-pill">
                <i class="bi bi-trophy"></i>
                Leaderboard
            </span>

            <div class="leaderboard-header-actions">
                <a asp-action="DownloadExcel"
                   class="leaderboard-download-icon-btn"
                   title="Download All Leaderboard"
                   aria-label="Download All Leaderboard">
                    <i class="bi bi-download"></i>
                    <i class="bi bi-file-earmark-excel"></i>
                </a>

                <button type="button"
                        class="btn btn-outline-primary btn-sm leaderboard-back-btn"
                        onclick="goBackOrDashboard()">
                    <i class="bi bi-arrow-left"></i>
                    Back
                </button>
            </div>
        </div>

    </div>

    <div class="leaderboard-range-filter">
        <a asp-action="Index"
           asp-route-range="1-50"
           class="btn btn-sm leaderboard-range-link @(selectedRange == "1-50" ? "btn-primary" : "btn-outline-primary")">
            1 - 50
        </a>

        <a asp-action="Index"
           asp-route-range="51-100"
           class="btn btn-sm leaderboard-range-link @(selectedRange == "51-100" ? "btn-primary" : "btn-outline-primary")">
            51 - 100
        </a>

        <a asp-action="Index"
           asp-route-range="101-150"
           class="btn btn-sm leaderboard-range-link @(selectedRange == "101-150" ? "btn-primary" : "btn-outline-primary")">
            101 - 150
        </a>

        <a asp-action="Index"
           asp-route-range="rest"
           class="btn btn-sm leaderboard-range-link @(selectedRange == "rest" ? "btn-primary" : "btn-outline-primary")">
            Rest
        </a>
    </div>

    <div class="leaderboard-search-toolbar mb-3">
        <div class="leaderboard-search-box">
            <span class="leaderboard-search-icon">
                <i class="bi bi-search"></i>
            </span>

            <input type="search"
                   id="leaderboardSearch"
                   class="form-control leaderboard-search-no-native-clear"
                   placeholder="Search" />

            <button type="button"
                    class="leaderboard-search-clear-inside"
                    id="leaderboardClearSearch"
                    title="Clear search"
                    aria-label="Clear search">
                <i class="bi bi-x-circle"></i>
            </button>
        </div>
    </div>

    <div class="leaderboard-table-wrap">
        <table class="table table-clean table-hover align-middle mb-0 leaderboard-table">
            <thead>
                <tr>
                    <th>
                        <button type="button"
                                class="leaderboard-sort-btn"
                                data-sort-field="sl"
                                data-sort-direction="asc">
                            SL
                            <i class="bi bi-arrow-down-up"></i>
                        </button>
                    </th>

                    <th>
                        <button type="button"
                                class="leaderboard-sort-btn"
                                data-sort-field="rank"
                                data-sort-direction="asc">
                            Rank
                            <i class="bi bi-arrow-down-up"></i>
                        </button>
                    </th>

                    <th>Player</th>

                    <th class="leaderboard-designation-col">
                        Designation
                    </th>

                    <th class="leaderboard-department-col">
                        Department
                    </th>

                    <th>
                        <button type="button"
                                class="leaderboard-sort-btn"
                                data-sort-field="score"
                                data-sort-direction="desc">
                            Total Score
                            <i class="bi bi-arrow-down-up"></i>
                        </button>
                    </th>

                    <th>
                        <button type="button"
                                class="leaderboard-sort-btn"
                                data-sort-field="exact"
                                data-sort-direction="desc">
                            Exact
                            <i class="bi bi-arrow-down-up"></i>
                        </button>
                    </th>

                    <th>
                        <button type="button"
                                class="leaderboard-sort-btn"
                                data-sort-field="win"
                                data-sort-direction="desc">
                            Win
                            <i class="bi bi-arrow-down-up"></i>
                        </button>
                    </th>

                    <th>Detail</th>
                </tr>
            </thead>

            <tbody id="leaderboardTableBody">
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">
                            No active user found.
                        </td>
                    </tr>
                }
                else
                {
                    var index = 0;

                    foreach (var user in Model)
                    {
                        var sl = startSl + index;
                        var designation = string.IsNullOrWhiteSpace(user.Designation) ? "-" : user.Designation;
                        var department = string.IsNullOrWhiteSpace(user.Department) ? "-" : user.Department;
                        var rankSort = RankSortValue(user.RankText);

                        var searchableText = $"{sl} {user.RankText} {user.FullName} {designation} {department} {user.TotalScore} {user.ExactPredictionCount} {user.WinMatchPredictionCount}".ToLowerInvariant();

                        <tr class="leaderboard-row-item"
                            data-search="@searchableText"
                            data-sl="@sl"
                            data-rank="@rankSort"
                            data-score="@user.TotalScore"
                            data-exact="@user.ExactPredictionCount"
                            data-win="@user.WinMatchPredictionCount">

                            <td>
                                <span class="leaderboard-sl-badge">
                                    @sl
                                </span>
                            </td>

                            <td>
                                <span class="rank-circle">
                                    @user.RankText
                                </span>
                            </td>

                            <td>
                                <div class="leaderboard-player-cell">
                                    <img src="@UserPhoto(user.PhotoPath)"
                                         class="leaderboard-avatar"
                                         alt="@user.FullName" />

                                    <div class="leaderboard-player-info">
                                        <strong>@user.FullName</strong>

                                        <div class="small text-muted d-md-none leaderboard-mobile-subtitle">
                                            @BuildMobileInfo(user.Designation, user.Department)
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <td class="leaderboard-designation-col">
                                @designation
                            </td>

                            <td class="leaderboard-department-col">
                                @department
                            </td>

                            <td>
                                <span class="score-pill">
                                    @user.TotalScore
                                </span>
                            </td>

                            <td>
                                <span class="leaderboard-count-badge leaderboard-exact-count @(user.ExactPredictionCount == 0 ? "is-zero" : "")">
                                    @user.ExactPredictionCount
                                </span>
                            </td>

                            <td>
                                <span class="leaderboard-count-badge leaderboard-win-count @(user.WinMatchPredictionCount == 0 ? "is-zero" : "")">
                                    @user.WinMatchPredictionCount
                                </span>
                            </td>

                            <td>
                                <a asp-controller="Dashboard"
                                   asp-action="UserPredictionDetail"
                                   asp-route-userId="@user.UserId"
                                   class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-list-check"></i>
                                    Detail
                                </a>
                            </td>
                        </tr>

                        index++;
                    }
                }
            </tbody>
        </table>
    </div>

    <div id="leaderboardNoResult" class="empty-state mt-3 d-none">
        No player matched your search.
    </div>

</div>

<button type="button"
        class="leaderboard-scroll-top-btn"
        id="leaderboardScrollTopBtn"
        title="Go to top"
        aria-label="Go to top">
    <i class="bi bi-arrow-up"></i>
</button>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            bindLeaderboardSearch();
            bindLeaderboardSort();
            bindLeaderboardRangeLinks();
            bindLeaderboardScrollTopButton();
            sortLeaderboardRows("score", "desc");
            highlightDefaultSortIcon();
        });

        function bindLeaderboardScrollTopButton() {
            const scrollTopButton = document.getElementById("leaderboardScrollTopBtn");

            if (!scrollTopButton) {
                return;
            }

            const possibleScrollContainers = [
                window,
                document.documentElement,
                document.body,
                document.querySelector("main"),
                document.querySelector(".main-content"),
                document.querySelector(".content-wrapper"),
                document.querySelector(".page-content"),
                document.querySelector(".dashboard-content"),
                document.querySelector(".app-main"),
                document.querySelector(".container-fluid"),
                document.querySelector(".container"),
                document.querySelector(".layout-main")
            ].filter(Boolean);

            function getScrollTopValue() {
                let maxScrollTop = window.scrollY || document.documentElement.scrollTop || document.body.scrollTop || 0;

                possibleScrollContainers.forEach(function (container) {
                    if (container === window) {
                        return;
                    }

                    if (container.scrollTop && container.scrollTop > maxScrollTop) {
                        maxScrollTop = container.scrollTop;
                    }
                });

                return maxScrollTop;
            }

            function toggleScrollTopButton() {
                if (getScrollTopValue() > 220) {
                    scrollTopButton.classList.add("show");
                } else {
                    scrollTopButton.classList.remove("show");
                }
            }

            possibleScrollContainers.forEach(function (container) {
                if (container === window) {
                    window.addEventListener("scroll", toggleScrollTopButton, { passive: true });
                } else {
                    container.addEventListener("scroll", toggleScrollTopButton, { passive: true });
                }
            });

            window.addEventListener("touchmove", toggleScrollTopButton, { passive: true });
            window.addEventListener("resize", toggleScrollTopButton, { passive: true });

            scrollTopButton.addEventListener("click", function () {
                window.scrollTo({
                    top: 0,
                    behavior: "smooth"
                });

                document.documentElement.scrollTo({
                    top: 0,
                    behavior: "smooth"
                });

                document.body.scrollTo({
                    top: 0,
                    behavior: "smooth"
                });

                possibleScrollContainers.forEach(function (container) {
                    if (container === window) {
                        return;
                    }

                    if (typeof container.scrollTo === "function") {
                        container.scrollTo({
                            top: 0,
                            behavior: "smooth"
                        });
                    } else {
                        container.scrollTop = 0;
                    }
                });
            });

            toggleScrollTopButton();
        }

        function bindLeaderboardRangeLinks() {
            document.querySelectorAll(".leaderboard-range-link").forEach(function (link) {
                link.addEventListener("click", function (e) {
                    e.preventDefault();

                    const url = link.getAttribute("href");

                    if (url) {
                        window.location.replace(url);
                    }
                });
            });
        }

        function goBackOrDashboard() {
            if (window.history.length > 1) {
                window.history.back();
                return;
            }

            window.location.href = '@Url.Action("Index", "Dashboard", new { area = "" })';
        }

        function bindLeaderboardSearch() {
            const searchInput = document.getElementById("leaderboardSearch");
            const clearButton = document.getElementById("leaderboardClearSearch");

            if (searchInput) {
                searchInput.addEventListener("input", function () {
                    applyLeaderboardSearch();
                });
            }

            if (clearButton) {
                clearButton.addEventListener("click", function () {
                    if (searchInput) {
                        searchInput.value = "";
                        searchInput.focus();
                    }

                    applyLeaderboardSearch();
                });
            }
        }

        function bindLeaderboardSort() {
            document.querySelectorAll(".leaderboard-sort-btn").forEach(function (button) {
                button.addEventListener("click", function () {
                    const field = button.getAttribute("data-sort-field");
                    const currentDirection = button.getAttribute("data-sort-direction") || "asc";
                    const nextDirection = currentDirection === "asc" ? "desc" : "asc";

                    button.setAttribute("data-sort-direction", nextDirection);

                    sortLeaderboardRows(field, nextDirection);
                    applyLeaderboardSearch();
                    updateSortIcons(button, nextDirection);
                });
            });
        }

        function getRowNumber(row, field) {
            return parseInt(row.getAttribute("data-" + field) || "0");
        }

        function compareRowsByField(a, b, field, direction) {
            const aValue = getRowNumber(a, field);
            const bValue = getRowNumber(b, field);

            if (aValue === bValue) {
                return 0;
            }

            if (direction === "asc") {
                return aValue - bValue;
            }

            return bValue - aValue;
        }

        function compareRowsByPriority(a, b, primaryField, direction) {
            let priorityFields = [];

            if (primaryField === "score") {
                priorityFields = ["score", "exact", "win", "rank"];
            } else if (primaryField === "exact") {
                priorityFields = ["exact", "score", "win", "rank"];
            } else if (primaryField === "win") {
                priorityFields = ["win", "score", "exact", "rank"];
            } else {
                priorityFields = [primaryField];
            }

            for (let i = 0; i < priorityFields.length; i++) {
                const field = priorityFields[i];

                let fieldDirection = direction;

                if (field === "rank" || field === "sl") {
                    fieldDirection = "asc";
                }

                const result = compareRowsByField(a, b, field, fieldDirection);

                if (result !== 0) {
                    return result;
                }
            }

            return compareRowsByField(a, b, "sl", "asc");
        }

        function sortLeaderboardRows(field, direction) {
            const tbody = document.getElementById("leaderboardTableBody");

            if (!tbody || !field) {
                return;
            }

            const rows = Array.from(tbody.querySelectorAll(".leaderboard-row-item"));

            rows.sort(function (a, b) {
                return compareRowsByPriority(a, b, field, direction);
            });

            rows.forEach(function (row) {
                tbody.appendChild(row);
            });
        }

        function updateSortIcons(activeButton, direction) {
            document.querySelectorAll(".leaderboard-sort-btn i").forEach(function (icon) {
                icon.className = "bi bi-arrow-down-up";
            });

            const activeIcon = activeButton.querySelector("i");

            if (activeIcon) {
                activeIcon.className = direction === "asc"
                    ? "bi bi-arrow-up-short"
                    : "bi bi-arrow-down-short";
            }
        }

        function highlightDefaultSortIcon() {
            const scoreButton = document.querySelector('.leaderboard-sort-btn[data-sort-field="score"]');

            if (!scoreButton) {
                return;
            }

            scoreButton.setAttribute("data-sort-direction", "asc");
            updateSortIcons(scoreButton, "desc");
        }

        function applyLeaderboardSearch() {
            const searchInput = document.getElementById("leaderboardSearch");
            const noResult = document.getElementById("leaderboardNoResult");

            const searchText = searchInput
                ? searchInput.value.trim().toLowerCase()
                : "";

            let visibleCount = 0;

            document.querySelectorAll(".leaderboard-row-item").forEach(function (row) {
                const searchable = row.getAttribute("data-search") || "";
                const shouldShow = searchText === "" || searchable.includes(searchText);

                if (shouldShow) {
                    row.classList.remove("d-none");
                    visibleCount++;
                } else {
                    row.classList.add("d-none");
                }
            });

            if (noResult) {
                if (visibleCount === 0 && document.querySelectorAll(".leaderboard-row-item").length > 0) {
                    noResult.classList.remove("d-none");
                } else {
                    noResult.classList.add("d-none");
                }
            }
        }
    </script>
}