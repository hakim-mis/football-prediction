@model FootballPredictionGame.ViewModels.AdIndexViewModel

@{
    ViewData["Title"] = "Ads";

    string ActiveBadge(bool active)
    {
        return active ? "text-bg-success" : "text-bg-secondary";
    }

    string ActiveText(bool active)
    {
        return active ? "Active" : "Inactive";
    }

    decimal Rate(int numerator, int denominator)
    {
        return denominator <= 0 ? 0 : Math.Round((decimal)numerator * 100 / denominator, 1);
    }
}

<style>
    .ads-admin-page {
        overflow: hidden;
    }

    .ads-admin-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

    .ads-admin-title {
        min-width: 0;
        flex: 1 1 420px;
    }

    .ads-title-heading {
        margin: 0;
        padding: 0 !important;
        border: 0 !important;
        background: transparent !important;
        box-shadow: none !important;
        border-radius: 0 !important;
        color: #111827 !important;
        font-size: 1.55rem;
        font-weight: 900;
        line-height: 1.15;
        letter-spacing: -.02em;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .ads-title-heading i {
            color: #0d6efd;
            font-size: 1.55rem;
            line-height: 1;
        }

    .ads-admin-title h2 {
        line-height: 1.2;
        margin-bottom: 6px;
    }

    .ads-admin-title p {
        line-height: 1.45;
        max-width: 780px;
    }

    .ads-admin-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
        flex-wrap: wrap;
        flex: 0 0 auto;
    }

        .ads-admin-actions .btn {
            border-radius: 999px;
            font-weight: 800;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
        }

    .ads-summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 18px;
    }

    .ads-summary-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 14px;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 10px 24px rgba(15, 23, 42, .06);
        min-width: 0;
    }

    .ads-summary-icon {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #eef6ff;
        color: #0d6efd;
        flex: 0 0 auto;
        font-size: 1.15rem;
    }

    .ads-summary-card span {
        display: block;
        color: #64748b;
        font-size: .78rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .02em;
        line-height: 1.2;
    }

    .ads-summary-card strong {
        display: block;
        color: #111827;
        font-size: 1.08rem;
        line-height: 1.2;
        word-break: break-word;
    }

    .ads-filter-row {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 14px;
    }

    .ads-filter-btn {
        border-radius: 999px;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        white-space: nowrap;
    }

    .ads-search-toolbar {
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        gap: 8px;
        width: 100%;
        margin-bottom: 14px;
    }

    .ads-search-box {
        position: relative;
        flex: 1 1 auto;
        min-width: 0;
    }

    .ads-search-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #64748b;
        z-index: 2;
    }

    .ads-search-box .form-control {
        padding-left: 38px;
        padding-right: 42px;
        min-height: 42px;
        border-radius: 12px;
        width: 100%;
    }

    .ads-search-clear {
        position: absolute;
        right: 9px;
        top: 50%;
        transform: translateY(-50%);
        width: 26px;
        height: 26px;
        border: 0;
        border-radius: 50%;
        background: #ffffff;
        color: #dc2626;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        z-index: 3;
        padding: 0;
        font-size: .9rem;
        line-height: 1;
    }

        .ads-search-clear:hover,
        .ads-search-clear:focus {
            background: #fee2e2;
            color: #b91c1c;
        }

    .ads-search-no-native-clear::-webkit-search-decoration,
    .ads-search-no-native-clear::-webkit-search-cancel-button,
    .ads-search-no-native-clear::-webkit-search-results-button,
    .ads-search-no-native-clear::-webkit-search-results-decoration {
        display: none;
        -webkit-appearance: none;
    }

    .ads-search-no-native-clear {
        appearance: none;
        -webkit-appearance: none;
    }

    .ads-table-wrap {
        width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        background: #ffffff;
    }

        .ads-table-wrap::-webkit-scrollbar {
            height: 8px;
        }

        .ads-table-wrap::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 999px;
        }

        .ads-table-wrap::-webkit-scrollbar-thumb {
            background: #bfdbfe;
            border-radius: 999px;
        }

            .ads-table-wrap::-webkit-scrollbar-thumb:hover {
                background: #93c5fd;
            }

    .ads-table {
        min-width: 1100px;
        width: 100%;
        margin-bottom: 0;
        white-space: nowrap;
    }

        .ads-table th,
        .ads-table td {
            vertical-align: middle;
        }

    .ads-sort-btn {
        border: 0;
        background: transparent;
        padding: 0;
        font-weight: 800;
        color: #111827;
        display: inline-flex;
        align-items: center;
        gap: 3px;
        white-space: nowrap;
    }

        .ads-sort-btn:hover,
        .ads-sort-btn:focus {
            color: #0d6efd;
        }

    .ads-title-cell {
        min-width: 280px;
        max-width: 360px;
        white-space: normal;
    }

    .ads-title-main {
        display: block;
        font-weight: 900;
        color: #111827;
        line-height: 1.25;
        word-break: break-word;
    }

    .ads-description-text {
        max-width: 360px;
        line-height: 1.35;
        word-break: break-word;
    }

    .ads-action-row {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 7px;
        flex-wrap: nowrap;
        min-width: 450px;
        white-space: nowrap;
    }

        .ads-action-row .btn,
        .ads-action-row form button {
            border-radius: 999px;
            font-weight: 800;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
            white-space: nowrap;
        }

        .ads-action-row form {
            display: inline-flex;
            margin: 0;
        }

    @@media (max-width: 1199.98px) {
        .ads-summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .ads-admin-actions {
            justify-content: flex-start;
        }

        .ads-table {
            min-width: 1080px;
        }
    }

    @@media (max-width: 767.98px) {
        .ads-admin-page {
            padding: 14px !important;
            border-radius: 16px;
        }

        .ads-admin-header {
            display: grid;
            grid-template-columns: minmax(0, auto) minmax(0, 1fr);
            align-items: center;
            column-gap: 8px;
            row-gap: 8px;
            margin-bottom: 14px;
        }

        .ads-admin-title {
            grid-column: 1;
            grid-row: 1;
            width: auto;
            min-width: 0;
            flex: none;
        }

        .ads-title-heading {
            font-size: 1.22rem;
            gap: 7px;
        }

            .ads-title-heading i {
                font-size: 1.22rem;
            }

        .ads-admin-title h2,
        .ads-admin-title p {
            display: none !important;
        }

        .ads-admin-actions {
            grid-column: 2;
            grid-row: 1;
            width: 100%;
            display: flex;
            flex-direction: row;
            flex-wrap: nowrap;
            align-items: center;
            justify-content: flex-end;
            gap: 5px;
            margin-top: 0;
            overflow-x: auto;
            overflow-y: hidden;
            -webkit-overflow-scrolling: touch;
            padding-bottom: 1px;
        }

            .ads-admin-actions .btn {
                flex: 0 0 auto;
                min-height: 32px;
                padding: 6px 8px;
                border-radius: 999px;
                font-size: .68rem;
                gap: 3px;
            }

                .ads-admin-actions .btn span {
                    display: inline !important;
                }

                .ads-admin-actions .btn i {
                    margin: 0;
                    font-size: .76rem;
                }

        .ads-summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 8px;
            margin-bottom: 14px;
        }

        .ads-summary-card {
            padding: 10px;
            border-radius: 14px;
            gap: 8px;
        }

        .ads-summary-icon {
            width: 36px;
            height: 36px;
            border-radius: 12px;
            font-size: 1rem;
        }

        .ads-summary-card span {
            font-size: .66rem;
        }

        .ads-summary-card strong {
            font-size: .92rem;
        }

        .ads-filter-row {
            display: flex;
            flex-direction: row;
            flex-wrap: nowrap;
            gap: 6px;
            margin-bottom: 12px;
            overflow-x: auto;
            overflow-y: hidden;
            -webkit-overflow-scrolling: touch;
            padding-bottom: 2px;
        }

            .ads-filter-row .btn {
                flex: 0 0 auto;
                font-size: .78rem;
                padding: 7px 12px;
            }

        .ads-search-toolbar {
            gap: 6px !important;
            margin-bottom: 12px;
        }

        .ads-search-box .form-control {
            min-height: 40px;
            font-size: .86rem;
            padding-left: 34px;
            padding-right: 38px;
        }

        .ads-search-icon {
            left: 10px;
        }

        .ads-search-clear {
            right: 7px;
            width: 24px;
            height: 24px;
            font-size: .82rem;
        }

        .ads-table-wrap {
            overflow-x: auto;
            overflow-y: hidden;
            border-radius: 14px;
            border: 1px solid #e2e8f0;
            background: #ffffff;
        }

        .ads-table {
            min-width: 1040px;
            width: 1040px;
            white-space: nowrap;
        }

            .ads-table th,
            .ads-table td {
                padding: 10px 9px;
                font-size: .82rem;
            }

        .ads-title-cell {
            min-width: 240px;
            max-width: 260px;
            white-space: normal;
        }

        .ads-title-main {
            font-size: .9rem;
        }

        .ads-description-text {
            max-width: 250px;
            font-size: .78rem;
        }

        .ads-action-row {
            min-width: 260px;
            justify-content: flex-start;
            flex-wrap: nowrap;
            gap: 10px;
        }

            .ads-action-row .btn,
            .ads-action-row form button {
                width: 34px;
                height: 34px;
                min-width: 34px;
                min-height: 34px;
                padding: 0;
                border-radius: 999px;
                font-size: .82rem;
                gap: 0;
            }

                .ads-action-row .btn span,
                .ads-action-row form button span {
                    display: none;
                }

                .ads-action-row .btn i,
                .ads-action-row form button i {
                    margin: 0;
                }
    }

    @@media (max-width: 420px) {
        .ads-title-heading {
            font-size: 1.1rem;
        }

            .ads-title-heading i {
                font-size: 1.1rem;
            }

        .ads-admin-actions {
            gap: 4px;
        }

            .ads-admin-actions .btn {
                min-height: 30px;
                padding: 6px 7px;
                font-size: .62rem;
            }

                .ads-admin-actions .btn i {
                    font-size: .7rem;
                }

        .ads-filter-row .btn {
            font-size: .72rem;
            padding-left: 10px;
            padding-right: 10px;
        }

        .ads-summary-card {
            padding: 9px;
        }

        .ads-summary-icon {
            width: 32px;
            height: 32px;
            border-radius: 10px;
            font-size: .92rem;
        }

        .ads-summary-card span {
            font-size: .6rem;
        }

        .ads-summary-card strong {
            font-size: .86rem;
        }

        .ads-table {
            min-width: 1000px;
            width: 1000px;
        }

            .ads-table th,
            .ads-table td {
                font-size: .78rem;
                padding: 9px 8px;
            }

        .ads-action-row {
            min-width: 250px;
            gap: 9px;
        }

            .ads-action-row .btn,
            .ads-action-row form button {
                width: 32px;
                height: 32px;
                min-width: 32px;
                min-height: 32px;
                font-size: .76rem;
            }
    }

    @@media (max-width: 360px) {
        .ads-admin-header {
            grid-template-columns: 1fr;
        }

        .ads-admin-title {
            grid-column: 1;
            grid-row: 1;
        }

        .ads-admin-actions {
            grid-column: 1;
            grid-row: 2;
            justify-content: flex-start;
        }

        .ads-summary-grid {
            grid-template-columns: 1fr;
        }

        .ads-table {
            min-width: 980px;
            width: 980px;
        }
    }
</style>

<div class="dashboard-card ads-admin-page p-3 p-md-4 mb-4">

    <div class="ads-admin-header">
        <div class="ads-admin-title">
            <h1 class="ads-title-heading">
                <i class="bi bi-megaphone"></i>
                Ads
            </h1>

            <h2 class="h3 fw-bold mt-3 mb-1">
                Ads Campaigns
            </h2>

            <p class="text-muted mb-0">
                Manage promotional ad campaigns, slides, targeting, schedule, and performance analytics.
            </p>
        </div>

        <div class="ads-admin-actions">
            <a asp-area="Admin"
               asp-controller="AutomationSettings"
               asp-action="Index"
               class="btn btn-outline-primary btn-sm"
               title="Settings">
                <i class="bi bi-robot"></i>
                <span>Settings</span>
            </a>

            <a asp-action="Analytics"
               class="btn btn-outline-secondary btn-sm"
               title="Analytics">
                <i class="bi bi-graph-up"></i>
                <span>Analytics</span>
            </a>

            <a asp-action="Create"
               class="btn btn-primary btn-sm"
               title="Create Ad">
                <i class="bi bi-plus-circle"></i>
                <span>Create</span>
            </a>
        </div>
    </div>

    <div class="ads-summary-grid">

        <div class="ads-summary-card">
            <div class="ads-summary-icon">
                <i class="bi bi-megaphone"></i>
            </div>
            <div>
                <span>Total Ads</span>
                <strong>@Model.TotalAds</strong>
            </div>
        </div>

        <div class="ads-summary-card">
            <div class="ads-summary-icon">
                <i class="bi bi-toggle-on"></i>
            </div>
            <div>
                <span>Active Ads</span>
                <strong>@Model.ActiveAds</strong>
            </div>
        </div>

        <div class="ads-summary-card">
            <div class="ads-summary-icon">
                <i class="bi bi-images"></i>
            </div>
            <div>
                <span>Total Slides</span>
                <strong>@Model.TotalSlides</strong>
            </div>
        </div>

        <div class="ads-summary-card">
            <div class="ads-summary-icon">
                <i class="bi bi-eye"></i>
            </div>
            <div>
                <span>Impressions</span>
                <strong>@Model.TotalImpressions</strong>
            </div>
        </div>

    </div>

    <div class="ads-filter-row">
        <button type="button" class="btn btn-sm btn-primary ads-filter-btn" data-filter="all">
            <i class="bi bi-grid"></i>
            All
        </button>

        <button type="button" class="btn btn-sm btn-outline-success ads-filter-btn" data-filter="active">
            <i class="bi bi-check-circle"></i>
            Active
        </button>

        <button type="button" class="btn btn-sm btn-outline-secondary ads-filter-btn" data-filter="inactive">
            <i class="bi bi-pause-circle"></i>
            Inactive
        </button>
    </div>

    <div class="ads-search-toolbar">
        <div class="ads-search-box">
            <span class="ads-search-icon">
                <i class="bi bi-search"></i>
            </span>

            <input type="search"
                   id="adsSearch"
                   class="form-control ads-search-no-native-clear"
                   placeholder="Search ads..." />

            <button type="button"
                    class="ads-search-clear"
                    id="adsClearSearch"
                    title="Clear search"
                    aria-label="Clear search">
                <i class="bi bi-x-circle"></i>
            </button>
        </div>
    </div>

    <div class="ads-table-wrap">
        <table class="table table-clean table-hover align-middle ads-table">
            <thead>
                <tr>
                    <th>
                        <button type="button" class="ads-sort-btn" data-sort-field="title" data-sort-direction="asc">
                            Ad
                            <i class="bi bi-arrow-down-up"></i>
                        </button>
                    </th>

                    <th>
                        <button type="button" class="ads-sort-btn" data-sort-field="active" data-sort-direction="desc">
                            Status
                            <i class="bi bi-arrow-down-up"></i>
                        </button>
                    </th>

                    <th>
                        <button type="button" class="ads-sort-btn" data-sort-field="slides" data-sort-direction="desc">
                            Slides
                            <i class="bi bi-arrow-down-up"></i>
                        </button>
                    </th>

                    <th>
                        <button type="button" class="ads-sort-btn" data-sort-field="priority" data-sort-direction="desc">
                            Priority
                            <i class="bi bi-arrow-down-up"></i>
                        </button>
                    </th>

                    <th>
                        <button type="button" class="ads-sort-btn" data-sort-field="order" data-sort-direction="asc">
                            Order
                            <i class="bi bi-arrow-down-up"></i>
                        </button>
                    </th>

                    <th>
                        <button type="button" class="ads-sort-btn" data-sort-field="impression" data-sort-direction="desc">
                            Impression
                            <i class="bi bi-arrow-down-up"></i>
                        </button>
                    </th>

                    <th>CTR</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>

            <tbody id="adsTableBody">
                @if (Model.Ads == null || !Model.Ads.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            No ad campaign found.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var ad in Model.Ads)
                    {
                        var searchable = $"{ad.Title} {ad.Description} {ad.SelectionMode} {ActiveText(ad.IsActive)} {ad.Priority} {ad.DisplayOrder}".ToLowerInvariant();
                        var ctr = Rate(ad.ClickCount, ad.ImpressionCount);

                        <tr class="ads-row"
                            data-search="@searchable"
                            data-filter="@(ad.IsActive ? "active" : "inactive")"
                            data-title="@ad.Title.ToLowerInvariant()"
                            data-active="@(ad.IsActive ? 1 : 0)"
                            data-slides="@ad.SlideCount"
                            data-priority="@ad.Priority"
                            data-order="@ad.DisplayOrder"
                            data-impression="@ad.ImpressionCount">

                            <td class="ads-title-cell">
                                <strong class="ads-title-main">@ad.Title</strong>

                                @if (!string.IsNullOrWhiteSpace(ad.Description))
                                {
                                    <div class="small text-muted ads-description-text">
                                        @ad.Description
                                    </div>
                                }

                                <div class="small text-muted">
                                    Mode: @ad.SelectionMode
                                </div>
                            </td>

                            <td>
                                <span class="badge @ActiveBadge(ad.IsActive)">
                                    @ActiveText(ad.IsActive)
                                </span>
                            </td>

                            <td>
                                <span class="badge text-bg-primary">
                                    @ad.ActiveSlideCount / @ad.SlideCount
                                </span>
                            </td>

                            <td>
                                <span class="badge text-bg-info">
                                    @ad.Priority
                                </span>
                            </td>

                            <td>
                                <span class="badge text-bg-light text-muted">
                                    @ad.DisplayOrder
                                </span>
                            </td>

                            <td>
                                <strong>@ad.ImpressionCount</strong>
                                <div class="small text-muted">
                                    Skip @ad.SkipCount, Click @ad.ClickCount
                                </div>
                            </td>

                            <td>
                                <span class="badge @(ctr > 0 ? "text-bg-success" : "text-bg-secondary")">
                                    @ctr%
                                </span>
                            </td>

                            <td class="text-end">
                                <div class="ads-action-row">

                                    <a asp-action="Preview"
                                       asp-route-id="@ad.Id"
                                       class="btn btn-outline-success btn-sm"
                                       title="Preview">
                                        <i class="bi bi-eye"></i>
                                        <span>Preview</span>
                                    </a>

                                    <a asp-action="Slides"
                                       asp-route-adId="@ad.Id"
                                       class="btn btn-outline-primary btn-sm"
                                       title="Slides">
                                        <i class="bi bi-images"></i>
                                        <span>Slides</span>
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@ad.Id"
                                       class="btn btn-outline-secondary btn-sm"
                                       title="Edit">
                                        <i class="bi bi-pencil"></i>
                                        <span>Edit</span>
                                    </a>

                                    <form asp-action="ToggleActive"
                                          asp-route-id="@ad.Id"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm @(ad.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                                title="@(ad.IsActive ? "Disable" : "Enable")">
                                            <i class="bi @(ad.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                            <span>@(ad.IsActive ? "Disable" : "Enable")</span>
                                        </button>
                                    </form>

                                    <form asp-action="Delete"
                                          asp-route-id="@ad.Id"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-outline-danger btn-sm"
                                                title="Delete"
                                                onclick="return confirm('Delete this ad campaign? Slides will be hidden too.');">
                                            <i class="bi bi-trash"></i>
                                            <span>Delete</span>
                                        </button>
                                    </form>

                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div id="adsNoResult" class="empty-state mt-3 d-none">
        No ad matched your search/filter.
    </div>

</div>

@section Scripts {
    <script>
        let activeAdsFilter = "all";

        document.addEventListener("DOMContentLoaded", function () {
            bindAdsSearch();
            bindAdsFilters();
            bindAdsSort();
        });

        function bindAdsFilters() {
            document.querySelectorAll(".ads-filter-btn").forEach(function (button) {
                button.addEventListener("click", function () {
                    activeAdsFilter = button.getAttribute("data-filter") || "all";

                    document.querySelectorAll(".ads-filter-btn").forEach(function (btn) {
                        btn.classList.remove(
                            "btn-primary",
                            "btn-success",
                            "btn-secondary",
                            "btn-outline-primary",
                            "btn-outline-success",
                            "btn-outline-secondary"
                        );

                        if (btn.getAttribute("data-filter") === "active") {
                            btn.classList.add("btn-outline-success");
                        } else if (btn.getAttribute("data-filter") === "inactive") {
                            btn.classList.add("btn-outline-secondary");
                        } else {
                            btn.classList.add("btn-outline-primary");
                        }
                    });

                    if (activeAdsFilter === "active") {
                        button.classList.remove("btn-outline-success");
                        button.classList.add("btn-success");
                    } else if (activeAdsFilter === "inactive") {
                        button.classList.remove("btn-outline-secondary");
                        button.classList.add("btn-secondary");
                    } else {
                        button.classList.remove("btn-outline-primary");
                        button.classList.add("btn-primary");
                    }

                    applyAdsSearchAndFilter();
                });
            });
        }

        function bindAdsSearch() {
            const searchInput = document.getElementById("adsSearch");
            const clearButton = document.getElementById("adsClearSearch");

            if (searchInput) {
                searchInput.addEventListener("input", applyAdsSearchAndFilter);
            }

            if (clearButton) {
                clearButton.addEventListener("click", function () {
                    if (searchInput) {
                        searchInput.value = "";
                        searchInput.focus();
                    }

                    applyAdsSearchAndFilter();
                });
            }
        }

        function applyAdsSearchAndFilter() {
            const searchInput = document.getElementById("adsSearch");
            const noResult = document.getElementById("adsNoResult");

            const searchText = searchInput ? searchInput.value.trim().toLowerCase() : "";

            let visibleCount = 0;

            document.querySelectorAll(".ads-row").forEach(function (row) {
                const searchable = row.getAttribute("data-search") || "";
                const filter = row.getAttribute("data-filter") || "";

                const matchesFilter = activeAdsFilter === "all" || filter === activeAdsFilter;
                const matchesSearch = searchText === "" || searchable.includes(searchText);

                if (matchesFilter && matchesSearch) {
                    row.classList.remove("d-none");
                    visibleCount++;
                } else {
                    row.classList.add("d-none");
                }
            });

            if (noResult) {
                if (visibleCount === 0 && document.querySelectorAll(".ads-row").length > 0) {
                    noResult.classList.remove("d-none");
                } else {
                    noResult.classList.add("d-none");
                }
            }
        }

        function bindAdsSort() {
            document.querySelectorAll(".ads-sort-btn").forEach(function (button) {
                button.addEventListener("click", function () {
                    const field = button.getAttribute("data-sort-field");
                    const currentDirection = button.getAttribute("data-sort-direction") || "asc";
                    const nextDirection = currentDirection === "asc" ? "desc" : "asc";

                    button.setAttribute("data-sort-direction", nextDirection);

                    sortAdsRows(field, nextDirection);
                    applyAdsSearchAndFilter();
                    updateAdsSortIcons(button, nextDirection);
                });
            });
        }

        function sortAdsRows(field, direction) {
            const tbody = document.getElementById("adsTableBody");

            if (!tbody || !field) {
                return;
            }

            const rows = Array.from(tbody.querySelectorAll(".ads-row"));

            rows.sort(function (a, b) {
                if (field === "title") {
                    const aText = a.getAttribute("data-title") || "";
                    const bText = b.getAttribute("data-title") || "";

                    return direction === "asc"
                        ? aText.localeCompare(bText)
                        : bText.localeCompare(aText);
                }

                const aValue = parseInt(a.getAttribute("data-" + field) || "0");
                const bValue = parseInt(b.getAttribute("data-" + field) || "0");

                return direction === "asc"
                    ? aValue - bValue
                    : bValue - aValue;
            });

            rows.forEach(function (row) {
                tbody.appendChild(row);
            });
        }

        function updateAdsSortIcons(activeButton, direction) {
            document.querySelectorAll(".ads-sort-btn i").forEach(function (icon) {
                icon.className = "bi bi-arrow-down-up";
            });

            const activeIcon = activeButton.querySelector("i");

            if (activeIcon) {
                activeIcon.className = direction === "asc"
                    ? "bi bi-arrow-up-short"
                    : "bi bi-arrow-down-short";
            }
        }
    </script>
}