@model FootballPredictionGame.ViewModels.AdFormViewModel
@using FootballPredictionGame.Models

@{
    ViewData["Title"] = "Create Ad";
}

<style>
    .ad-form-page {
        overflow: hidden;
    }

    .ad-form-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

    .ad-form-title-block {
        min-width: 0;
        flex: 1 1 auto;
    }

    .ad-form-title-heading {
        margin: 0;
        padding: 0 !important;
        border: 0 !important;
        background: transparent !important;
        box-shadow: none !important;
        border-radius: 0 !important;
        color: #111827 !important;
        font-size: 1.55rem;
        font-weight: 900;
        line-height: 1.15;
        letter-spacing: -.02em;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .ad-form-title-heading i {
            color: #0d6efd;
            font-size: 1.55rem;
            line-height: 1;
        }

    .ad-form-main-title {
        line-height: 1.2;
        margin-bottom: 6px;
    }

    .ad-form-subtitle {
        line-height: 1.45;
        max-width: 780px;
    }

    .ad-form-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
        flex: 0 0 auto;
    }

        .ad-form-actions .btn {
            border-radius: 999px;
            font-weight: 800;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
        }

    .ad-form-section {
        border: 1px solid #e2e8f0;
        background: #ffffff;
        border-radius: 18px;
        padding: 16px;
        margin-bottom: 14px;
        box-shadow: 0 10px 24px rgba(15, 23, 42, .05);
    }

    .ad-form-section-title {
        font-size: .82rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .03em;
        color: #0f172a;
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 14px;
    }

    .ad-form-field label,
    .ad-form-switch label {
        font-weight: 700;
        color: #334155;
        font-size: .88rem;
    }

    .ad-form-field .form-control,
    .ad-form-field .form-select {
        border-radius: 12px;
        min-height: 42px;
    }

    .ad-form-field textarea.form-control {
        min-height: 90px;
        resize: vertical;
    }

    .ad-form-switch {
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 11px 12px;
        min-height: 48px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

        .ad-form-switch .form-check {
            margin-bottom: 0;
            min-height: 0;
            display: flex;
            align-items: center;
        }

        .ad-form-switch .form-check-input {
            width: 2.4em;
            height: 1.25em;
            margin-top: 0;
            cursor: pointer;
        }

            .ad-form-switch .form-check-input:checked {
                background-color: #198754;
                border-color: #198754;
            }

    .ad-form-footer {
        position: sticky;
        bottom: 0;
        z-index: 10;
        background: rgba(255, 255, 255, .94);
        backdrop-filter: blur(10px);
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 14px;
        margin-top: 16px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        box-shadow: 0 -10px 28px rgba(15, 23, 42, .06);
    }

        .ad-form-footer .btn {
            border-radius: 999px;
            font-weight: 800;
            min-width: 140px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

    @@media (max-width: 991.98px) {
        .ad-form-header {
            gap: 12px;
        }
    }

    @@media (max-width: 767.98px) {
        .ad-form-page {
            padding: 14px !important;
            border-radius: 16px;
        }

        .ad-form-header {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            align-items: center;
            gap: 8px;
            margin-bottom: 14px;
        }

        .ad-form-title-block {
            grid-column: 1;
            grid-row: 1;
            min-width: 0;
        }

        .ad-form-title-heading {
            font-size: 1.22rem;
            gap: 7px;
        }

            .ad-form-title-heading i {
                font-size: 1.22rem;
            }

        .ad-form-main-title,
        .ad-form-subtitle {
            display: none !important;
        }

        .ad-form-actions {
            grid-column: 2;
            grid-row: 1;
            align-items: center;
            justify-content: flex-end;
        }

            .ad-form-actions .btn {
                min-height: 34px;
                padding: 6px 12px;
                font-size: .78rem;
                border-radius: 999px;
            }

        .ad-form-section {
            padding: 14px;
            border-radius: 16px;
            margin-bottom: 12px;
        }

        .ad-form-section-title {
            font-size: .76rem;
            margin-bottom: 12px;
        }

        .ad-form-field label,
        .ad-form-switch label {
            font-size: .84rem;
        }

        .ad-form-field .form-control,
        .ad-form-field .form-select {
            min-height: 40px;
            font-size: .86rem;
        }

        .ad-form-switch {
            min-height: 44px;
            padding: 10px;
        }

        .ad-form-footer {
            flex-direction: column;
            border-radius: 16px;
            padding: 12px;
            gap: 8px;
        }

            .ad-form-footer .btn {
                width: 100%;
                min-width: 0;
                min-height: 40px;
                font-size: .88rem;
            }
    }

    @@media (max-width: 420px) {
        .ad-form-title-heading {
            font-size: 1.1rem;
        }

            .ad-form-title-heading i {
                font-size: 1.1rem;
            }

        .ad-form-actions .btn {
            padding-left: 10px;
            padding-right: 10px;
            font-size: .74rem;
        }

        .ad-form-section {
            padding: 12px;
        }

        .ad-form-section-title {
            font-size: .72rem;
        }

        .ad-form-field label,
        .ad-form-switch label {
            font-size: .8rem;
        }

        .ad-form-switch {
            gap: 8px;
        }
    }

    @@media (max-width: 350px) {
        .ad-form-header {
            grid-template-columns: 1fr;
            align-items: flex-start;
        }

        .ad-form-title-block {
            grid-column: 1;
            grid-row: 1;
        }

        .ad-form-actions {
            grid-column: 1;
            grid-row: 2;
            justify-content: flex-start;
            margin-top: 4px;
        }
    }
</style>

<div class="dashboard-card ad-form-page p-3 p-md-4 mb-4">

    <div class="ad-form-header">
        <div class="ad-form-title-block">
            <h1 class="ad-form-title-heading">
                <i class="bi bi-plus-circle"></i>
                New Ad
            </h1>

            <h2 class="h3 fw-bold mt-3 mb-1 ad-form-main-title">
                Create Ad Campaign
            </h2>

            <p class="text-muted mb-0 ad-form-subtitle">
                Create a new ad campaign and then add one or more slides.
            </p>
        </div>

        <div class="ad-form-actions">
            <a asp-action="Index" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-arrow-left"></i>
                Back to Ads
            </a>
        </div>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="ad-form-section">
            <div class="ad-form-section-title">
                <i class="bi bi-card-text"></i>
                Basic Information
            </div>

            <div class="row g-3">
                <div class="col-md-8 ad-form-field">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" placeholder="Example: World Cup Prediction Promo" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="col-md-4 ad-form-field">
                    <label asp-for="SelectionMode" class="form-label"></label>
                    <select asp-for="SelectionMode"
                            asp-items="Html.GetEnumSelectList<AdSelectionMode>()"
                            class="form-select">
                    </select>
                    <span asp-validation-for="SelectionMode" class="text-danger small"></span>
                </div>

                <div class="col-12 ad-form-field">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Short campaign description"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="col-md-4 ad-form-field">
                    <label asp-for="DisplayOrder" class="form-label"></label>
                    <input asp-for="DisplayOrder" type="number" class="form-control" />
                    <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                </div>

                <div class="col-md-4 ad-form-field">
                    <label asp-for="Priority" class="form-label"></label>
                    <input asp-for="Priority" type="number" min="0" max="100" class="form-control" />
                    <span asp-validation-for="Priority" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <div class="ad-form-switch mt-md-4">
                        <label asp-for="IsActive"></label>
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" />
                        </div>
                    </div>
                    <span asp-validation-for="IsActive" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="ad-form-section">
            <div class="ad-form-section-title">
                <i class="bi bi-calendar-range"></i>
                Schedule
            </div>

            <div class="row g-3">
                <div class="col-md-6 ad-form-field">
                    <label asp-for="StartAt" class="form-label"></label>
                    <input asp-for="StartAt" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
                    <span asp-validation-for="StartAt" class="text-danger small"></span>
                </div>

                <div class="col-md-6 ad-form-field">
                    <label asp-for="EndAt" class="form-label"></label>
                    <input asp-for="EndAt" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
                    <span asp-validation-for="EndAt" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="ad-form-section">
            <div class="ad-form-section-title">
                <i class="bi bi-display"></i>
                Platform Targeting
            </div>

            <div class="row g-3">
                <div class="col-md-4">
                    <div class="ad-form-switch">
                        <label asp-for="ShowOnDesktop"></label>
                        <div class="form-check form-switch">
                            <input asp-for="ShowOnDesktop" class="form-check-input" />
                        </div>
                    </div>
                    <span asp-validation-for="ShowOnDesktop" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <div class="ad-form-switch">
                        <label asp-for="ShowOnTablet"></label>
                        <div class="form-check form-switch">
                            <input asp-for="ShowOnTablet" class="form-check-input" />
                        </div>
                    </div>
                    <span asp-validation-for="ShowOnTablet" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <div class="ad-form-switch">
                        <label asp-for="ShowOnMobile"></label>
                        <div class="form-check form-switch">
                            <input asp-for="ShowOnMobile" class="form-check-input" />
                        </div>
                    </div>
                    <span asp-validation-for="ShowOnMobile" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="ad-form-section">
            <div class="ad-form-section-title">
                <i class="bi bi-people"></i>
                Audience Targeting
            </div>

            <div class="row g-3">
                <div class="col-md-4">
                    <div class="ad-form-switch">
                        <label asp-for="ShowToGuests"></label>
                        <div class="form-check form-switch">
                            <input asp-for="ShowToGuests" class="form-check-input" />
                        </div>
                    </div>
                    <span asp-validation-for="ShowToGuests" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <div class="ad-form-switch">
                        <label asp-for="ShowToUsers"></label>
                        <div class="form-check form-switch">
                            <input asp-for="ShowToUsers" class="form-check-input" />
                        </div>
                    </div>
                    <span asp-validation-for="ShowToUsers" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <div class="ad-form-switch">
                        <label asp-for="ShowToAdmins"></label>
                        <div class="form-check form-switch">
                            <input asp-for="ShowToAdmins" class="form-check-input" />
                        </div>
                    </div>
                    <span asp-validation-for="ShowToAdmins" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="ad-form-section">
            <div class="ad-form-section-title">
                <i class="bi bi-window-stack"></i>
                Page Targeting
            </div>

            <div class="row g-3">
                <div class="col-md-4">
                    <div class="ad-form-switch">
                        <label asp-for="ShowOnDashboard"></label>
                        <div class="form-check form-switch">
                            <input asp-for="ShowOnDashboard" class="form-check-input" />
                        </div>
                    </div>
                    <span asp-validation-for="ShowOnDashboard" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <div class="ad-form-switch">
                        <label asp-for="ShowOnPredictionScore"></label>
                        <div class="form-check form-switch">
                            <input asp-for="ShowOnPredictionScore" class="form-check-input" />
                        </div>
                    </div>
                    <span asp-validation-for="ShowOnPredictionScore" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <div class="ad-form-switch">
                        <label asp-for="ShowOnLeaderboard"></label>
                        <div class="form-check form-switch">
                            <input asp-for="ShowOnLeaderboard" class="form-check-input" />
                        </div>
                    </div>
                    <span asp-validation-for="ShowOnLeaderboard" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <div class="ad-form-switch">
                        <label asp-for="ShowOnRules"></label>
                        <div class="form-check form-switch">
                            <input asp-for="ShowOnRules" class="form-check-input" />
                        </div>
                    </div>
                    <span asp-validation-for="ShowOnRules" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <div class="ad-form-switch">
                        <label asp-for="ShowOnLoginRegister"></label>
                        <div class="form-check form-switch">
                            <input asp-for="ShowOnLoginRegister" class="form-check-input" />
                        </div>
                    </div>
                    <span asp-validation-for="ShowOnLoginRegister" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="ad-form-section">
            <div class="ad-form-section-title">
                <i class="bi bi-lightning-charge"></i>
                Smart Rules
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="ad-form-switch">
                        <label asp-for="ShowAfterPredictionSubmit"></label>
                        <div class="form-check form-switch">
                            <input asp-for="ShowAfterPredictionSubmit" class="form-check-input" />
                        </div>
                    </div>
                    <span asp-validation-for="ShowAfterPredictionSubmit" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <div class="ad-form-switch">
                        <label asp-for="ShowOnlyIfUserHasNoUpcomingPrediction"></label>
                        <div class="form-check form-switch">
                            <input asp-for="ShowOnlyIfUserHasNoUpcomingPrediction" class="form-check-input" />
                        </div>
                    </div>
                    <span asp-validation-for="ShowOnlyIfUserHasNoUpcomingPrediction" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="ad-form-section">
            <div class="ad-form-section-title">
                <i class="bi bi-link-45deg"></i>
                Default Call-to-Action
            </div>

            <div class="row g-3">
                <div class="col-md-4 ad-form-field">
                    <label asp-for="ButtonText" class="form-label"></label>
                    <input asp-for="ButtonText" class="form-control" placeholder="Learn More" />
                    <span asp-validation-for="ButtonText" class="text-danger small"></span>
                </div>

                <div class="col-md-8 ad-form-field">
                    <label asp-for="ButtonUrl" class="form-label"></label>
                    <input asp-for="ButtonUrl" class="form-control" placeholder="https://example.com" />
                    <span asp-validation-for="ButtonUrl" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="ad-form-footer">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-x-circle"></i>
                Cancel
            </a>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i>
                Create Ad
            </button>
        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}