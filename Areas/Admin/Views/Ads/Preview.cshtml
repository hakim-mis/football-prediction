@model FootballPredictionGame.ViewModels.AdsRenderViewModel

@{
    ViewData["Title"] = "Preview Ad";
}

<style>
    .ad-preview-page {
        overflow: hidden;
    }

    .ad-preview-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

    .ad-preview-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

        .ad-preview-actions .btn {
            border-radius: 999px;
            font-weight: 700;
            white-space: nowrap;
        }

    .ad-preview-panel {
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        background: linear-gradient(135deg, #eff6ff, #ffffff);
        padding: 18px;
        box-shadow: 0 12px 28px rgba(15, 23, 42, .06);
    }

        .ad-preview-panel h2 {
            font-size: 1.1rem;
            font-weight: 900;
            margin-bottom: 8px;
            color: #0f172a;
        }

        .ad-preview-panel p {
            color: #475569;
            margin-bottom: 14px;
            line-height: 1.5;
        }

    .ad-preview-note {
        border: 1px dashed #93c5fd;
        background: #ffffff;
        border-radius: 16px;
        padding: 12px;
        color: #334155;
        font-size: .9rem;
    }

    .ad-preview-start-btn {
        border-radius: 999px;
        font-weight: 800;
        padding-left: 18px;
        padding-right: 18px;
    }

    @@media (max-width: 767.98px) {
        .ad-preview-page {
            padding: 14px !important;
            border-radius: 16px;
        }

        .ad-preview-header h1 {
            font-size: 1.25rem;
        }

        .ad-preview-actions {
            width: 100%;
        }

            .ad-preview-actions .btn {
                flex: 1 1 auto;
                font-size: .82rem;
            }

        .ad-preview-start-btn {
            width: 100%;
        }
    }
</style>

<div class="dashboard-card ad-preview-page p-3 p-md-4 mb-4">

    <div class="ad-preview-header">
        <div>
            <span class="pill">
                <i class="bi bi-eye"></i>
                Preview
            </span>

            <h1 class="h3 fw-bold mt-3 mb-1">
                Preview Ad
            </h1>

            <p class="text-muted mb-0">
                Preview campaign: <strong>@Model.AdTitle</strong>
            </p>
        </div>

        <div class="ad-preview-actions">
            <a asp-action="Slides"
               asp-route-adId="@Model.AdId"
               class="btn btn-outline-primary btn-sm">
                <i class="bi bi-images"></i>
                Slides
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i>
                Back to Ads
            </a>
        </div>
    </div>

    <div class="ad-preview-panel">
        <h2>
            <i class="bi bi-play-circle"></i>
            Preview Mode
        </h2>

        <p>
            The ad preview opens automatically on this page. Preview mode does not count impressions, clicks, skips, completion, or daily/session frequency.
        </p>

        <div class="ad-preview-note mb-3">
            <strong>Note:</strong>
            Audio may still require a tap on the Sound button because browsers block automatic sound until user interaction.
        </div>

        <button type="button"
                class="btn btn-primary ad-preview-start-btn"
                onclick="window.location.reload();">
            <i class="bi bi-arrow-clockwise"></i>
            Replay Preview
        </button>
    </div>

</div>

@await Html.PartialAsync("~/Views/Shared/Components/Ads/Default.cshtml", Model)