@model FootballPredictionGame.ViewModels.AdSlideFormViewModel

@{
    ViewData["Title"] = "Create Ad Slide";
}

<style>
    .ad-slide-form-page {
        overflow: hidden;
    }

    .ad-slide-form-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

    .ad-slide-form-actions .btn {
        border-radius: 999px;
        font-weight: 700;
    }

    .ad-slide-form-section {
        border: 1px solid #e2e8f0;
        background: #ffffff;
        border-radius: 18px;
        padding: 16px;
        margin-bottom: 14px;
        box-shadow: 0 10px 24px rgba(15, 23, 42, .05);
    }

    .ad-slide-form-section-title {
        font-size: .82rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .03em;
        color: #0f172a;
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 14px;
    }

    .ad-slide-form-field label,
    .ad-slide-form-switch label {
        font-weight: 700;
        color: #334155;
        font-size: .88rem;
    }

    .ad-slide-form-field .form-control {
        border-radius: 12px;
        min-height: 42px;
    }

    .ad-slide-form-switch {
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 11px 12px;
        min-height: 48px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .ad-slide-form-footer {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 14px;
        background: #ffffff;
    }

        .ad-slide-form-footer .btn {
            border-radius: 999px;
            font-weight: 800;
            min-width: 140px;
        }

    @@media (max-width: 767.98px) {
        .ad-slide-form-page {
            padding: 14px !important;
            border-radius: 16px;
        }

        .ad-slide-form-header h1 {
            font-size: 1.25rem;
        }

        .ad-slide-form-footer {
            flex-direction: column;
        }

            .ad-slide-form-footer .btn {
                width: 100%;
            }
    }
</style>

<div class="dashboard-card ad-slide-form-page p-3 p-md-4 mb-4">

    <div class="ad-slide-form-header">
        <div>
            <span class="pill">
                <i class="bi bi-plus-circle"></i>
                New Slide
            </span>

            <h1 class="h3 fw-bold mt-3 mb-1">
                Create Slide
            </h1>

            <p class="text-muted mb-0">
                Add a new slide for <strong>@Model.AdTitle</strong>.
            </p>
        </div>

        <div class="ad-slide-form-actions">
            <a asp-action="Slides"
               asp-route-adId="@Model.AdId"
               class="btn btn-outline-primary btn-sm">
                <i class="bi bi-arrow-left"></i>
                Back to Slides
            </a>
        </div>
    </div>

    <form asp-action="CreateSlide" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <input asp-for="AdId" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="ad-slide-form-section">
            <div class="ad-slide-form-section-title">
                <i class="bi bi-card-text"></i>
                Slide Content
            </div>

            <div class="row g-3">
                <div class="col-md-8 ad-slide-form-field">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" placeholder="Slide title" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="col-md-4 ad-slide-form-field">
                    <label asp-for="DisplayOrder" class="form-label"></label>
                    <input asp-for="DisplayOrder" class="form-control" type="number" />
                    <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                </div>

                <div class="col-12 ad-slide-form-field">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Slide description"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="ad-slide-form-section">
            <div class="ad-slide-form-section-title">
                <i class="bi bi-image"></i>
                Media
            </div>

            <div class="row g-3">
                <div class="col-md-6 ad-slide-form-field">
                    <label asp-for="ImageFile" class="form-label"></label>
                    <input asp-for="ImageFile" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp,image/*" />
                    <div class="small text-muted mt-1">
                        Recommended: WebP/JPG, max 1 MB.
                    </div>
                    <span asp-validation-for="ImageFile" class="text-danger small"></span>
                </div>

                <div class="col-md-6 ad-slide-form-field">
                    <label asp-for="AudioFile" class="form-label"></label>
                    <input asp-for="AudioFile" class="form-control" type="file" accept=".mp3,audio/mpeg" />
                    <div class="small text-muted mt-1">
                        Optional voice/audio, MP3 only, max 2 MB.
                    </div>
                    <span asp-validation-for="AudioFile" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="ad-slide-form-section">
            <div class="ad-slide-form-section-title">
                <i class="bi bi-link-45deg"></i>
                CTA & Timing
            </div>

            <div class="row g-3">
                <div class="col-md-4 ad-slide-form-field">
                    <label asp-for="ButtonText" class="form-label"></label>
                    <input asp-for="ButtonText" class="form-control" placeholder="Learn More" />
                    <span asp-validation-for="ButtonText" class="text-danger small"></span>
                </div>

                <div class="col-md-8 ad-slide-form-field">
                    <label asp-for="ButtonUrl" class="form-label"></label>
                    <input asp-for="ButtonUrl" class="form-control" placeholder="https://example.com" />
                    <span asp-validation-for="ButtonUrl" class="text-danger small"></span>
                </div>

                <div class="col-md-6 ad-slide-form-field">
                    <label asp-for="DurationSeconds" class="form-label"></label>
                    <input asp-for="DurationSeconds" class="form-control" type="number" min="1" max="60" />
                    <span asp-validation-for="DurationSeconds" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <div class="ad-slide-form-switch mt-md-4">
                        <label asp-for="IsActive"></label>
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="ad-slide-form-footer">
            <a asp-action="Slides"
               asp-route-adId="@Model.AdId"
               class="btn btn-outline-secondary">
                <i class="bi bi-x-circle"></i>
                Cancel
            </a>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i>
                Create Slide
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}