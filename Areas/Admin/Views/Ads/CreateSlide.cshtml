@model FootballPredictionGame.ViewModels.AdSlideFormViewModel

@{
    ViewData["Title"] = "Create Ad Slide";
}

<style>
    .ad-slide-form-page {
        overflow: hidden;
    }

    .ad-slide-form-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

    .ad-slide-form-title-block {
        min-width: 0;
        flex: 1 1 auto;
    }

    .ad-slide-form-title-heading {
        margin: 0;
        padding: 0 !important;
        border: 0 !important;
        background: transparent !important;
        box-shadow: none !important;
        border-radius: 0 !important;
        color: #111827 !important;
        font-size: 1.55rem;
        font-weight: 900;
        line-height: 1.15;
        letter-spacing: -.02em;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .ad-slide-form-title-heading i {
            color: #0d6efd;
            font-size: 1.55rem;
            line-height: 1;
        }

    .ad-slide-form-main-title {
        line-height: 1.2;
        margin-bottom: 6px;
    }

    .ad-slide-form-subtitle {
        line-height: 1.45;
        max-width: 780px;
    }

    .ad-slide-form-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
        flex: 0 0 auto;
        flex-wrap: wrap;
    }

        .ad-slide-form-actions .btn {
            border-radius: 999px;
            font-weight: 800;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
        }

    .ad-slide-form-section {
        border: 1px solid #e2e8f0;
        background: #ffffff;
        border-radius: 18px;
        padding: 16px;
        margin-bottom: 14px;
        box-shadow: 0 10px 24px rgba(15, 23, 42, .05);
    }

    .ad-slide-form-section-title {
        font-size: .82rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .03em;
        color: #0f172a;
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 14px;
    }

    .ad-slide-form-field label,
    .ad-slide-form-switch label {
        font-weight: 700;
        color: #334155;
        font-size: .88rem;
    }

    .ad-slide-form-field .form-control {
        border-radius: 12px;
        min-height: 42px;
    }

    .ad-slide-form-field textarea.form-control {
        min-height: 90px;
        resize: vertical;
    }

    .ad-slide-form-switch {
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 11px 12px;
        min-height: 48px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

        .ad-slide-form-switch .form-check {
            margin-bottom: 0;
            min-height: 0;
            display: flex;
            align-items: center;
        }

        .ad-slide-form-switch .form-check-input {
            width: 2.4em;
            height: 1.25em;
            margin-top: 0;
            cursor: pointer;
        }

            .ad-slide-form-switch .form-check-input:checked {
                background-color: #198754;
                border-color: #198754;
            }

    .ad-slide-form-footer {
        position: sticky;
        bottom: 0;
        z-index: 10;
        background: rgba(255, 255, 255, .94);
        backdrop-filter: blur(10px);
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 14px;
        margin-top: 16px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        box-shadow: 0 -10px 28px rgba(15, 23, 42, .06);
    }

        .ad-slide-form-footer .btn {
            border-radius: 999px;
            font-weight: 800;
            min-width: 140px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

    @@media (max-width: 991.98px) {
        .ad-slide-form-header {
            gap: 12px;
        }
    }

    @@media (max-width: 767.98px) {
        .ad-slide-form-page {
            padding: 14px !important;
            border-radius: 16px;
        }

        .ad-slide-form-header {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            align-items: center;
            gap: 8px;
            margin-bottom: 14px;
        }

        .ad-slide-form-title-block {
            grid-column: 1;
            grid-row: 1;
            min-width: 0;
        }

        .ad-slide-form-title-heading {
            font-size: 1.22rem;
            gap: 7px;
        }

            .ad-slide-form-title-heading i {
                font-size: 1.22rem;
            }

        .ad-slide-form-main-title,
        .ad-slide-form-subtitle {
            display: none !important;
        }

        .ad-slide-form-actions {
            grid-column: 2;
            grid-row: 1;
            align-items: center;
            justify-content: flex-end;
        }

            .ad-slide-form-actions .btn {
                min-height: 34px;
                padding: 6px 12px;
                font-size: .78rem;
                border-radius: 999px;
            }

        .ad-slide-form-section {
            padding: 14px;
            border-radius: 16px;
            margin-bottom: 12px;
        }

        .ad-slide-form-section-title {
            font-size: .76rem;
            margin-bottom: 12px;
        }

        .ad-slide-form-field label,
        .ad-slide-form-switch label {
            font-size: .84rem;
        }

        .ad-slide-form-field .form-control {
            min-height: 40px;
            font-size: .86rem;
        }

        .ad-slide-form-switch {
            min-height: 44px;
            padding: 10px;
        }

        .ad-slide-form-footer {
            flex-direction: column;
            border-radius: 16px;
            padding: 12px;
            gap: 8px;
        }

            .ad-slide-form-footer .btn {
                width: 100%;
                min-width: 0;
                min-height: 40px;
                font-size: .88rem;
            }
    }

    @@media (max-width: 420px) {
        .ad-slide-form-title-heading {
            font-size: 1.1rem;
        }

            .ad-slide-form-title-heading i {
                font-size: 1.1rem;
            }

        .ad-slide-form-actions .btn {
            padding-left: 10px;
            padding-right: 10px;
            font-size: .74rem;
        }

        .ad-slide-form-section {
            padding: 12px;
        }

        .ad-slide-form-section-title {
            font-size: .72rem;
        }

        .ad-slide-form-field label,
        .ad-slide-form-switch label {
            font-size: .8rem;
        }

        .ad-slide-form-switch {
            gap: 8px;
        }
    }

    @@media (max-width: 350px) {
        .ad-slide-form-header {
            grid-template-columns: 1fr;
            align-items: flex-start;
        }

        .ad-slide-form-title-block {
            grid-column: 1;
            grid-row: 1;
        }

        .ad-slide-form-actions {
            grid-column: 1;
            grid-row: 2;
            justify-content: flex-start;
            margin-top: 4px;
        }
    }
</style>

<div class="dashboard-card ad-slide-form-page p-3 p-md-4 mb-4">

    <div class="ad-slide-form-header">
        <div class="ad-slide-form-title-block">
            <h1 class="ad-slide-form-title-heading">
                <i class="bi bi-plus-circle"></i>
                New Slide
            </h1>

            <h2 class="h3 fw-bold mt-3 mb-1 ad-slide-form-main-title">
                Create Slide
            </h2>

            <p class="text-muted mb-0 ad-slide-form-subtitle">
                Add a new slide for <strong>@Model.AdTitle</strong>.
            </p>
        </div>

        <div class="ad-slide-form-actions">
            <a asp-action="Slides"
               asp-route-adId="@Model.AdId"
               class="btn btn-outline-primary btn-sm">
                <i class="bi bi-arrow-left"></i>
                Back
            </a>
        </div>
    </div>

    <form asp-action="CreateSlide" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <input asp-for="AdId" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="ad-slide-form-section">
            <div class="ad-slide-form-section-title">
                <i class="bi bi-card-text"></i>
                Slide Content
            </div>

            <div class="row g-3">
                <div class="col-md-8 ad-slide-form-field">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" placeholder="Slide title" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="col-md-4 ad-slide-form-field">
                    <label asp-for="DisplayOrder" class="form-label"></label>
                    <input asp-for="DisplayOrder" class="form-control" type="number" />
                    <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                </div>

                <div class="col-12 ad-slide-form-field">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Slide description"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="ad-slide-form-section">
            <div class="ad-slide-form-section-title">
                <i class="bi bi-image"></i>
                Media
            </div>

            <div class="row g-3">
                <div class="col-md-6 ad-slide-form-field">
                    <label asp-for="ImageFile" class="form-label"></label>
                    <input asp-for="ImageFile"
                           class="form-control"
                           type="file"
                           accept=".jpg,.jpeg,.png,.webp,image/*" />
                    <div class="small text-muted mt-1">
                        Recommended: WebP/JPG, max 1 MB.
                    </div>
                    <span asp-validation-for="ImageFile" class="text-danger small"></span>
                </div>

                <div class="col-md-6 ad-slide-form-field">
                    <label asp-for="AudioFile" class="form-label"></label>
                    <input asp-for="AudioFile"
                           class="form-control"
                           type="file"
                           accept=".mp3,audio/mpeg" />
                    <div class="small text-muted mt-1">
                        Optional voice/audio, MP3 only, max 2 MB.
                    </div>
                    <span asp-validation-for="AudioFile" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="ad-slide-form-section">
            <div class="ad-slide-form-section-title">
                <i class="bi bi-link-45deg"></i>
                CTA & Timing
            </div>

            <div class="row g-3">
                <div class="col-md-4 ad-slide-form-field">
                    <label asp-for="ButtonText" class="form-label"></label>
                    <input asp-for="ButtonText" class="form-control" placeholder="Learn More" />
                    <span asp-validation-for="ButtonText" class="text-danger small"></span>
                </div>

                <div class="col-md-8 ad-slide-form-field">
                    <label asp-for="ButtonUrl" class="form-label"></label>
                    <input asp-for="ButtonUrl" class="form-control" placeholder="https://example.com" />
                    <span asp-validation-for="ButtonUrl" class="text-danger small"></span>
                </div>

                <div class="col-md-6 ad-slide-form-field">
                    <label asp-for="DurationSeconds" class="form-label"></label>
                    <input asp-for="DurationSeconds" class="form-control" type="number" min="1" max="60" />
                    <span asp-validation-for="DurationSeconds" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <div class="ad-slide-form-switch mt-md-4">
                        <label asp-for="IsActive"></label>
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" />
                        </div>
                    </div>
                    <span asp-validation-for="IsActive" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="ad-slide-form-footer">
            <a asp-action="Slides"
               asp-route-adId="@Model.AdId"
               class="btn btn-outline-secondary">
                <i class="bi bi-x-circle"></i>
                Cancel
            </a>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i>
                Create Slide
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}