@model AdminDashboardViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Admin Dashboard";

    var userStatusCounts = JsonSerializer.Serialize(Model.UserStatusCounts);
    var fixtureStatusCounts = JsonSerializer.Serialize(Model.FixtureStatusCounts);
    var fixturePublishCounts = JsonSerializer.Serialize(Model.FixturePublishCounts);
    var processingCounts = JsonSerializer.Serialize(Model.ProcessingCounts);
    var predictionCounts = JsonSerializer.Serialize(Model.PredictionCounts);

    var segmentLabels = JsonSerializer.Serialize(Model.SegmentPoints.Select(x => x.SegmentName));
    var segmentPoints = JsonSerializer.Serialize(Model.SegmentPoints.Select(x => x.Points));

    string UserPhoto(string? path)
    {
        return string.IsNullOrWhiteSpace(path)
            ? Url.Content("~/img/default-avatar.svg")
            : Url.Content("~/" + path.TrimStart('/', '~'));
    }
}

<div class="admin-dashboard-page">

    <div class="admin-dashboard-title mb-4">
        <div>
            <span class="pill">
                <i class="bi bi-speedometer2"></i>
                Admin Control Center
            </span>

            <h1 class="h3 fw-bold mt-3 mb-1">
                Dashboard Overview
            </h1>

            <p class="text-muted mb-0 small">
                Manage users, fixtures, predictions, result processing and leaderboard performance.
            </p>
        </div>
    </div>

    <!-- Quick Cards -->
    <div class="admin-stat-grid mb-4">

        <a asp-area="Admin"
           asp-controller="Users"
           asp-action="Index"
           asp-route-status="all"
           class="admin-stat-card stat-card-blue">
            <div class="admin-stat-icon">
                <i class="bi bi-people"></i>
            </div>

            <div class="admin-stat-content">
                <span>Total Users</span>
                <strong>@Model.TotalUsers</strong>
            </div>

            <div class="admin-stat-arrow">
                <i class="bi bi-arrow-right"></i>
            </div>
        </a>

        <a asp-area="Admin"
           asp-controller="Users"
           asp-action="Index"
           asp-route-status="pending"
           class="admin-stat-card stat-card-orange">
            <div class="admin-stat-icon">
                <i class="bi bi-person-exclamation"></i>
            </div>

            <div class="admin-stat-content">
                <span>Pending Users</span>
                <strong>@Model.PendingUsers</strong>
            </div>

            <div class="admin-stat-arrow">
                <i class="bi bi-arrow-right"></i>
            </div>
        </a>

        <a asp-area="Admin"
           asp-controller="Users"
           asp-action="Index"
           asp-route-status="active"
           class="admin-stat-card stat-card-green">
            <div class="admin-stat-icon">
                <i class="bi bi-person-check"></i>
            </div>

            <div class="admin-stat-content">
                <span>Active Users</span>
                <strong>@Model.ActiveUsers</strong>
            </div>

            <div class="admin-stat-arrow">
                <i class="bi bi-arrow-right"></i>
            </div>
        </a>

        <a asp-area="Admin"
           asp-controller="Fixtures"
           asp-action="Index"
           asp-route-filter="all"
           class="admin-stat-card stat-card-pink">
            <div class="admin-stat-icon">
                <i class="bi bi-calendar-event"></i>
            </div>

            <div class="admin-stat-content">
                <span>Fixtures</span>
                <strong>@Model.TotalFixtures</strong>
            </div>

            <div class="admin-stat-arrow">
                <i class="bi bi-arrow-right"></i>
            </div>
        </a>

        <div class ="admin-stat-card stat-card-red admin-stat-info-only">
            <div class="admin-stat-icon">
                <i class="bi bi-eye-slash"></i>
            </div>

            <div class="admin-stat-content">
                <span>Unpublished Fixtures</span>
                <strong>@Model.UnpublishedFixtures</strong>
            </div>

            <div class="admin-stat-arrow">
                <i class="bi bi-info-circle"></i>
            </div>
        </div>

        <div class="admin-stat-card stat-card-live admin-stat-info-only">
            <div class="admin-stat-icon">
                <i class="bi bi-broadcast"></i>
            </div>

            <div class="admin-stat-content">
                <span>Live Fixtures</span>
                <strong>@Model.LiveFixtures</strong>
            </div>

            <div class="admin-stat-arrow">
                <i class="bi bi-info-circle"></i>
            </div>
        </div>

         <div class="admin-stat-card stat-card-slate admin-stat-info-only">
            <div class="admin-stat-icon">
                <i class="bi bi-check2-circle"></i>
            </div>

            <div class="admin-stat-content">
                <span>Finished Fixtures</span>
                <strong>@Model.FinishedFixtures</strong>
            </div>

            <div class="admin-stat-arrow">
                <i class="bi bi-info-circle"></i>
            </div>
         </div>

        <div class="admin-stat-card stat-card-processed admin-stat-info-only">
            <div class="admin-stat-icon">
                <i class="bi bi-cpu"></i>
            </div>

            <div class="admin-stat-content">
                <span>Processed Results</span>
                <strong>@Model.ProcessedResults</strong>
            </div>

            <div class="admin-stat-arrow">
                <i class="bi bi-info-circle"></i>
            </div>
        </div>
      
        <div class="admin-stat-card stat-card-yellow admin-stat-info-only">
            <div class="admin-stat-icon">
                <i class="bi bi-hourglass-split"></i>
            </div>

            <div class="admin-stat-content">
                <span>Pending Process</span>
                <strong>@Model.PendingProcessResults</strong>
            </div>

            <div class="admin-stat-arrow">
                <i class="bi bi-info-circle"></i>
            </div>
        </div>
        <a class="nav-link" href="/admin/jobs" target="_blank" rel="noopener">
            <div class="admin-stat-card stat-card-purple">
                <div class="admin-stat-icon">
                    <i class="bi bi-clock-history"></i>
                </div>

                <div class="admin-stat-content">
                    <span>Background Jobs</span>
                    @* <strong>@Model.TotalPredictions</strong> *@
                    <strong>Running</strong>
                </div>

                <div class="admin-stat-arrow info">
                    <i class="bi bi-arrow-right"></i>
                </div>
            </div>
        </a>
        <a asp-area="Admin"
           asp-controller="LoginTracking"
           asp-action="History"
           class="admin-stat-card stat-card-indigo">
            <div class="admin-stat-icon">
                <i class="bi bi-box-arrow-in-right"></i>
            </div>

            <div class="admin-stat-content">
                <span>Today Logins</span>
                <strong>@Model.TodayLogins</strong>
            </div>

            <div class="admin-stat-arrow">
                <i class="bi bi-arrow-right"></i>
            </div>
        </a>

        <a asp-area="Admin"
           asp-controller="LoginTracking"
           asp-action="ActiveUsers"
           class="admin-stat-card stat-card-teal">
            <div class="admin-stat-icon">
                <i class="bi bi-person-check-fill"></i>
            </div>

            <div class="admin-stat-content">
                <span>Logged-In Users</span>
                <strong>@Model.LoggedInUsers</strong>
            </div>

            <div class="admin-stat-arrow">
                <i class="bi bi-arrow-right"></i>
            </div>
        </a>
        <a asp-area="Admin"
           asp-controller="AutomationSuggestions"
           asp-action="Index"
           class="admin-stat-card stat-card-teal">
            <div class="admin-stat-icon">
                <i class="bi bi-lightbulb"></i>
            </div>

            <div class="admin-stat-content">
                <span>Automation Suggestions</span>
                <strong>@Model.LoggedInUsers</strong>
            </div>

            <div class="admin-stat-arrow">
                <i class="bi bi-arrow-right"></i>
            </div>
        </a>

       @*  <a asp-area="Admin"
           asp-controller="LoginTracking"
           asp-action="ActiveUsers"
           class="nav-link">
            <i class="bi bi-person-check-fill"></i>
            Logged-In Users
        </a>

        <a asp-area="Admin"
           asp-controller="LoginTracking"
           asp-action="History"
           class="nav-link">
            <i class="bi bi-clock-history"></i>
            Login History
        </a>
        <a asp-area="Admin"
           asp-controller="AutomationSuggestions"
           asp-action="Index"
           class="nav-link">
            <i class="bi bi-lightbulb"></i>
            Automation Suggestions
        </a> *@


    </div>

    <!-- Charts -->
    <div class="row g-4 mb-4">

        <div class="col-xl-4 col-lg-6">
            <div class="dashboard-card admin-chart-card p-3 p-md-4">
                <div class="admin-chart-header">
                    <div>
                        <h2 class="h6 fw-bold mb-1">
                            <i class="bi bi-people text-primary"></i>
                            User Status
                        </h2>
                        <p class="small text-muted mb-0">Active, pending and unverified users.</p>
                    </div>
                </div>

                <canvas id="userStatusChart" height="210"></canvas>
            </div>
        </div>

        <div class="col-xl-4 col-lg-6">
            <div class="dashboard-card admin-chart-card p-3 p-md-4">
                <div class="admin-chart-header">
                    <div>
                        <h2 class="h6 fw-bold mb-1">
                            <i class="bi bi-calendar2-week text-primary"></i>
                            Fixture Status
                        </h2>
                        <p class="small text-muted mb-0">Upcoming, live and finished fixtures.</p>
                    </div>
                </div>

                <canvas id="fixtureStatusChart" height="210"></canvas>
            </div>
        </div>

        <div class="col-xl-4 col-lg-6">
            <div class="dashboard-card admin-chart-card p-3 p-md-4">
                <div class="admin-chart-header">
                    <div>
                        <h2 class="h6 fw-bold mb-1">
                            <i class="bi bi-eye text-primary"></i>
                            Publish Status
                        </h2>
                        <p class="small text-muted mb-0">Published vs unpublished fixtures.</p>
                    </div>
                </div>

                <canvas id="publishChart" height="210"></canvas>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="dashboard-card admin-chart-card p-3 p-md-4">
                <div class="admin-chart-header">
                    <div>
                        <h2 class="h6 fw-bold mb-1">
                            <i class="bi bi-cpu text-primary"></i>
                            Result Processing
                        </h2>
                        <p class="small text-muted mb-0">Processed and pending process results.</p>
                    </div>
                </div>

                <canvas id="processingChart" height="160"></canvas>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="dashboard-card admin-chart-card p-3 p-md-4">
                <div class="admin-chart-header">
                    <div>
                        <h2 class="h6 fw-bold mb-1">
                            <i class="bi bi-clipboard-check text-primary"></i>
                            Prediction Processing
                        </h2>
                        <p class="small text-muted mb-0">Processed and pending predictions.</p>
                    </div>
                </div>

                <canvas id="predictionChart" height="160"></canvas>
            </div>
        </div>

    </div>

    <!-- Segment and Top Users -->
    <div class="row g-4">

        <div class="col-xl-7">
            <div class="dashboard-card admin-chart-card p-3 p-md-4">
                <div class="admin-chart-header">
                    <div>
                        <h2 class="h5 fw-bold mb-1">
                            <i class="bi bi-bar-chart text-primary"></i>
                            Segment Points
                        </h2>
                        <p class="small text-muted mb-0">
                            Points earned by group or knockout segment.
                        </p>
                    </div>
                </div>

                @if (!Model.SegmentPoints.Any())
                {
                    <div class="empty-state">
                        No processed segment data found.
                    </div>
                }
                else
                {
                    <canvas id="segmentPointChart" height="150"></canvas>
                }
            </div>
        </div>

        <div class="col-xl-5">
            <div class="dashboard-card p-3 p-md-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h2 class="h5 fw-bold mb-1">
                            <i class="bi bi-trophy text-warning"></i>
                            Top Players
                        </h2>
                        <p class="small text-muted mb-0">
                            Top 10 players by leaderboard score.
                        </p>
                    </div>

                    <a asp-area=""
                       asp-controller="Leaderboard"
                       asp-action="Index"
                       class="btn btn-outline-primary btn-sm">
                        View All
                    </a>
                </div>

                <div class="admin-top-user-list">
                    @if (!Model.TopUsers.Any())
                    {
                        <div class="empty-state">
                            No scored player found.
                        </div>
                    }
                    else
                    {
                        foreach (var user in Model.TopUsers)
                        {
                            <a asp-area=""
                               asp-controller="Dashboard"
                               asp-action="UserPredictionDetail"
                               asp-route-userId="@user.UserId"
                               class="admin-top-user-item">

                                <div class="admin-top-rank">
                                    @user.RankText
                                </div>

                                <img src="@UserPhoto(user.PhotoPath)"
                                     class="admin-top-avatar"
                                     alt="@user.FullName" />

                                <div class="admin-top-info">
                                    <strong>@user.FullName</strong>
                                    <span>
                                        @(string.IsNullOrWhiteSpace(user.Designation) ? "-" : user.Designation)
                                        @if (!string.IsNullOrWhiteSpace(user.Department))
                                        {
                                            <text> • @user.Department</text>
                                        }
                                    </span>
                                </div>

                                <div class="admin-top-score">
                                    @user.TotalScore pts
                                </div>

                            </a>
                        }
                    }
                </div>
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const userStatusCounts = @Html.Raw(userStatusCounts);
        const fixtureStatusCounts = @Html.Raw(fixtureStatusCounts);
        const fixturePublishCounts = @Html.Raw(fixturePublishCounts);
        const processingCounts = @Html.Raw(processingCounts);
        const predictionCounts = @Html.Raw(predictionCounts);
        const segmentLabels = @Html.Raw(segmentLabels);
        const segmentPoints = @Html.Raw(segmentPoints);

        document.addEventListener("DOMContentLoaded", function () {
            renderDoughnutChart(
                "userStatusChart",
                ["Active", "Pending", "Email Not Verified"],
                userStatusCounts
            );

            renderDoughnutChart(
                "fixtureStatusChart",
                ["Upcoming", "Live", "Finished"],
                fixtureStatusCounts
            );

            renderDoughnutChart(
                "publishChart",
                ["Published", "Unpublished"],
                fixturePublishCounts
            );

            renderBarChart(
                "processingChart",
                ["Processed", "Pending Process"],
                processingCounts,
                "Results"
            );

            renderBarChart(
                "predictionChart",
                ["Processed", "Pending"],
                predictionCounts,
                "Predictions"
            );

            if (segmentLabels.length > 0) {
                renderBarChart(
                    "segmentPointChart",
                    segmentLabels,
                    segmentPoints,
                    "Points"
                );
            }
        });

        function renderDoughnutChart(elementId, labels, data) {
            const element = document.getElementById(elementId);

            if (!element) {
                return;
            }

            new Chart(element, {
                type: "doughnut",
                data: {
                    labels: labels,
                    datasets: [{
                        data: data,
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    cutout: "68%",
                    plugins: {
                        legend: {
                            position: "bottom"
                        }
                    }
                }
            });
        }

        function renderBarChart(elementId, labels, data, label) {
            const element = document.getElementById(elementId);

            if (!element) {
                return;
            }

            new Chart(element, {
                type: "bar",
                data: {
                    labels: labels,
                    datasets: [{
                        label: label,
                        data: data,
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0
                            }
                        }
                    }
                }
            });
        }
    </script>
}