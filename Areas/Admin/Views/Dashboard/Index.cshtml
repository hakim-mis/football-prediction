<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="dashboard-card p-4 h-100 chart-box">
            <h2 class="h4 fw-bold mb-3"><i class="bi bi-bar-chart text-primary"></i> Points by Segment</h2>
            @if (Model.SegmentPoints.Any())
            {
                <canvas id="segmentChart" height="110"></canvas>
            }
            else
            {
                <div class="empty-state">No processed point data yet.</div>
            }
        </div>
    </div>
    <div class="col-lg-4">
        <div class="dashboard-card p-4 h-100 chart-box">
            <h2 class="h4 fw-bold mb-3"><i class="bi bi-pie-chart text-primary"></i> Fixture Status</h2>
            <canvas id="statusChart" height="190"></canvas>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="dashboard-card p-4">
            <h2 class="h4 fw-bold mb-3"><i class="bi bi-trophy text-primary"></i> Leaderboard Overview</h2>
            @if (!Model.TopUsers.Any())
            {
                <div class="empty-state">No active users in leaderboard.</div>
            }
            else
            {
                @foreach (var user in Model.TopUsers)
                {
                    <div class="leaderboard-row">
                        <span class="rank-circle">@user.RankText</span>
                        <img src=".@(user.PhotoPath ?? "../img/default-avatar.svg")" class="avatar-sm" />
                        <div class="flex-grow-1"><div class="fw-semibold">@user.FullName</div><div class="small text-muted">Exact: @user.ExactPredictionCount</div></div>
                        <span class="score-pill">@user.TotalScore pts</span>
                    </div>
                }
            }
        </div>
    </div>
    <div class="col-lg-4">
@*         <div class="dashboard-card p-4 mb-4">
            <h2 class="h4 fw-bold mb-3">Quick Actions</h2>
            <div class="d-grid gap-2">
                <a asp-area="Admin" asp-controller="Users" asp-action="Index" asp-route-status="pending" class="btn btn-primary"><i class="bi bi-person-check"></i> Approve Users</a>
                <a asp-area="Admin" asp-controller="Fixtures" asp-action="Create" class="btn btn-outline-light"><i class="bi bi-plus-circle"></i> Add Fixture</a>
                <a asp-area="Admin" asp-controller="Fixtures" asp-action="Index" class="btn btn-outline-light"><i class="bi bi-gear"></i> Process Results</a>
            </div>
        </div> *@
        <div class="dashboard-card p-4">
            <h2 class="h4 fw-bold mb-3">System Summary</h2>
            <div class="d-flex justify-content-between border-bottom py-2"><span>Active Users</span><strong>@Model.ActiveUsers</strong></div>
            <div class="d-flex justify-content-between border-bottom py-2"><span>Upcoming Fixtures</span><strong>@Model.UpcomingFixtures</strong></div>
            <div class="d-flex justify-content-between border-bottom py-2"><span>Finished Fixtures</span><strong>@Model.FinishedFixtures</strong></div>
            <div class="d-flex justify-content-between py-2"><span>Total Predictions</span><strong>@Model.TotalPredictions</strong></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const segmentLabels = @Html.Raw(segmentLabels);
        const segmentPoints = @Html.Raw(segmentPoints);
        const statusCounts = @Html.Raw(statusCounts);
        if (document.getElementById('segmentChart') && segmentLabels.length > 0) {
            new Chart(document.getElementById('segmentChart'), {
                type: 'bar',
                data: { labels: segmentLabels, datasets: [{ label: 'Points', data: segmentPoints }] },
                options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
            });
        }
        if (document.getElementById('statusChart')) {
            new Chart(document.getElementById('statusChart'), {
                type: 'doughnut',
                data: { labels: ['Upcoming', 'Live', 'Finished'], datasets: [{ data: statusCounts }] },
                options: { responsive: true }
            });
        }
    </script>
}
