@model AdminDashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Admin Dashboard";
    var segmentLabels = JsonSerializer.Serialize(Model.SegmentPoints.Select(x => x.SegmentName));
    var segmentPoints = JsonSerializer.Serialize(Model.SegmentPoints.Select(x => x.Points));
    var statusCounts = JsonSerializer.Serialize(Model.FixtureStatusCounts);
}

<div class="row g-4 mb-4">
    <div class="col-xl-3 col-md-6"><div class="stat-card"><div class="stat-left"><span class="stat-icon blue"><i class="bi bi-people"></i></span><div><div class="stat-title">Total Users</div><div class="stat-value">@Model.TotalUsers</div></div></div><i class="bi bi-three-dots-vertical stat-menu"></i></div></div>
    <div class="col-xl-3 col-md-6"><div class="stat-card"><div class="stat-left"><span class="stat-icon orange"><i class="bi bi-person-plus"></i></span><div><div class="stat-title">Pending Users</div><div class="stat-value">@Model.PendingUsers</div></div></div><i class="bi bi-three-dots-vertical stat-menu"></i></div></div>
    <div class="col-xl-3 col-md-6"><div class="stat-card"><div class="stat-left"><span class="stat-icon pink"><i class="bi bi-calendar2-event"></i></span><div><div class="stat-title">Fixtures</div><div class="stat-value">@Model.TotalFixtures</div></div></div><i class="bi bi-three-dots-vertical stat-menu"></i></div></div>
    <div class="col-xl-3 col-md-6"><div class="stat-card"><div class="stat-left"><span class="stat-icon green"><i class="bi bi-cpu"></i></span><div><div class="stat-title">Processed</div><div class="stat-value">@Model.ProcessedResults</div></div></div><i class="bi bi-three-dots-vertical stat-menu"></i></div></div>
</div>

