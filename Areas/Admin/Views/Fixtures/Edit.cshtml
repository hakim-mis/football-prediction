@model FixtureFormViewModel
@{
    ViewData["Title"] = "Edit Fixture";
}
<div class="glass-card p-4 p-lg-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <h1 class="h2 fw-bold mb-0"><i class="bi bi-pencil-square text-warning"></i> Edit Fixture</h1>
        @if (!Model.IsProcessed && Model.TeamOneActualGoal.HasValue && Model.TeamTwoActualGoal.HasValue)
        {
            <form asp-area="Admin" asp-controller="ResultProcessing" asp-action="Process" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-warning" onclick="return confirm('Process result and update user scores?')"><i class="bi bi-play-circle"></i> Process Result</button>
            </form>
        }
    </div>
    @if (Model.IsProcessed)
    {
        <div class="alert alert-success"><i class="bi bi-check-circle"></i> This fixture has already been processed. Actual score is locked.</div>
    }
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <partial name="_FixtureForm" model="Model" />
        <div class="d-flex gap-2 mt-4">
            <button class="btn btn-warning btn-lg fw-bold" type="submit"><i class="bi bi-save"></i> Update Fixture</button>
            <a asp-action="Index" class="btn btn-outline-light btn-lg">Back</a>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
