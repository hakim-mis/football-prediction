@model List<Fixture>
@using FootballPredictionGame.Models
@using FootballPredictionGame.Helpers

@{
    ViewData["Title"] = "Fixtures";

    var totalCount = Model?.Count ?? 0;
    var upcomingCount = Model?.Count(x => x.Status == MatchStatus.Upcoming) ?? 0;
    var liveCount = Model?.Count(x => x.Status == MatchStatus.Live) ?? 0;
    var upcomingLiveCount = upcomingCount + liveCount;
    var finishedCount = Model?.Count(x => x.Status == MatchStatus.Finished) ?? 0;
    var publishedYesCount = Model?.Count(x => x.IsPublished) ?? 0;
    var publishedNoCount = Model?.Count(x => !x.IsPublished) ?? 0;
    var processedCount = Model?.Count(x => x.IsProcessed) ?? 0;
    var pendingCount = Model?.Count(x => !x.IsProcessed) ?? 0;

    string ImageUrl(string? path, string fallback)
    {
        return string.IsNullOrWhiteSpace(path)
            ? Url.Content(fallback)
            : Url.Content("~/" + path.TrimStart('/', '~'));
    }

    string StatusBadgeClass(MatchStatus status)
    {
        return status switch
        {
            MatchStatus.Upcoming => "fixture-status-admin status-admin-upcoming",
            MatchStatus.Live => "fixture-status-admin status-admin-live blink-live",
            MatchStatus.Finished => "fixture-status-admin status-admin-finished",
            _ => "fixture-status-admin status-admin-default"
        };
    }

    string ActualScore(Fixture fixture)
    {
        return fixture.TeamOneActualGoal.HasValue && fixture.TeamTwoActualGoal.HasValue
            ? $"{fixture.TeamOneActualGoal} - {fixture.TeamTwoActualGoal}"
            : "Not set";
    }

    int StatusSortValue(MatchStatus status)
    {
        return status switch
        {
            MatchStatus.Upcoming => 1,
            MatchStatus.Live => 2,
            MatchStatus.Finished => 3,
            _ => 99
        };
    }

    int ActualScoreSortValue(Fixture fixture)
    {
        if (!fixture.TeamOneActualGoal.HasValue || !fixture.TeamTwoActualGoal.HasValue)
        {
            return -1;
        }

        return (fixture.TeamOneActualGoal.Value * 100) + fixture.TeamTwoActualGoal.Value;
    }
}

<style>
    .admin-fixture-page {
        overflow: hidden;
    }

    .admin-fixture-topbar {
        width: 100%;
    }

    .admin-fixture-header-line {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        width: 100%;
        margin-bottom: 14px;
    }

    .admin-fixture-title-pill {
        margin: 0;
        white-space: nowrap;
    }

    .admin-fixture-header-actions {
        display: inline-flex;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
        flex: 0 0 auto;
    }

    .admin-fixture-back-btn {
        border-radius: 999px;
        font-weight: 700;
        white-space: nowrap;
    }

    .admin-fixture-add-btn {
        font-weight: 700;
        border-radius: 10px;
        white-space: nowrap;
    }

    .admin-fixture-toolbar {
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        gap: 8px;
        width: 100%;
    }

    .admin-fixture-search-box {
        position: relative;
        flex: 1 1 auto;
        min-width: 0;
    }

        .admin-fixture-search-box .admin-fixture-search-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            z-index: 2;
        }

        .admin-fixture-search-box .form-control {
            padding-left: 38px;
            padding-right: 42px;
            min-height: 42px;
            border-radius: 12px;
            width: 100%;
        }

    .admin-fixture-search-clear-inside {
        position: absolute;
        right: 9px;
        top: 50%;
        transform: translateY(-50%);
        width: 26px;
        height: 26px;
        border: 0;
        border-radius: 50%;
        background: #ffffff;
        color: #dc2626;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        z-index: 3;
        padding: 0;
        font-size: .9rem;
        line-height: 1;
    }

        .admin-fixture-search-clear-inside:hover,
        .admin-fixture-search-clear-inside:focus {
            background: #fee2e2;
            color: #b91c1c;
        }

    .admin-fixture-search-no-native-clear::-webkit-search-decoration,
    .admin-fixture-search-no-native-clear::-webkit-search-cancel-button,
    .admin-fixture-search-no-native-clear::-webkit-search-results-button,
    .admin-fixture-search-no-native-clear::-webkit-search-results-decoration {
        display: none;
        -webkit-appearance: none;
    }

    .admin-fixture-search-no-native-clear {
        appearance: none;
        -webkit-appearance: none;
    }

    .admin-fixture-table-wrap {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .admin-fixture-sort-btn,
    .admin-date-sort-btn {
        border: 0;
        background: transparent;
        padding: 0;
        font-weight: 800;
        color: #111827;
        display: inline-flex;
        align-items: center;
        gap: 3px;
        white-space: nowrap;
    }

        .admin-fixture-sort-btn:hover,
        .admin-fixture-sort-btn:focus,
        .admin-date-sort-btn:hover,
        .admin-date-sort-btn:focus {
            color: #0d6efd;
        }

    @@media (max-width: 767.98px) {
        .admin-fixture-page {
            padding: 14px !important;
            border-radius: 16px;
        }

        .admin-fixture-header-line {
            align-items: center;
            margin-bottom: 12px;
        }

        .admin-fixture-title-pill {
            font-size: .85rem;
            padding: 8px 12px;
        }

        .admin-fixture-header-actions {
            gap: 6px;
        }

        .admin-fixture-add-btn {
            padding: 6px 10px;
            font-size: .82rem;
            border-radius: 999px;
        }

        .admin-fixture-back-btn {
            padding: 6px 12px;
            font-size: .82rem;
        }

        .admin-fixture-toolbar {
            display: flex !important;
            flex-direction: row !important;
            align-items: center !important;
            gap: 6px !important;
            width: 100%;
        }

        .admin-fixture-search-box {
            flex: 1 1 auto;
            min-width: 0;
        }

            .admin-fixture-search-box .admin-fixture-search-icon {
                left: 10px;
            }

            .admin-fixture-search-box .form-control {
                min-height: 40px;
                font-size: .86rem;
                padding-left: 34px;
                padding-right: 38px;
            }

        .admin-fixture-search-clear-inside {
            right: 7px;
            width: 24px;
            height: 24px;
            font-size: .82rem;
        }
    }

    @@media (max-width: 390px) {
        .admin-fixture-title-pill {
            font-size: .78rem;
            padding-left: 10px;
            padding-right: 10px;
        }

        .admin-fixture-add-btn,
        .admin-fixture-back-btn {
            font-size: .76rem;
            padding-left: 9px;
            padding-right: 9px;
        }
    }
</style>

<div class="dashboard-card admin-fixture-page p-3 p-md-4 mb-4">

    <div class="admin-fixture-topbar mb-3">

        <div class="admin-fixture-header-line">
            <span class="pill admin-fixture-title-pill">
                <i class="bi bi-calendar-event"></i>
                Fixtures
            </span>

            <div class="admin-fixture-header-actions">
                <a asp-action="Create"
                   class="btn btn-primary btn-sm admin-fixture-add-btn">
                    <i class="bi bi-plus-circle"></i>
                    Add Fixture
                </a>

                <button type="button"
                        class="btn btn-outline-primary btn-sm admin-fixture-back-btn"
                        onclick="goBackOrAdminDashboard()">
                    <i class="bi bi-arrow-left"></i>
                    Back
                </button>
            </div>
        </div>

    </div>

    <!-- Search + Filters -->
    <div class="admin-fixture-toolbar mb-3">

        <div class="admin-fixture-search-box">
            <span class="admin-fixture-search-icon">
                <i class="bi bi-search"></i>
            </span>

            <input type="search"
                   id="adminFixtureSearch"
                   class="form-control admin-fixture-search-no-native-clear"
                   placeholder="Search" />

            <button type="button"
                    class="admin-fixture-search-clear-inside"
                    id="adminFixtureClearSearch"
                    title="Clear search"
                    aria-label="Clear search">
                <i class="bi bi-x-circle"></i>
            </button>
        </div>

    </div>

    <div class="admin-fixture-filter-bar mb-4">

        <button type="button"
                class="admin-fixture-filter-btn filter-upcoming active"
                data-filter="upcominglive">
            <i class="bi bi-calendar-event"></i>
            Upcoming + Live
            <span>@upcomingLiveCount</span>
        </button>

        <button type="button"
                class="admin-fixture-filter-btn filter-finished"
                data-filter="Finished">
            <i class="bi bi-check-circle"></i>
            Finished
            <span>@finishedCount</span>
        </button>

        <button type="button"
                class="admin-fixture-filter-btn filter-all"
                data-filter="all">
            <i class="bi bi-grid"></i>
            All
            <span>@totalCount</span>
        </button>

        <button type="button"
                class="admin-fixture-filter-btn filter-published-yes"
                data-filter="published-yes">
            <i class="bi bi-eye"></i>
            Publish: Yes
            <span>@publishedYesCount</span>
        </button>

        <button type="button"
                class="admin-fixture-filter-btn filter-published-no"
                data-filter="published-no">
            <i class="bi bi-eye-slash"></i>
            Publish: No
            <span>@publishedNoCount</span>
        </button>

        <button type="button"
                class="admin-fixture-filter-btn filter-processed"
                data-filter="processed">
            <i class="bi bi-check2-square"></i>
            Processed
            <span>@processedCount</span>
        </button>

        <button type="button"
                class="admin-fixture-filter-btn filter-pending"
                data-filter="pending">
            <i class="bi bi-hourglass-split"></i>
            Pending
            <span>@pendingCount</span>
        </button>

    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">
            No fixture created yet.
        </div>
    }
    else
    {
        <div class="admin-fixture-table-wrap">

            <table class="table table-clean table-hover align-middle mb-0 admin-fixture-table" id="adminFixtureTable">

                <thead>
                    <tr>
                        <th>
                            <button type="button"
                                    id="fixtureDateSortBtn"
                                    class="admin-date-sort-btn"
                                    data-sort-field="date"
                                    data-sort-direction="asc">
                                Date & Time
                                <i class="bi bi-arrow-up-short" id="fixtureDateSortIcon"></i>
                            </button>
                        </th>

                        <th>
                            <button type="button"
                                    class="admin-fixture-sort-btn"
                                    data-sort-field="match"
                                    data-sort-direction="asc">
                                Match
                                <i class="bi bi-arrow-down-up"></i>
                            </button>
                        </th>

                        <th>
                            <button type="button"
                                    class="admin-fixture-sort-btn"
                                    data-sort-field="status"
                                    data-sort-direction="asc">
                                Status
                                <i class="bi bi-arrow-down-up"></i>
                            </button>
                        </th>

                        <th>
                            <button type="button"
                                    class="admin-fixture-sort-btn"
                                    data-sort-field="actual"
                                    data-sort-direction="desc">
                                Actual Score
                                <i class="bi bi-arrow-down-up"></i>
                            </button>
                        </th>

                        <th>
                            <button type="button"
                                    class="admin-fixture-sort-btn"
                                    data-sort-field="published"
                                    data-sort-direction="desc">
                                Published
                                <i class="bi bi-arrow-down-up"></i>
                            </button>
                        </th>

                        <th>
                            <button type="button"
                                    class="admin-fixture-sort-btn"
                                    data-sort-field="processed"
                                    data-sort-direction="desc">
                                Processed
                                <i class="bi bi-arrow-down-up"></i>
                            </button>
                        </th>

                        <th class="text-end">Action</th>
                    </tr>
                </thead>

                <tbody id="adminFixtureTableBody">
                    @foreach (var fixture in Model.OrderBy(x => x.MatchDateTime).ThenBy(x => x.Stage))
                    {
                        var teamOneFlag = ImageUrl(fixture.TeamOneFlagPath, "~/img/default-flag.svg");
                        var teamTwoFlag = ImageUrl(fixture.TeamTwoFlagPath, "~/img/default-flag.svg");

                        var publishFilter = fixture.IsPublished ? "published-yes" : "published-no";
                        var processFilter = fixture.IsProcessed ? "processed" : "pending";

                        var publishText = fixture.IsPublished ? "Publish Yes" : "Publish No";
                        var processText = fixture.IsProcessed ? "Processed" : "Pending";
                        var actualScore = ActualScore(fixture);

                        var matchSortText = $"{fixture.TeamOneName} {fixture.TeamTwoName} {fixture.Stage.GetDisplayName()}".ToLowerInvariant();
                        var statusSort = StatusSortValue(fixture.Status);
                        var actualSort = ActualScoreSortValue(fixture);
                        var publishedSort = fixture.IsPublished ? 1 : 0;
                        var processedSort = fixture.IsProcessed ? 1 : 0;

                        var searchText = $"{fixture.TeamOneName} {fixture.TeamTwoName} {fixture.Stage.GetDisplayName()} {fixture.Status} {actualScore} {publishText} {processText} {fixture.MatchDateTime:dd MMM yyyy hh:mm tt}".ToLowerInvariant();

                        <tr class="admin-fixture-row"
                            data-status="@fixture.Status"
                            data-status-sort="@statusSort"
                            data-published="@publishFilter"
                            data-published-sort="@publishedSort"
                            data-processed="@processFilter"
                            data-processed-sort="@processedSort"
                            data-actual="@actualSort"
                            data-match="@matchSortText"
                            data-match-time="@fixture.MatchDateTime.ToString("yyyy-MM-ddTHH:mm:ss")"
                            data-search="@searchText">

                            <td>
                                <div class="fw-semibold">
                                    @fixture.MatchDateTime.ToString("dd MMM yyyy")
                                </div>

                                <div class="small text-muted">
                                    @fixture.MatchDateTime.ToString("hh:mm tt")
                                </div>
                            </td>

                            <td>
                                <div class="admin-fixture-match-cell">

                                    <div class="admin-fixture-team-inline">
                                        <img src="@teamOneFlag"
                                             alt="@fixture.TeamOneName" />

                                        <span>@fixture.TeamOneName</span>
                                    </div>

                                    <span class="admin-fixture-vs-inline">vs</span>

                                    <div class="admin-fixture-team-inline">
                                        <img src="@teamTwoFlag"
                                             alt="@fixture.TeamTwoName" />

                                        <span>@fixture.TeamTwoName</span>
                                    </div>

                                    <span class="admin-fixture-stage-inline">
                                        @fixture.Stage.GetDisplayName()
                                    </span>

                                </div>
                            </td>

                            <td>
                                <span class="@StatusBadgeClass(fixture.Status)">
                                    @fixture.Status
                                </span>
                            </td>

                            <td>
                                @if (fixture.TeamOneActualGoal.HasValue && fixture.TeamTwoActualGoal.HasValue)
                                {
                                    <span class="admin-score-pill">
                                        @actualScore
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small fw-bold">
                                        Not set
                                    </span>
                                }
                            </td>

                            <td>
                                @if (fixture.IsPublished)
                                {
                                    <span class="admin-publish-badge publish-yes">
                                        <i class="bi bi-check-circle"></i>
                                        Yes
                                    </span>
                                }
                                else
                                {
                                    <span class="admin-publish-badge publish-no">
                                        <i class="bi bi-x-circle"></i>
                                        No
                                    </span>
                                }
                            </td>

                            <td>
                                @if (fixture.IsProcessed)
                                {
                                    <span class="admin-process-badge process-done">
                                        <i class="bi bi-check2-circle"></i>
                                        Processed
                                    </span>
                                }
                                else
                                {
                                    <span class="admin-process-badge process-pending">
                                        <i class="bi bi-hourglass-split"></i>
                                        Pending
                                    </span>
                                }
                            </td>

                            <td class="text-end">
                                <div class="admin-fixture-action-row">

                                    <a asp-action="Edit"
                                       asp-route-id="@fixture.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i>
                                        Edit
                                    </a>

                                    @if (!fixture.IsProcessed &&
                                                                fixture.TeamOneActualGoal.HasValue &&
                                                                fixture.TeamTwoActualGoal.HasValue)
                                    {
                                        <form asp-area="Admin"
                                              asp-controller="ResultProcessing"
                                              asp-action="Process"
                                              asp-route-id="@fixture.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-primary"
                                                    onclick="return confirm('Process this result now?')">
                                                <i class="bi bi-play-circle"></i>
                                                Process
                                            </button>
                                        </form>
                                    }

                                    @if (fixture.IsProcessed)
                                    {
                                        <form asp-area="Admin"
                                              asp-controller="ResultProcessing"
                                              asp-action="Undo"
                                              asp-route-id="@fixture.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-warning"
                                                    onclick="return confirm('Undo this processed result? User points from this fixture will be reverted. Then you can edit the actual goals and process again.')">
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                                Undo
                                            </button>
                                        </form>
                                    }

@*                                     <form asp-action="Delete"
                                          asp-route-id="@fixture.Id"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Delete this fixture?')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form> *@

                                </div>
                            </td>

                        </tr>
                    }
                </tbody>

            </table>

        </div>

        <div id="adminFixtureNoResult" class="empty-state mt-3 d-none">
            No fixture matched your search/filter.
        </div>
    }

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            bindAdminFixtureFilters();
            bindAdminFixtureSearch();
            bindAdminFixtureSortButtons();
            sortAdminFixtureRows("date", "asc");
            applyAdminFixtureSearchAndFilter();
        });

        let activeAdminFixtureFilter = "upcominglive";

        function goBackOrAdminDashboard() {
            if (window.history.length > 1) {
                window.history.back();
                return;
            }

            window.location.href = '@Url.Action("Index", "Dashboard", new { area = "Admin" })';
        }

        function bindAdminFixtureFilters() {
            document.querySelectorAll(".admin-fixture-filter-btn").forEach(function (button) {
                button.addEventListener("click", function () {
                    activeAdminFixtureFilter = button.getAttribute("data-filter") || "upcominglive";

                    document.querySelectorAll(".admin-fixture-filter-btn").forEach(function (btn) {
                        btn.classList.remove("active");
                    });

                    button.classList.add("active");

                    if (activeAdminFixtureFilter === "Finished") {
                        sortAdminFixtureRows("date", "desc");
                        setAdminFixtureDateSortIcon("desc");
                    } else {
                        sortAdminFixtureRows("date", "asc");
                        setAdminFixtureDateSortIcon("asc");
                    }

                    applyAdminFixtureSearchAndFilter();
                });
            });
        }

        function bindAdminFixtureSearch() {
            const searchInput = document.getElementById("adminFixtureSearch");
            const clearButton = document.getElementById("adminFixtureClearSearch");

            if (searchInput) {
                searchInput.addEventListener("input", function () {
                    applyAdminFixtureSearchAndFilter();
                });
            }

            if (clearButton) {
                clearButton.addEventListener("click", function () {
                    if (searchInput) {
                        searchInput.value = "";
                        searchInput.focus();
                    }

                    applyAdminFixtureSearchAndFilter();
                });
            }
        }

        function bindAdminFixtureSortButtons() {
            document.querySelectorAll(".admin-fixture-sort-btn, .admin-date-sort-btn").forEach(function (button) {
                button.addEventListener("click", function () {
                    const field = button.getAttribute("data-sort-field");

                    if (!field) {
                        return;
                    }

                    const currentDirection = button.getAttribute("data-sort-direction") || "asc";
                    const nextDirection = currentDirection === "asc" ? "desc" : "asc";

                    button.setAttribute("data-sort-direction", nextDirection);

                    sortAdminFixtureRows(field, nextDirection);
                    applyAdminFixtureSearchAndFilter();
                    updateAdminFixtureSortIcons(button, nextDirection);
                });
            });
        }

        function sortAdminFixtureRows(field, direction) {
            const tbody = document.getElementById("adminFixtureTableBody");

            if (!tbody) {
                return;
            }

            const rows = Array.from(tbody.querySelectorAll(".admin-fixture-row"));

            rows.sort(function (a, b) {
                let aValue;
                let bValue;

                if (field === "date") {
                    aValue = new Date(a.getAttribute("data-match-time") || "").getTime();
                    bValue = new Date(b.getAttribute("data-match-time") || "").getTime();
                } else if (field === "match") {
                    aValue = a.getAttribute("data-match") || "";
                    bValue = b.getAttribute("data-match") || "";

                    if (direction === "asc") {
                        return aValue.localeCompare(bValue);
                    }

                    return bValue.localeCompare(aValue);
                } else if (field === "status") {
                    aValue = parseInt(a.getAttribute("data-status-sort") || "0");
                    bValue = parseInt(b.getAttribute("data-status-sort") || "0");
                } else if (field === "actual") {
                    aValue = parseInt(a.getAttribute("data-actual") || "-1");
                    bValue = parseInt(b.getAttribute("data-actual") || "-1");
                } else if (field === "published") {
                    aValue = parseInt(a.getAttribute("data-published-sort") || "0");
                    bValue = parseInt(b.getAttribute("data-published-sort") || "0");
                } else if (field === "processed") {
                    aValue = parseInt(a.getAttribute("data-processed-sort") || "0");
                    bValue = parseInt(b.getAttribute("data-processed-sort") || "0");
                } else {
                    aValue = 0;
                    bValue = 0;
                }

                if (direction === "asc") {
                    return aValue - bValue;
                }

                return bValue - aValue;
            });

            rows.forEach(function (row) {
                tbody.appendChild(row);
            });
        }

        function updateAdminFixtureSortIcons(activeButton, direction) {
            document.querySelectorAll(".admin-fixture-sort-btn i, .admin-date-sort-btn i").forEach(function (icon) {
                icon.className = "bi bi-arrow-down-up";
            });

            const activeIcon = activeButton.querySelector("i");

            if (activeIcon) {
                activeIcon.className = direction === "asc"
                    ? "bi bi-arrow-up-short"
                    : "bi bi-arrow-down-short";
            }
        }

        function setAdminFixtureDateSortIcon(direction) {
            const dateButton = document.getElementById("fixtureDateSortBtn");
            const dateIcon = document.getElementById("fixtureDateSortIcon");

            document.querySelectorAll(".admin-fixture-sort-btn i, .admin-date-sort-btn i").forEach(function (icon) {
                icon.className = "bi bi-arrow-down-up";
            });

            if (dateButton) {
                dateButton.setAttribute("data-sort-direction", direction);
            }

            if (dateIcon) {
                dateIcon.className = direction === "asc"
                    ? "bi bi-arrow-up-short"
                    : "bi bi-arrow-down-short";
            }
        }

        function applyAdminFixtureSearchAndFilter() {
            const searchInput = document.getElementById("adminFixtureSearch");
            const searchText = searchInput ? searchInput.value.trim().toLowerCase() : "";
            const noResult = document.getElementById("adminFixtureNoResult");

            let visibleCount = 0;

            document.querySelectorAll(".admin-fixture-row").forEach(function (row) {
                const status = row.getAttribute("data-status");
                const published = row.getAttribute("data-published");
                const processed = row.getAttribute("data-processed");
                const searchable = row.getAttribute("data-search") || "";

                let matchesFilter = false;

                if (activeAdminFixtureFilter === "upcominglive") {
                    matchesFilter = status === "Upcoming" || status === "Live";
                } else if (activeAdminFixtureFilter === "all") {
                    matchesFilter = true;
                } else if (activeAdminFixtureFilter === "Finished") {
                    matchesFilter = status === "Finished";
                } else if (activeAdminFixtureFilter === "published-yes" ||
                           activeAdminFixtureFilter === "published-no") {
                    matchesFilter = published === activeAdminFixtureFilter;
                } else if (activeAdminFixtureFilter === "processed" ||
                           activeAdminFixtureFilter === "pending") {
                    matchesFilter = processed === activeAdminFixtureFilter;
                }

                const matchesSearch = searchText === "" || searchable.includes(searchText);
                const shouldShow = matchesFilter && matchesSearch;

                if (shouldShow) {
                    row.classList.remove("d-none");
                    visibleCount++;
                } else {
                    row.classList.add("d-none");
                }
            });

            if (noResult) {
                if (visibleCount === 0) {
                    noResult.classList.remove("d-none");
                } else {
                    noResult.classList.add("d-none");
                }
            }
        }
    </script>
}