@model List<UserManagementItemViewModel>

@{
    ViewData["Title"] = "User Management";

    var status = (string?)ViewBag.Status ?? "all";

    string UserPhoto(string? path)
    {
        return string.IsNullOrWhiteSpace(path)
            ? Url.Content("~/img/default-avatar.svg")
            : Url.Content("~/" + path.TrimStart('/', '~'));
    }

    string UserSubInfo(string? designation, string? department)
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(designation))
        {
            parts.Add(designation);
        }

        if (!string.IsNullOrWhiteSpace(department))
        {
            parts.Add(department);
        }

        return parts.Any() ? string.Join(" • ", parts) : "-";
    }
}

<style>
    .admin-user-page {
        overflow: hidden;
    }

    .admin-user-topbar {
        width: 100%;
    }

    .admin-user-header-line {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        width: 100%;
        margin-bottom: 14px;
    }

    .admin-user-title-pill {
        margin: 0;
        white-space: nowrap;
    }

    .admin-user-back-btn {
        border-radius: 999px;
        font-weight: 700;
        white-space: nowrap;
    }

    .admin-user-status-tabs {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 16px;
    }

        .admin-user-status-tabs .btn {
            min-width: 82px;
            font-weight: 700;
            border-radius: 10px;
        }

    .admin-user-search-toolbar {
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        gap: 8px;
        width: 100%;
    }

    .admin-user-search-box {
        position: relative;
        flex: 1 1 auto;
        min-width: 0;
    }

        .admin-user-search-box .admin-user-search-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            z-index: 2;
        }

        .admin-user-search-box .form-control {
            padding-left: 38px;
            padding-right: 42px;
            min-height: 42px;
            border-radius: 12px;
            width: 100%;
        }

    .admin-user-search-clear-inside {
        position: absolute;
        right: 9px;
        top: 50%;
        transform: translateY(-50%);
        width: 26px;
        height: 26px;
        border: 0;
        border-radius: 50%;
        background: #ffffff;
        color: #dc2626;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        z-index: 3;
        padding: 0;
        font-size: .9rem;
        line-height: 1;
    }

        .admin-user-search-clear-inside:hover,
        .admin-user-search-clear-inside:focus {
            background: #fee2e2;
            color: #b91c1c;
        }

    .admin-user-search-no-native-clear::-webkit-search-decoration,
    .admin-user-search-no-native-clear::-webkit-search-cancel-button,
    .admin-user-search-no-native-clear::-webkit-search-results-button,
    .admin-user-search-no-native-clear::-webkit-search-results-decoration {
        display: none;
        -webkit-appearance: none;
    }

    .admin-user-search-no-native-clear {
        appearance: none;
        -webkit-appearance: none;
    }

    .admin-user-sort-btn,
    .admin-user-date-sort-btn {
        border: 0;
        background: transparent;
        padding: 0;
        font-weight: 800;
        color: #111827;
        display: inline-flex;
        align-items: center;
        gap: 3px;
        white-space: nowrap;
    }

        .admin-user-sort-btn:hover,
        .admin-user-sort-btn:focus,
        .admin-user-date-sort-btn:hover,
        .admin-user-date-sort-btn:focus {
            color: #0d6efd;
        }

    .admin-user-table-wrap {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    @@media (max-width: 767.98px) {
        .admin-user-page {
            padding: 14px !important;
            border-radius: 16px;
        }

        .admin-user-header-line {
            align-items: center;
            margin-bottom: 12px;
        }

        .admin-user-title-pill {
            font-size: .85rem;
            padding: 8px 12px;
        }

        .admin-user-back-btn {
            padding: 6px 12px;
            font-size: .82rem;
        }

        .admin-user-status-tabs {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 6px;
            margin-bottom: 14px;
        }

            .admin-user-status-tabs .btn {
                min-width: 0;
                width: 100%;
                font-size: .8rem;
                padding-left: 6px;
                padding-right: 6px;
            }

        .admin-user-search-toolbar {
            display: flex !important;
            flex-direction: row !important;
            align-items: center !important;
            gap: 6px !important;
            width: 100%;
        }

        .admin-user-search-box {
            flex: 1 1 auto;
            min-width: 0;
        }

            .admin-user-search-box .admin-user-search-icon {
                left: 10px;
            }

            .admin-user-search-box .form-control {
                min-height: 40px;
                font-size: .86rem;
                padding-left: 34px;
                padding-right: 38px;
            }

        .admin-user-search-clear-inside {
            right: 7px;
            width: 24px;
            height: 24px;
            font-size: .82rem;
        }
    }
</style>

<div class="dashboard-card admin-user-page p-3 p-md-4 mb-4">

    <div class="admin-user-topbar mb-3">

        <div class="admin-user-header-line">
            <span class="pill admin-user-title-pill">
                <i class="bi bi-people"></i>
                User Control
            </span>

            <button type="button"
                    class="btn btn-outline-primary btn-sm admin-user-back-btn"
                    onclick="goBackOrDashboard()">
                <i class="bi bi-arrow-left"></i>
                Back
            </button>
        </div>

        <div class="admin-user-status-tabs">
            <a asp-action="Index"
               asp-route-status="all"
               class="btn btn-sm @(status == "all" ? "btn-primary" : "btn-outline-primary")">
                All
            </a>

            <a asp-action="Index"
               asp-route-status="pending"
               class="btn btn-sm @(status == "pending" ? "btn-primary" : "btn-outline-primary")">
                Pending
            </a>

            <a asp-action="Index"
               asp-route-status="active"
               class="btn btn-sm @(status == "active" ? "btn-primary" : "btn-outline-primary")">
                Active
            </a>

            <a asp-action="Index"
               asp-route-status="email-not-verified"
               class="btn btn-sm @(status == "email-not-verified" ? "btn-danger" : "btn-outline-danger")">
                Email N/V
            </a>
        </div>

    </div>

    <div class="admin-user-search-toolbar mb-3">

        <div class="admin-user-search-box">
            <span class="admin-user-search-icon">
                <i class="bi bi-search"></i>
            </span>

            <input type="search"
                   id="adminUserSearch"
                   class="form-control admin-user-search-no-native-clear"
                   placeholder="Search" />

            <button type="button"
                    class="admin-user-search-clear-inside"
                    id="adminUserClearSearch"
                    title="Clear search"
                    aria-label="Clear search">
                <i class="bi bi-x-circle"></i>
            </button>
        </div>

    </div>

    <div class="admin-user-table-wrap">
        <table class="table table-clean table-hover align-middle mb-0 admin-user-table">
            <thead>
                <tr>
                    <th>Player</th>
                    <th>Contact</th>

                    <th>
                        <button type="button"
                                class="admin-user-sort-btn"
                                data-sort-field="status"
                                data-sort-direction="asc">
                            Status
                            <i class="bi bi-arrow-down-up"></i>
                        </button>
                    </th>

                    <th>
                        <button type="button"
                                class="admin-user-sort-btn"
                                data-sort-field="score"
                                data-sort-direction="desc">
                            Score
                            <i class="bi bi-arrow-down-up"></i>
                        </button>
                    </th>

                    <th>
                        <button type="button"
                                class="admin-user-sort-btn"
                                data-sort-field="predicted"
                                data-sort-direction="desc">
                            Predicted
                            <i class="bi bi-arrow-down-up"></i>
                        </button>
                    </th>

                    <th>
                        <button type="button"
                                class="admin-user-sort-btn"
                                data-sort-field="notpredict"
                                data-sort-direction="desc">
                            Not Predict
                            <i class="bi bi-arrow-down-up"></i>
                        </button>
                    </th>

                    <th>
                        <button type="button"
                                class="admin-user-sort-btn"
                                data-sort-field="notparticipate"
                                data-sort-direction="desc">
                            Not Participate
                            <i class="bi bi-arrow-down-up"></i>
                        </button>
                    </th>

                    <th>
                        <button type="button"
                                id="adminUserDateSortBtn"
                                class="admin-user-date-sort-btn"
                                data-sort-field="registered"
                                data-sort-direction="desc">
                            Registered
                            <i id="adminUserDateSortIcon" class="bi bi-arrow-down-short"></i>
                        </button>
                    </th>

                    <th class="text-end">Action</th>
                </tr>
            </thead>

            <tbody id="adminUserTableBody">
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">
                            No user found.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var user in Model)
                    {
                        var subInfo = UserSubInfo(user.Designation, user.Department);

                        var statusText = !user.EmailConfirmed
                        ? "Email Not Verified"
                        : user.IsActive
                        ? "Active"
                        : "Pending";

                        var statusSort = !user.EmailConfirmed
                        ? 0
                        : user.IsActive
                        ? 2
                        : 1;

                        var emailVerifiedText = user.EmailConfirmed ? "Email Verified" : "Email Not Verified";

                        var searchableText = $"{user.FullName} {subInfo} {user.Email} {user.MobileNo} {statusText} {emailVerifiedText} {user.TotalScore} {user.TotalPredictionCount} {user.NotPredictCount} {user.NotParticipateCount} {user.CreatedAt:dd MMM yyyy hh:mm tt}".ToLowerInvariant();

                        <tr class="admin-user-row"
                            data-search="@searchableText"
                            data-status="@statusSort"
                            data-score="@user.TotalScore"
                            data-predicted="@user.TotalPredictionCount"
                            data-notpredict="@user.NotPredictCount"
                            data-notparticipate="@user.NotParticipateCount"
                            data-registered="@user.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ss")">

                            <td>
                                <div class="admin-user-player-cell">
                                    <img src="@UserPhoto(user.PhotoPath)"
                                         class="admin-user-avatar"
                                         alt="@user.FullName" />

                                    <div class="admin-user-player-info">
                                        <strong>@user.FullName</strong>

                                        <div class="small text-muted admin-user-subtitle">
                                            @subInfo
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <div class="admin-user-email-line">
                                    <span>@user.Email</span>

                                    @if (user.EmailConfirmed)
                                    {
                                        <span class="email-verify-badge email-verified"
                                              title="Email verified">
                                            <i class="bi bi-check"></i>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="email-verify-badge email-not-verified"
                                              title="Email not verified">
                                            <i class="bi bi-x"></i>
                                        </span>
                                    }
                                </div>

                                <div class="small text-muted">
                                    @(string.IsNullOrWhiteSpace(user.MobileNo) ? "-" : user.MobileNo)
                                </div>
                            </td>

                            <td>
                                @if (!user.EmailConfirmed)
                                {
                                    <span class="admin-user-status-badge user-status-pending">
                                        <i class="bi bi-envelope-x"></i>
                                        Email Not Verified
                                    </span>
                                }
                                else if (user.IsActive)
                                {
                                    <span class="admin-user-status-badge user-status-active">
                                        <i class="bi bi-check-circle"></i>
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="admin-user-status-badge user-status-pending">
                                        <i class="bi bi-hourglass-split"></i>
                                        Pending
                                    </span>
                                }
                            </td>

                            <td>
                                <span class="score-pill">
                                    @user.TotalScore pts
                                </span>
                            </td>

                            <td>
                                <span class="admin-user-count-pill count-predicted">
                                    @user.TotalPredictionCount
                                </span>
                            </td>

                            <td>
                                <span class="admin-user-count-pill count-notpredict">
                                    @user.NotPredictCount
                                </span>
                            </td>

                            <td>
                                <span class="admin-user-count-pill count-notparticipate">
                                    @user.NotParticipateCount
                                </span>
                            </td>

                            <td>
                                <div class="fw-semibold">
                                    @user.CreatedAt.ToString("dd-MMM-yyyy")
                                </div>

                                <div class="small text-muted">
                                    @user.CreatedAt.ToString("hh:mm tt")
                                </div>
                            </td>

                            <td class="text-end">
                                <div class="admin-user-action-row">

                                    @if (user.IsActive)
                                    {
                                        <form asp-action="Deactivate"
                                              asp-route-id="@user.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-warning"
                                                    onclick="return confirm('Deactivate this user?')">
                                                <i class="bi bi-person-x"></i>
                                                Deactivate
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Activate"
                                              asp-route-id="@user.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-primary">
                                                <i class="bi bi-person-check"></i>
                                                Activate
                                            </button>
                                        </form>
                                    }

                                    <form asp-action="ResetPassword"
                                          asp-route-id="@user.Id"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Reset password to default? The user will be forced to change it after login.')">
                                            <i class="bi bi-key"></i>
                                            Reset Password
                                        </button>
                                    </form>

                                </div>
                            </td>

                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div id="adminUserNoResult" class="empty-state mt-3 d-none">
        No user matched your search.
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            bindAdminUserSearch();
            bindAdminUserSortButtons();
        });

        function goBackOrDashboard() {
            if (window.history.length > 1) {
                window.history.back();
                return;
            }

            window.location.href = '@Url.Action("Index", "Dashboard", new { area = "Admin" })';
        }

        function bindAdminUserSearch() {
            const searchInput = document.getElementById("adminUserSearch");
            const clearButton = document.getElementById("adminUserClearSearch");

            if (searchInput) {
                searchInput.addEventListener("input", function () {
                    applyAdminUserSearch();
                });
            }

            if (clearButton) {
                clearButton.addEventListener("click", function () {
                    if (searchInput) {
                        searchInput.value = "";
                        searchInput.focus();
                    }

                    applyAdminUserSearch();
                });
            }
        }

        function applyAdminUserSearch() {
            const searchInput = document.getElementById("adminUserSearch");
            const noResult = document.getElementById("adminUserNoResult");

            const searchText = searchInput
                ? searchInput.value.trim().toLowerCase()
                : "";

            let visibleCount = 0;

            document.querySelectorAll(".admin-user-row").forEach(function (row) {
                const searchable = row.getAttribute("data-search") || "";
                const shouldShow = searchText === "" || searchable.includes(searchText);

                if (shouldShow) {
                    row.classList.remove("d-none");
                    visibleCount++;
                } else {
                    row.classList.add("d-none");
                }
            });

            if (noResult) {
                if (visibleCount === 0 && document.querySelectorAll(".admin-user-row").length > 0) {
                    noResult.classList.remove("d-none");
                } else {
                    noResult.classList.add("d-none");
                }
            }
        }

        function bindAdminUserSortButtons() {
            document.querySelectorAll(".admin-user-sort-btn, .admin-user-date-sort-btn").forEach(function (button) {
                button.addEventListener("click", function () {
                    const field = button.getAttribute("data-sort-field");

                    if (!field) {
                        return;
                    }

                    const currentDirection = button.getAttribute("data-sort-direction") || "asc";
                    const nextDirection = currentDirection === "asc" ? "desc" : "asc";

                    button.setAttribute("data-sort-direction", nextDirection);

                    sortAdminUserRows(field, nextDirection);
                    applyAdminUserSearch();
                    updateAdminUserSortIcons(button, nextDirection);
                });
            });
        }

        function sortAdminUserRows(field, direction) {
            const tbody = document.getElementById("adminUserTableBody");

            if (!tbody) {
                return;
            }

            const rows = Array.from(tbody.querySelectorAll(".admin-user-row"));

            rows.sort(function (a, b) {
                let aValue = 0;
                let bValue = 0;

                if (field === "registered") {
                    aValue = new Date(a.getAttribute("data-registered") || "").getTime();
                    bValue = new Date(b.getAttribute("data-registered") || "").getTime();
                } else {
                    aValue = parseInt(a.getAttribute("data-" + field) || "0");
                    bValue = parseInt(b.getAttribute("data-" + field) || "0");
                }

                if (direction === "asc") {
                    return aValue - bValue;
                }

                return bValue - aValue;
            });

            rows.forEach(function (row) {
                tbody.appendChild(row);
            });
        }

        function updateAdminUserSortIcons(activeButton, direction) {
            document.querySelectorAll(".admin-user-sort-btn i, .admin-user-date-sort-btn i").forEach(function (icon) {
                icon.className = "bi bi-arrow-down-up";
            });

            const activeIcon = activeButton.querySelector("i");

            if (activeIcon) {
                activeIcon.className = direction === "asc"
                    ? "bi bi-arrow-up-short"
                    : "bi bi-arrow-down-short";
            }
        }
    </script>
}