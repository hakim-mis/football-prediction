@model FootballPredictionGame.ViewModels.AutomationSettingsViewModel
@using FootballPredictionGame.Models

@{
    ViewData["Title"] = "Automation Settings";

    string StatusText(bool value)
    {
        return value ? "Enabled" : "Disabled";
    }

    string StatusClass(bool value)
    {
        return value ? "text-bg-success" : "text-bg-secondary";
    }

    string UpdatedText()
    {
        return Model.UpdatedAt.HasValue
            ? Model.UpdatedAt.Value.ToString("dd MMM yyyy, hh:mm tt")
            : "Not updated yet";
    }
}

<style>
    .automation-settings-page {
        overflow: hidden;
    }

    .automation-settings-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

    .automation-settings-title-block {
        min-width: 0;
    }

        .automation-settings-title-block h1 {
            line-height: 1.2;
            margin-bottom: 6px;
        }

        .automation-settings-title-block p {
            max-width: 880px;
            line-height: 1.5;
        }

    .automation-settings-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

        .automation-settings-actions .btn {
            border-radius: 999px;
            font-weight: 700;
            white-space: nowrap;
        }

    .automation-summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 18px;
    }

    .automation-summary-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 14px;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 10px 24px rgba(15, 23, 42, .06);
    }

    .automation-summary-icon {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        background: #eef6ff;
        color: #0d6efd;
        font-size: 1.2rem;
    }

    .automation-summary-card span {
        display: block;
        color: #64748b;
        font-size: .78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .02em;
    }

    .automation-summary-card strong {
        display: block;
        color: #111827;
        font-size: .96rem;
        line-height: 1.25;
    }

    .automation-accordion .accordion-item {
        border: 1px solid #e2e8f0;
        border-radius: 18px !important;
        overflow: hidden;
        margin-bottom: 12px;
        background: #ffffff;
        box-shadow: 0 12px 28px rgba(15, 23, 42, .06);
    }

    .automation-accordion .accordion-button {
        background: #ffffff;
        color: #111827;
        font-weight: 800;
        box-shadow: none;
        padding: 16px 18px;
    }

        .automation-accordion .accordion-button:not(.collapsed) {
            background: #f8fbff;
            color: #0f172a;
            border-bottom: 1px solid #e2e8f0;
        }

        .automation-accordion .accordion-button:focus {
            box-shadow: none;
            border-color: transparent;
        }

    .automation-section-title {
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
        min-width: 0;
    }

    .automation-section-icon {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: #eef6ff;
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        font-size: 1.05rem;
    }

    .automation-section-text {
        min-width: 0;
    }

        .automation-section-text strong {
            display: block;
            line-height: 1.2;
        }

        .automation-section-text small {
            display: block;
            color: #64748b;
            font-weight: 500;
            line-height: 1.35;
            margin-top: 2px;
        }

    .automation-section-badge {
        margin-left: auto;
        margin-right: 12px;
        font-size: .72rem;
        border-radius: 999px;
        padding: 6px 9px;
    }

    .automation-section-body {
        padding: 18px;
        background: #ffffff;
    }

    .settings-subtitle {
        font-size: .8rem;
        font-weight: 800;
        color: #0f172a;
        text-transform: uppercase;
        letter-spacing: .03em;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .settings-block {
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        border-radius: 16px;
        padding: 16px;
        margin-bottom: 14px;
    }

        .settings-block .row.g-3 {
            align-items: flex-start;
        }

            .settings-block .row.g-3:has(.settings-field) > div:not(.settings-field) {
                padding-top: 27px;
            }

    .settings-field label,
    .settings-switch label {
        font-weight: 700;
        color: #334155;
        font-size: .88rem;
    }

    .settings-field label {
        margin-bottom: 8px;
    }

    .settings-field .form-control,
    .settings-field .form-select {
        border-radius: 12px;
        min-height: 42px;
    }

    .settings-help {
        display: block;
        color: #64748b;
        font-size: .78rem;
        line-height: 1.35;
        margin-top: 4px;
    }

    .settings-switch {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 11px 12px;
        min-height: 42px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

        .settings-switch .form-check {
            margin-bottom: 0;
            min-height: 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .settings-switch .form-check-input {
            width: 2.4em;
            height: 1.25em;
            margin-top: 0;
            cursor: pointer;
        }

            .settings-switch .form-check-input:checked {
                background-color: #198754;
                border-color: #198754;
            }

    .automation-footer-actions {
        position: sticky;
        bottom: 0;
        z-index: 10;
        background: rgba(255, 255, 255, .92);
        backdrop-filter: blur(10px);
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 14px;
        margin-top: 16px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        box-shadow: 0 -10px 28px rgba(15, 23, 42, .06);
    }

        .automation-footer-actions .btn {
            border-radius: 999px;
            font-weight: 800;
            min-width: 150px;
        }

    .ads-action-box {
        border: 1px dashed #93c5fd;
        background: #eff6ff;
        border-radius: 16px;
        padding: 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

        .ads-action-box strong {
            display: block;
            color: #1e3a8a;
            margin-bottom: 2px;
        }

        .ads-action-box span {
            color: #475569;
            font-size: .85rem;
        }

        .ads-action-box .btn {
            border-radius: 999px;
            font-weight: 800;
        }

    @@media (max-width: 991.98px) {
        .automation-summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 767.98px) {
        .automation-settings-page {
            padding: 14px !important;
            border-radius: 16px;
        }

        .automation-settings-header {
            align-items: center;
            gap: 10px;
        }

        .automation-settings-title-block h1 {
            font-size: 1.22rem;
        }

        .automation-settings-title-block p {
            font-size: .84rem;
        }

        .automation-settings-actions {
            width: 100%;
        }

            .automation-settings-actions .btn {
                flex: 1 1 auto;
                font-size: .82rem;
                padding: 7px 10px;
            }

        .automation-summary-grid {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .automation-summary-card {
            padding: 12px;
        }

        .automation-section-badge {
            display: none;
        }

        .automation-accordion .accordion-button {
            padding: 14px;
        }

        .automation-section-body {
            padding: 14px;
        }

        .settings-block {
            padding: 12px;
        }

            .settings-block .row.g-3:has(.settings-field) > div:not(.settings-field) {
                padding-top: 0;
            }

        .settings-switch {
            padding: 10px;
            min-height: 42px;
        }

        .automation-footer-actions {
            flex-direction: column;
            border-radius: 16px;
        }

            .automation-footer-actions .btn {
                width: 100%;
            }
    }
</style>

<div class="dashboard-card automation-settings-page p-3 p-md-4 mb-4">

    <div class="automation-settings-header">
        <div class="automation-settings-title-block">
            <span class="pill">
                <i class="bi bi-robot"></i>
                Automation Control Center
            </span>

            <h1 class="h3 fw-bold mt-3">
                Automation Settings
            </h1>

            <p class="text-muted mb-0">
                Manage fixture automation, reminders, weekly emails, AI approval, login tracking, Ads settings, schedules, and execution mode from one professional control panel.
            </p>
        </div>

        <div class="automation-settings-actions">
            <a asp-area="Admin"
               asp-controller="Dashboard"
               asp-action="Index"
               class="btn btn-outline-primary btn-sm">
                <i class="bi bi-arrow-left"></i>
                Back
            </a>

            <a asp-area="Admin"
               asp-controller="AutomationSuggestions"
               asp-action="Index"
               class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-lightbulb"></i>
                Suggestions
            </a>
        </div>
    </div>

    <div class="automation-summary-grid">

        <div class="automation-summary-card">
            <div class="automation-summary-icon">
                <i class="bi bi-power"></i>
            </div>
            <div>
                <span>Master</span>
                <strong>
                    <span class="badge @StatusClass(Model.MasterAutomationEnabled)">
                        @StatusText(Model.MasterAutomationEnabled)
                    </span>
                </strong>
            </div>
        </div>

        <div class="automation-summary-card">
            <div class="automation-summary-icon">
                <i class="bi bi-gear-wide-connected"></i>
            </div>
            <div>
                <span>Execution</span>
                <strong>@Model.ExecutionMode</strong>
            </div>
        </div>

        <div class="automation-summary-card">
            <div class="automation-summary-icon">
                <i class="bi bi-megaphone"></i>
            </div>
            <div>
                <span>Ads</span>
                <strong>
                    <span class="badge @StatusClass(Model.AdsEnabled)">
                        @StatusText(Model.AdsEnabled)
                    </span>
                </strong>
            </div>
        </div>

        <div class="automation-summary-card">
            <div class="automation-summary-icon">
                <i class="bi bi-clock-history"></i>
            </div>
            <div>
                <span>Last Updated</span>
                <strong>@UpdatedText()</strong>
            </div>
        </div>

    </div>

    <form asp-action="Index" method="post">
        @Html.AntiForgeryToken()

        <input asp-for="Id" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="accordion automation-accordion" id="automationSettingsAccordion">

            <!-- MASTER -->
            <div class="accordion-item">
                <h2 class="accordion-header" id="masterHeading">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#masterCollapse" aria-expanded="true" aria-controls="masterCollapse">
                        <div class="automation-section-title">
                            <span class="automation-section-icon">
                                <i class="bi bi-power"></i>
                            </span>
                            <span class="automation-section-text">
                                <strong>Master & Execution Mode</strong>
                                <small>Main switch and automation execution behavior.</small>
                            </span>
                            <span class="badge automation-section-badge @StatusClass(Model.MasterAutomationEnabled)">
                                @StatusText(Model.MasterAutomationEnabled)
                            </span>
                        </div>
                    </button>
                </h2>

                <div id="masterCollapse" class="accordion-collapse collapse show" aria-labelledby="masterHeading" data-bs-parent="#automationSettingsAccordion">
                    <div class="automation-section-body">

                        <div class="settings-block">
                            <div class="settings-subtitle">
                                <i class="bi bi-toggle-on"></i>
                                Main Control
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="settings-switch">
                                        <label asp-for="MasterAutomationEnabled"></label>
                                        <div class="form-check form-switch">
                                            <input asp-for="MasterAutomationEnabled" class="form-check-input" />
                                        </div>
                                    </div>
                                    <span asp-validation-for="MasterAutomationEnabled" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 settings-field">
                                    <label asp-for="ExecutionMode" class="form-label"></label>
                                    <select asp-for="ExecutionMode"
                                            asp-items="Html.GetEnumSelectList<AutomationExecutionMode>()"
                                            class="form-select">
                                    </select>
                                    <span class="settings-help">
                                        Suggest Only creates review items. Auto Execute runs allowed automation directly.
                                    </span>
                                    <span asp-validation-for="ExecutionMode" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- FIXTURE -->
            <div class="accordion-item">
                <h2 class="accordion-header" id="fixtureHeading">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#fixtureCollapse" aria-expanded="false" aria-controls="fixtureCollapse">
                        <div class="automation-section-title">
                            <span class="automation-section-icon">
                                <i class="bi bi-calendar-event"></i>
                            </span>
                            <span class="automation-section-text">
                                <strong>Fixture Automation</strong>
                                <small>Automatic status update, result processing, and default match duration.</small>
                            </span>
                            <span class="badge automation-section-badge @StatusClass(Model.FixtureAutomationEnabled)">
                                @StatusText(Model.FixtureAutomationEnabled)
                            </span>
                        </div>
                    </button>
                </h2>

                <div id="fixtureCollapse" class="accordion-collapse collapse" aria-labelledby="fixtureHeading" data-bs-parent="#automationSettingsAccordion">
                    <div class="automation-section-body">

                        <div class="settings-block">
                            <div class="settings-subtitle">
                                <i class="bi bi-calendar-check"></i>
                                Fixture Status Flow
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6 col-xl-3">
                                    <div class="settings-switch">
                                        <label asp-for="FixtureAutomationEnabled"></label>
                                        <div class="form-check form-switch">
                                            <input asp-for="FixtureAutomationEnabled" class="form-check-input" />
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 col-xl-3">
                                    <div class="settings-switch">
                                        <label asp-for="AutoUpcomingToLiveEnabled"></label>
                                        <div class="form-check form-switch">
                                            <input asp-for="AutoUpcomingToLiveEnabled" class="form-check-input" />
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 col-xl-3">
                                    <div class="settings-switch">
                                        <label asp-for="AutoLiveToFinishedEnabled"></label>
                                        <div class="form-check form-switch">
                                            <input asp-for="AutoLiveToFinishedEnabled" class="form-check-input" />
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 col-xl-3">
                                    <div class="settings-switch">
                                        <label asp-for="AutoResultProcessingEnabled"></label>
                                        <div class="form-check form-switch">
                                            <input asp-for="AutoResultProcessingEnabled" class="form-check-input" />
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 settings-field">
                                    <label asp-for="DefaultMatchDurationMinutes" class="form-label"></label>
                                    <input asp-for="DefaultMatchDurationMinutes" class="form-control" type="number" min="30" max="300" />
                                    <span class="settings-help">Used to decide auto-finished time when actual end time is not available.</span>
                                    <span asp-validation-for="DefaultMatchDurationMinutes" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- REMINDER -->
            <div class="accordion-item">
                <h2 class="accordion-header" id="reminderHeading">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#reminderCollapse" aria-expanded="false" aria-controls="reminderCollapse">
                        <div class="automation-section-title">
                            <span class="automation-section-icon">
                                <i class="bi bi-envelope-bell"></i>
                            </span>
                            <span class="automation-section-text">
                                <strong>Prediction Reminder Emails</strong>
                                <small>Send reminder emails before upcoming matches.</small>
                            </span>
                            <span class="badge automation-section-badge @StatusClass(Model.ReminderAutomationEnabled)">
                                @StatusText(Model.ReminderAutomationEnabled)
                            </span>
                        </div>
                    </button>
                </h2>

                <div id="reminderCollapse" class="accordion-collapse collapse" aria-labelledby="reminderHeading" data-bs-parent="#automationSettingsAccordion">
                    <div class="automation-section-body">

                        <div class="settings-block">
                            <div class="settings-subtitle">
                                <i class="bi bi-send"></i>
                                Reminder Control
                            </div>

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <div class="settings-switch">
                                        <label asp-for="ReminderAutomationEnabled"></label>
                                        <div class="form-check form-switch">
                                            <input asp-for="ReminderAutomationEnabled" class="form-check-input" />
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="settings-switch">
                                        <label asp-for="Reminder24HourEnabled"></label>
                                        <div class="form-check form-switch">
                                            <input asp-for="Reminder24HourEnabled" class="form-check-input" />
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="settings-switch">
                                        <label asp-for="Reminder1HourEnabled"></label>
                                        <div class="form-check form-switch">
                                            <input asp-for="Reminder1HourEnabled" class="form-check-input" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- WEEKLY -->
            <div class="accordion-item">
                <h2 class="accordion-header" id="weeklyHeading">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#weeklyCollapse" aria-expanded="false" aria-controls="weeklyCollapse">
                        <div class="automation-section-title">
                            <span class="automation-section-icon">
                                <i class="bi bi-graph-up-arrow"></i>
                            </span>
                            <span class="automation-section-text">
                                <strong>Weekly Performance Email</strong>
                                <small>Send appreciation or improvement emails based on weekly performance.</small>
                            </span>
                            <span class="badge automation-section-badge @StatusClass(Model.WeeklyEmailAutomationEnabled)">
                                @StatusText(Model.WeeklyEmailAutomationEnabled)
                            </span>
                        </div>
                    </button>
                </h2>

                <div id="weeklyCollapse" class="accordion-collapse collapse" aria-labelledby="weeklyHeading" data-bs-parent="#automationSettingsAccordion">
                    <div class="automation-section-body">

                        <div class="settings-block">
                            <div class="settings-subtitle">
                                <i class="bi bi-award"></i>
                                Email Type
                            </div>

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <div class="settings-switch">
                                        <label asp-for="WeeklyEmailAutomationEnabled"></label>
                                        <div class="form-check form-switch">
                                            <input asp-for="WeeklyEmailAutomationEnabled" class="form-check-input" />
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="settings-switch">
                                        <label asp-for="WeeklyAppreciationEmailEnabled"></label>
                                        <div class="form-check form-switch">
                                            <input asp-for="WeeklyAppreciationEmailEnabled" class="form-check-input" />
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="settings-switch">
                                        <label asp-for="WeeklyImprovementEmailEnabled"></label>
                                        <div class="form-check form-switch">
                                            <input asp-for="WeeklyImprovementEmailEnabled" class="form-check-input" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="settings-block">
                            <div class="settings-subtitle">
                                <i class="bi bi-sliders"></i>
                                Performance Thresholds
                            </div>

                            <div class="row g-3">
                                <div class="col-md-4 settings-field">
                                    <label asp-for="WeeklyGoodPerformancePointThreshold" class="form-label"></label>
                                    <input asp-for="WeeklyGoodPerformancePointThreshold" class="form-control" type="number" min="0" max="100" />
                                    <span asp-validation-for="WeeklyGoodPerformancePointThreshold" class="text-danger small"></span>
                                </div>

                                <div class="col-md-4 settings-field">
                                    <label asp-for="WeeklyPoorPerformancePointThreshold" class="form-label"></label>
                                    <input asp-for="WeeklyPoorPerformancePointThreshold" class="form-control" type="number" min="0" max="100" />
                                    <span asp-validation-for="WeeklyPoorPerformancePointThreshold" class="text-danger small"></span>
                                </div>

                                <div class="col-md-4 settings-field">
                                    <label asp-for="WeeklyMissedPredictionThreshold" class="form-label"></label>
                                    <input asp-for="WeeklyMissedPredictionThreshold" class="form-control" type="number" min="0" max="100" />
                                    <span asp-validation-for="WeeklyMissedPredictionThreshold" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="settings-block">
                            <div class="settings-subtitle">
                                <i class="bi bi-calendar-week"></i>
                                Weekly Schedule
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6 settings-field">
                                    <label asp-for="WeeklyEmailSendDay" class="form-label"></label>
                                    <select asp-for="WeeklyEmailSendDay"
                                            asp-items="Html.GetEnumSelectList<DayOfWeek>()"
                                            class="form-select">
                                    </select>
                                    <span asp-validation-for="WeeklyEmailSendDay" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 settings-field">
                                    <label asp-for="WeeklyEmailSendTime" class="form-label"></label>
                                    <input asp-for="WeeklyEmailSendTime" class="form-control" type="time" />
                                    <span asp-validation-for="WeeklyEmailSendTime" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- AI AND USER ACTIVATION -->
            <div class="accordion-item">
                <h2 class="accordion-header" id="aiHeading">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#aiCollapse" aria-expanded="false" aria-controls="aiCollapse">
                        <div class="automation-section-title">
                            <span class="automation-section-icon">
