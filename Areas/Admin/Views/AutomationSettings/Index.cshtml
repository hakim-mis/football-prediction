    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            rememberAutomationAccordionState();
        });

        function rememberAutomationAccordionState() {
            const storageKey = "automationSettingsActiveAccordion";
            const accordionItems = document.querySelectorAll("#automationSettingsAccordion .accordion-collapse");

            accordionItems.forEach(function (item) {
                item.addEventListener("shown.bs.collapse", function () {
                    sessionStorage.setItem(storageKey, item.id);
                });
            });

            const activeId = sessionStorage.getItem(storageKey);

            if (!activeId) {
                return;
            }

            const activeElement = document.getElementById(activeId);

            if (!activeElement || typeof bootstrap === "undefined") {
                return;
            }

            accordionItems.forEach(function (item) {
                const instance = bootstrap.Collapse.getOrCreateInstance(item, {
                    toggle: false
                });

                if (item.id === activeId) {
                    instance.show();
                } else {
                    instance.hide();
                }
            });
        }
    </script>
}