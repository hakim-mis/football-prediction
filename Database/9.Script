IF OBJECT_ID('dbo.DashboardBanners', 'U') IS NOT NULL
BEGIN
    DROP TABLE dbo.DashboardBanners;
END
GO

CREATE TABLE dbo.DashboardBanners
(
    Id INT IDENTITY(1,1) NOT NULL,

    Title NVARCHAR(150) NOT NULL,
    Subtitle NVARCHAR(300) NULL,

    ImageUrl NVARCHAR(300) NOT NULL,

    ButtonText NVARCHAR(50) NULL,
    RedirectUrl NVARCHAR(500) NULL,

    IsActive BIT NOT NULL CONSTRAINT DF_DashboardBanners_IsActive DEFAULT (1),

    Priority INT NOT NULL CONSTRAINT DF_DashboardBanners_Priority DEFAULT (1),
    DisplayOrder INT NOT NULL CONSTRAINT DF_DashboardBanners_DisplayOrder DEFAULT (1),

    CreatedAtUtc DATETIME2(7) NOT NULL CONSTRAINT DF_DashboardBanners_CreatedAtUtc DEFAULT (SYSUTCDATETIME()),
    UpdatedAtUtc DATETIME2(7) NULL,

    CreatedBy NVARCHAR(256) NULL,
    UpdatedBy NVARCHAR(256) NULL,

    CONSTRAINT PK_DashboardBanners PRIMARY KEY CLUSTERED (Id)
);
GO

CREATE INDEX IX_DashboardBanners_IsActive_Priority_DisplayOrder
ON dbo.DashboardBanners (IsActive, Priority DESC, DisplayOrder ASC, CreatedAtUtc DESC);
GO

