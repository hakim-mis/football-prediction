IF OBJECT_ID('dbo.PredictionReminderLogs', 'U') IS NULL
BEGIN
    CREATE TABLE dbo.PredictionReminderLogs
    (
        Id BIGINT IDENTITY(1,1) NOT NULL,
        UserId NVARCHAR(450) NOT NULL,
        FixtureId INT NOT NULL,

        ReminderType NVARCHAR(50) NOT NULL,
        -- 24Hour / 1Hour

        EmailTo NVARCHAR(256) NULL,

        IsSent BIT NOT NULL CONSTRAINT DF_PredictionReminderLogs_IsSent DEFAULT (0),
        SentAt DATETIME2 NULL,

        ErrorMessage NVARCHAR(MAX) NULL,

        CreatedAt DATETIME2 NOT NULL CONSTRAINT DF_PredictionReminderLogs_CreatedAt DEFAULT (GETDATE()),

        CONSTRAINT PK_PredictionReminderLogs PRIMARY KEY (Id),

        CONSTRAINT FK_PredictionReminderLogs_AspNetUsers_UserId
            FOREIGN KEY (UserId)
            REFERENCES dbo.AspNetUsers(Id)
            ON DELETE CASCADE,

        CONSTRAINT FK_PredictionReminderLogs_Fixtures_FixtureId
            FOREIGN KEY (FixtureId)
            REFERENCES dbo.Fixtures(Id)
            ON DELETE CASCADE
    );
END
GO

