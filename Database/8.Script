/* ============================================================
   PART 2: ADD CHECK CONSTRAINTS FOR ADS SETTINGS
   ============================================================ */

IF NOT EXISTS (
    SELECT 1
    FROM sys.check_constraints
    WHERE name = 'CK_AutomationSettings_AdsShowAfterSeconds'
)
BEGIN
    ALTER TABLE AutomationSettings
    ADD CONSTRAINT CK_AutomationSettings_AdsShowAfterSeconds
    CHECK (AdsShowAfterSeconds >= 0 AND AdsShowAfterSeconds <= 300);
END
GO

IF NOT EXISTS (
    SELECT 1
    FROM sys.check_constraints
    WHERE name = 'CK_AutomationSettings_AdsMandatoryWatchSeconds'
)
BEGIN
    ALTER TABLE AutomationSettings
    ADD CONSTRAINT CK_AutomationSettings_AdsMandatoryWatchSeconds
    CHECK (AdsMandatoryWatchSeconds >= 0 AND AdsMandatoryWatchSeconds <= 120);
END
GO

IF NOT EXISTS (
    SELECT 1
    FROM sys.check_constraints
    WHERE name = 'CK_AutomationSettings_AdsAutoCloseSeconds'
)
BEGIN
    ALTER TABLE AutomationSettings
    ADD CONSTRAINT CK_AutomationSettings_AdsAutoCloseSeconds
    CHECK (AdsAutoCloseSeconds >= 5 AND AdsAutoCloseSeconds <= 300);
END
GO

IF NOT EXISTS (
    SELECT 1
    FROM sys.check_constraints
    WHERE name = 'CK_AutomationSettings_AdsDefaultSlideDurationSeconds'
)
BEGIN
    ALTER TABLE AutomationSettings
    ADD CONSTRAINT CK_AutomationSettings_AdsDefaultSlideDurationSeconds
    CHECK (AdsDefaultSlideDurationSeconds >= 1 AND AdsDefaultSlideDurationSeconds <= 60);
END
GO

IF NOT EXISTS (
    SELECT 1
    FROM sys.check_constraints
    WHERE name = 'CK_AutomationSettings_AdsMaxImpressionsPerDayPerUser'
)
BEGIN
    ALTER TABLE AutomationSettings
    ADD CONSTRAINT CK_AutomationSettings_AdsMaxImpressionsPerDayPerUser
    CHECK (AdsMaxImpressionsPerDayPerUser >= 1 AND AdsMaxImpressionsPerDayPerUser <= 100);
END
GO


/* ============================================================
   PART 3: CREATE Ads TABLE
   ============================================================ */

IF OBJECT_ID('Ads', 'U') IS NULL
BEGIN
    CREATE TABLE Ads
    (
        Id INT IDENTITY(1,1) NOT NULL PRIMARY KEY,

        Title NVARCHAR(150) NOT NULL,
        Description NVARCHAR(500) NULL,

        IsActive BIT NOT NULL
            CONSTRAINT DF_Ads_IsActive DEFAULT 1,

        IsDeleted BIT NOT NULL
            CONSTRAINT DF_Ads_IsDeleted DEFAULT 0,

        DisplayOrder INT NOT NULL
            CONSTRAINT DF_Ads_DisplayOrder DEFAULT 0,

        Priority INT NOT NULL
            CONSTRAINT DF_Ads_Priority DEFAULT 0,

        SelectionMode NVARCHAR(30) NOT NULL
            CONSTRAINT DF_Ads_SelectionMode DEFAULT 'Ordered',
            -- Ordered, Random, Priority

        StartAt DATETIME2 NULL,
        EndAt DATETIME2 NULL,

        ShowOnDesktop BIT NOT NULL
            CONSTRAINT DF_Ads_ShowOnDesktop DEFAULT 1,

        ShowOnTablet BIT NOT NULL
            CONSTRAINT DF_Ads_ShowOnTablet DEFAULT 1,

        ShowOnMobile BIT NOT NULL
            CONSTRAINT DF_Ads_ShowOnMobile DEFAULT 1,

        ShowToGuests BIT NOT NULL
            CONSTRAINT DF_Ads_ShowToGuests DEFAULT 1,

        ShowToUsers BIT NOT NULL
            CONSTRAINT DF_Ads_ShowToUsers DEFAULT 1,

        ShowToAdmins BIT NOT NULL
            CONSTRAINT DF_Ads_ShowToAdmins DEFAULT 0,

        ShowOnDashboard BIT NOT NULL
            CONSTRAINT DF_Ads_ShowOnDashboard DEFAULT 1,

        ShowOnPredictionScore BIT NOT NULL
            CONSTRAINT DF_Ads_ShowOnPredictionScore DEFAULT 1,

        ShowOnLeaderboard BIT NOT NULL
            CONSTRAINT DF_Ads_ShowOnLeaderboard DEFAULT 1,

        ShowOnRules BIT NOT NULL
            CONSTRAINT DF_Ads_ShowOnRules DEFAULT 0,

        ShowOnLoginRegister BIT NOT NULL
            CONSTRAINT DF_Ads_ShowOnLoginRegister DEFAULT 0,

        ShowAfterPredictionSubmit BIT NOT NULL
            CONSTRAINT DF_Ads_ShowAfterPredictionSubmit DEFAULT 0,

        ShowOnlyIfUserHasNoUpcomingPrediction BIT NOT NULL
            CONSTRAINT DF_Ads_ShowOnlyIfUserHasNoUpcomingPrediction DEFAULT 0,

        ButtonText NVARCHAR(80) NULL,
        ButtonUrl NVARCHAR(800) NULL,

        CreatedAt DATETIME2 NOT NULL
            CONSTRAINT DF_Ads_CreatedAt DEFAULT GETDATE(),

        UpdatedAt DATETIME2 NULL,

        CreatedByUserId NVARCHAR(450) NULL,
        UpdatedByUserId NVARCHAR(450) NULL
    );
END
GO


/* ============================================================
   PART 4: CREATE AdSlides TABLE
   ============================================================ */

IF OBJECT_ID('AdSlides', 'U') IS NULL
BEGIN
    CREATE TABLE AdSlides
    (
        Id INT IDENTITY(1,1) NOT NULL PRIMARY KEY,

        AdId INT NOT NULL,

        Title NVARCHAR(150) NOT NULL,
        Description NVARCHAR(500) NULL,

        ImagePath NVARCHAR(500) NOT NULL,
        AudioPath NVARCHAR(500) NULL,

        ButtonText NVARCHAR(80) NULL,
        ButtonUrl NVARCHAR(800) NULL,

        DurationSeconds INT NOT NULL
            CONSTRAINT DF_AdSlides_DurationSeconds DEFAULT 4,

        DisplayOrder INT NOT NULL
            CONSTRAINT DF_AdSlides_DisplayOrder DEFAULT 0,

        IsActive BIT NOT NULL
            CONSTRAINT DF_AdSlides_IsActive DEFAULT 1,

        IsDeleted BIT NOT NULL
            CONSTRAINT DF_AdSlides_IsDeleted DEFAULT 0,

        CreatedAt DATETIME2 NOT NULL
            CONSTRAINT DF_AdSlides_CreatedAt DEFAULT GETDATE(),

        UpdatedAt DATETIME2 NULL,

        CONSTRAINT FK_AdSlides_Ads_AdId
            FOREIGN KEY (AdId) REFERENCES Ads(Id)
            ON DELETE CASCADE,

        CONSTRAINT CK_AdSlides_DurationSeconds
            CHECK (DurationSeconds >= 1 AND DurationSeconds <= 60)
    );
END
GO


/* ============================================================
   PART 5: CREATE AdLogs TABLE
   ============================================================ */

IF OBJECT_ID('AdLogs', 'U') IS NULL
BEGIN
    CREATE TABLE AdLogs
    (
        Id INT IDENTITY(1,1) NOT NULL PRIMARY KEY,

        AdId INT NULL,
        AdSlideId INT NULL,

        UserId NVARCHAR(450) NULL,
        SessionId NVARCHAR(120) NULL,

        EventType NVARCHAR(50) NOT NULL,
        -- Impression, Skip, Complete, Click, SoundEnabled, Close

        DeviceType NVARCHAR(50) NULL,
        -- Desktop, Tablet, Mobile

        PageName NVARCHAR(100) NULL,
        PageUrl NVARCHAR(800) NULL,

        IpAddress NVARCHAR(80) NULL,
        UserAgent NVARCHAR(1000) NULL,

        ExtraDataJson NVARCHAR(MAX) NULL,

        CreatedAt DATETIME2 NOT NULL
            CONSTRAINT DF_AdLogs_CreatedAt DEFAULT GETDATE(),

        CONSTRAINT FK_AdLogs_Ads_AdId
            FOREIGN KEY (AdId) REFERENCES Ads(Id)
            ON DELETE SET NULL,

        CONSTRAINT FK_AdLogs_AdSlides_AdSlideId
            FOREIGN KEY (AdSlideId) REFERENCES AdSlides(Id)
            ON DELETE NO ACTION
    );
END
GO


/* ============================================================
   PART 6: ADD CHECK CONSTRAINTS FOR Ads TABLE
   ============================================================ */

IF NOT EXISTS (
    SELECT 1
    FROM sys.check_constraints
    WHERE name = 'CK_Ads_SelectionMode'
)
BEGIN
    ALTER TABLE Ads
    ADD CONSTRAINT CK_Ads_SelectionMode
    CHECK (SelectionMode IN ('Ordered', 'Random', 'Priority'));
END
GO

IF NOT EXISTS (
    SELECT 1
    FROM sys.check_constraints
    WHERE name = 'CK_Ads_Priority'
)
BEGIN
    ALTER TABLE Ads
    ADD CONSTRAINT CK_Ads_Priority
    CHECK (Priority >= 0 AND Priority <= 100);
END
GO


/* ============================================================
   PART 7: CREATE INDEXES
   ============================================================ */

IF NOT EXISTS (
    SELECT 1
    FROM sys.indexes
    WHERE name = 'IX_Ads_IsActive_IsDeleted_DisplayOrder'
      AND object_id = OBJECT_ID('Ads')
)
BEGIN
    CREATE INDEX IX_Ads_IsActive_IsDeleted_DisplayOrder
    ON Ads (IsActive, IsDeleted, DisplayOrder);
END
GO

IF NOT EXISTS (
    SELECT 1
    FROM sys.indexes
    WHERE name = 'IX_Ads_StartAt_EndAt'
