END
GO

IF NOT EXISTS (
    SELECT 1
    FROM sys.indexes
    WHERE name = 'IX_AdLogs_SessionId_CreatedAt'
      AND object_id = OBJECT_ID('AdLogs')
)
BEGIN
    CREATE INDEX IX_AdLogs_SessionId_CreatedAt
    ON AdLogs (SessionId, CreatedAt);
END
GO

IF NOT EXISTS (
    SELECT 1
    FROM sys.indexes
    WHERE name = 'IX_AdLogs_DeviceType_CreatedAt'
      AND object_id = OBJECT_ID('AdLogs')
)
BEGIN
    CREATE INDEX IX_AdLogs_DeviceType_CreatedAt
    ON AdLogs (DeviceType, CreatedAt);
END
GO


/* ============================================================
   PART 8: OPTIONAL DEFAULT UPDATE FOR EXISTING SETTINGS ROW
   This does not enable Ads automatically.
   It only makes sure default values are consistent.
   ============================================================ */

UPDATE AutomationSettings
SET
    AdsEnabled = ISNULL(AdsEnabled, 0),
    AdsShowOnDesktop = ISNULL(AdsShowOnDesktop, 1),
    AdsShowOnTablet = ISNULL(AdsShowOnTablet, 1),
    AdsShowOnMobile = ISNULL(AdsShowOnMobile, 1),
    AdsShowToGuests = ISNULL(AdsShowToGuests, 1),
    AdsShowToUsers = ISNULL(AdsShowToUsers, 1),
    AdsShowToAdmins = ISNULL(AdsShowToAdmins, 0),
    AdsShowAfterSeconds = CASE
        WHEN AdsShowAfterSeconds < 0 THEN 25
        WHEN AdsShowAfterSeconds > 300 THEN 25
        ELSE AdsShowAfterSeconds
    END,
    AdsMandatoryWatchSeconds = CASE
        WHEN AdsMandatoryWatchSeconds < 0 THEN 5
        WHEN AdsMandatoryWatchSeconds > 120 THEN 5
        ELSE AdsMandatoryWatchSeconds
    END,
    AdsAutoCloseSeconds = CASE
        WHEN AdsAutoCloseSeconds < 5 THEN 20
        WHEN AdsAutoCloseSeconds > 300 THEN 20
        ELSE AdsAutoCloseSeconds
    END,
    AdsDefaultSlideDurationSeconds = CASE
        WHEN AdsDefaultSlideDurationSeconds < 1 THEN 4
        WHEN AdsDefaultSlideDurationSeconds > 60 THEN 4
        ELSE AdsDefaultSlideDurationSeconds
    END
WHERE Id IN
(
    SELECT Id
    FROM AutomationSettings
);
GO


/* ============================================================
   DONE
   ============================================================ */